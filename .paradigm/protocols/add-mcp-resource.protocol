id: P-add-mcp-resource
name: "Add an MCP resource"
description: "Add an on-demand content resource served via paradigm:// URI scheme"

trigger:
  - "mcp resource"
  - "add resource"
  - "paradigm uri"
  - "on-demand content"
tags: [mcp, resource, content]

symbols: []

exemplar: "packages/paradigm-mcp/src/resources/prompts.ts"

steps:
  - action: create
    target: "packages/paradigm-mcp/src/resources/{name}.ts"
    template_from: "packages/paradigm-mcp/src/resources/prompts.ts"
    notes: "Export a function that returns content for the paradigm://{name} URI. Return markdown or structured text."

  - action: modify
    target: "packages/paradigm-mcp/src/resources/index.ts"
    reference: "resource registration"
    notes: "Import and register the new resource handler. Add to the resource URI list."

  - action: verify
    notes: "Test via MCP client: read paradigm://{name} resource"

