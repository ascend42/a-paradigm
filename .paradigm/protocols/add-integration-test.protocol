id: P-add-integration-test
name: Add an integration test
description: Create a multi-package integration test that tests CLI behavior end-to-end
trigger:
  - integration test
  - e2e test
  - end to end test
tags:
  - test
  - integration
  - e2e
symbols: []
exemplar: packages/paradigm/src/commands/doctor.test.ts
steps:
  - action: create
    target: packages/paradigm/src/{path}.test.ts
    template_from: packages/paradigm/src/commands/doctor.test.ts
    notes: Use createTempProject() fixture for isolated test directories. Spawn CLI subprocesses with execSync/spawn. Assert on stdout, file outputs, and exit codes.
  - action: verify
    notes: 'Run: cd packages/paradigm && npx vitest run {path}.test.ts'
