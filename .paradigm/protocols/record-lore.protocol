id: P-record-lore
name: "Record a lore entry"
description: "Record a structured lore entry after completing significant work"

trigger:
  - "record lore"
  - "log session"
  - "save history"
  - "lore entry"
tags: [lore, session, history]

symbols: ["#lore-tools"]

exemplar: "plugins/paradigm/skills/lore/SKILL.md"

steps:
  - action: run
    command: "git diff --stat HEAD"
    notes: "Gather file change stats for the session"

  - action: run
    command: "git log --oneline -10"
    notes: "Check recent commits for context"

  - action: verify
    notes: "Call paradigm_lore_record with type, title, summary, symbols_touched, tags"

