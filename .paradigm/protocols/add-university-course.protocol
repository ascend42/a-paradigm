id: P-add-university-course
name: Add a University course
description: Create a new course for Paradigm University with lessons, quizzes, and metadata
trigger:
  - add course
  - new course
  - university course
  - learning content
tags:
  - university
  - course
  - learning
symbols: []
exemplar: packages/university/src/content/courses/
steps:
  - action: create
    target: packages/university/src/content/courses/{id}.json
    notes: |
      JSON structure with:
        id, title, description, difficulty (beginner|intermediate|advanced),
        prerequisites (course IDs), objectives (string[]),
        lessons (array of { id, title, content (markdown), quiz? })
  - action: verify
    notes: Run university server, navigate to the course, verify lessons render and quizzes work
