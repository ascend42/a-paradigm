    "$absorb-flow": {
      "id": "$absorb-flow",
      "description": "One ref -> a WarpState of MEANING (stage 3a). Materialize a read-only ref tree (git archive | tar, no worktree), live-parse it, lift+inject TS/TSX code-units as synthetic nodes in the SAME universe, then compute whole-state essences and stamp every object. The lens only reads the tree — the Phase-1 read-only invariant holds.",
      "steps": [
        {
          "id": "step-1",
          "action": "git archive | tar -x materialize the ref into a temp dir (no worktree, lock-free, read-only)",
          "symbol": "#git-exec"
        },
        {
          "id": "step-2",
          "action": "liftCodeUnits(worktree) then injectCodeUnits(index, units) — synthetic code-unit nodes spliced in BEFORE essence computation",
          "symbol": "#lift-code-units"
        },
        {
          "id": "step-3",
          "action": "computeEssences over the merged .purpose+code universe (code-units take the <algo>:ts<exact> tag, e.g. v1.1:ts5.9.3; .purpose stays v0)",
          "symbol": "#essence-hash"
        },
        {
          "id": "step-4",
          "action": "buildWarpState stamps each object's contentId and derives the stateId; remove the worktree in a finally",
          "symbol": "#warp-state"
        }
      ],
      "definedIn": "packages/warpline/.purpose"
    },
    "$pick-flow": {
      "id": "$pick-flow",
      "description": "The single-writer WRITE PATH (Phase 2) — seal the working MEANING into this project's OWN durable history. Absorb the working tree, diff against the parent selvage (the source of truth for change), no-op on an empty diff, else seal a #strand, persist the snapshot, append to the #fabric ledger, and advance the selvage atomically. Writes .warpline/ only — git is read for provenance (HEAD sha, user.name) and never mutated.",
      "steps": [
        {
          "id": "step-1",
          "action": "Lift the working tree (or a ref) to a WarpState of MEANING",
          "symbol": "#absorb"
        },
        {
          "id": "step-2",
          "action": "readSelvage — the parent tip (null at genesis)",
          "symbol": "#fabric"
        },
        {
          "id": "step-3",
          "action": "diff(parent, current) — empty ⇒ no-op; else summarize born/retired/contract-changed/renamed",
          "symbol": "#sem-delta"
        },
        {
          "id": "step-4",
          "action": "putState — durably persist the snapshot under .warpline/states/",
          "symbol": "#warp-store"
        },
        {
          "id": "step-5",
          "action": "Seal the #strand (attribution + reserved confidence + git-HEAD anchor); appendStrand; writeSelvage (atomic publish)",
          "symbol": "#pick"
        }
      ],
      "definedIn": "packages/warpline/.purpose"
    },
