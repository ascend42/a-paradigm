{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": ".cursor/hooks/paradigm-stop.sh",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/paradigm-postwrite.sh",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/paradigm-precommit.sh",
        "matcher": "git commit",
        "timeout": 30
      }
    ]
  }
}
