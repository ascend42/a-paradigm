{
  "name": "paradigm",
  "version": "1.4.0",
  "description": "Unified developer tools ecosystem - Purpose, Portal, and Premise",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/portal/*",
    "packages/purpose/*",
    "packages/premise/*",
    "packages/probe/*",
    "packages/sentinel/*"
  ],
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "npm run build:core && npm run build:packages && npm run build:cli",
    "build:core": "npm run build --workspace=@a-company/university-core && npm run build --workspace=@a-company/purpose-core && npm run build --workspace=@a-company/portal-core && npm run build --workspace=@a-company/probe-core",
    "build:packages": "npm run build --workspace=@a-company/portal-sdk && npm run build --workspace=@a-company/portal-manager && npm run build --workspace=@a-company/portal-viewer && npm run build --workspace=@a-company/premise-core && npm run build --workspace=@a-company/sentinel && npm run build --workspace=@a-company/paradigm-runtime && npm run build --workspace=@a-company/paradigm-mcp",
    "build:cli": "npm run build --workspace=@a-company/paradigm",
    "build:vscode": "npm run build --workspace=@a-company/paradigm-vscode",
    "package:vscode": "cd packages/paradigm-vscode && npx vsce package",
    "dev:sentinel": "npm run dev:ui --workspace=@a-company/sentinel",
    "lint": "eslint packages --ext .ts,.tsx",
    "clean": "rm -rf packages/*/dist packages/*/*/dist packages/paradigm/visualizer-dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "publish:all": "npm publish --workspace=@a-company/paradigm --workspace=@a-company/paradigm-runtime --workspace=@a-company/university --workspace=@a-company/sentinel --workspace=@a-company/sentinel-web --workspace=@a-company/purpose-core --workspace=@a-company/portal-core --workspace=@a-company/portal-sdk --workspace=@a-company/portal-manager --workspace=@a-company/portal-viewer --workspace=@a-company/premise-core --workspace=@a-company/probe-core",
    "test": "npm run test --workspace=@a-company/paradigm",
    "prepublishOnly": "node scripts/pre-publish-check.mjs"
  },
  "keywords": [
    "developer-tools",
    "visualization",
    "architecture",
    "ai-context",
    "authorization",
    "documentation"
  ],
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-paradigm/issues"
  },
  "homepage": "https://github.com/ascend42/a-paradigm#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.2.0"
  },
  "dependencies": {
    "minimatch": "^10.2.2"
  }
}
