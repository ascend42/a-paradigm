{
  "mcpServers": {
    "paradigm": {
      "command": "npx",
      "args": [
        "@a-company/paradigm-mcp"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(paradigm *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/paradigm-stop.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/paradigm-precommit.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit,Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/paradigm-postwrite.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
