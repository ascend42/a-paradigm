version: 2.0.0
description: |
  @a-company/purpose-core - Core library for parsing and validating .purpose files.
  Handles YAML parsing, Zod schema validation, and symbol extraction from purpose files.
features:
  purpose-parsing:
    description: '@purpose-parsing: Parse .purpose files into structured data'
    aspects:
      - "~yaml-config-loading"
      - "~zod-validated"
    flows:
      - $purpose-parsing
    signals:
      - '!parse-success'
      - '!parse-error'
    components:
      - '#yaml-parser'
      - '#zod-schemas'
  purpose-validation:
    description: '@purpose-validation: Validate .purpose file content'
    signals:
      - '!validation-passed'
      - '!validation-failed'
    components:
      - '#validator'
      - '#schema-rules'
  purpose-aggregation:
    description: '@purpose-aggregation: Aggregate multiple .purpose files'
    components:
      - '#aggregator'
      - '#symbol-extractor'
    aspects:
      - "~file-glob-discovery"
components:
  purpose-parser:
    description: '#purpose-parser: Main orchestrator for parsing .purpose files — YAML pre-processing for symbol-prefixed keys (# is YAML comment, ! is YAML tag), normalization, and Zod validation'
    tags: [core, parser]
    anchors:
      - src/parser.ts:1-350
    signals:
      - '!parse-success'
      - '!parse-error'
    flows:
      - $purpose-parsing
  yaml-parser:
    description: '#yaml-parser: Parses YAML content from .purpose files'
  zod-schemas:
    description: '#zod-schemas: Zod schemas (zod 4) for PurposeFile, PurposeItem, etc. Every z.record declares its string key schema.'
  validator:
    description: '#validator: Validates parsed purpose data — includes cross-file validation (validateCrossFile) for parent refs, symbol list refs, and flow step refs across all .purpose files'
  schema-rules:
    description: '#schema-rules: Rules for validating symbol references'
  aggregator:
    description: '#aggregator: Combines multiple .purpose files. Exports DEFAULT_PURPOSE_IGNORE (7.13.0) — the discovery ignore list findPurposeFiles uses.'
  purpose-parse-cache:
    description: >-
      #purpose-parse-cache: src/parse-cache.ts (7.13.0) — PurposeParseCache,
      a per-file memo keyed by absolute path → {mtimeMs, size, sha1, data,
      errors}. stat fast path (mtime+size equal and mtime older than
      RECENT_MTIME_WINDOW_MS=2s → cached parse, no read; recent files are always
      hashed so same-size edits in one mtime tick are caught); on a
      stamp change the file is read + sha1-hashed and the parse reused when the
      bytes are identical, else re-parsed with parseRawPurposeFileContent (the
      exact post-read pipeline of parsePurposeFileDetailed). prune/invalidate
      drop entries. parsePurposeFilesCached / getAllPurposeFilesCached keep the
      input (findPurposeFiles) order — the cache never reorders. Returned data is
      shared and read-only. Consumer: #live-index in premise-core.
    file: packages/purpose/core/src/parse-cache.ts
    tags:
      - parser
      - cache
      - performance
  symbol-extractor:
    description: '#symbol-extractor: Extracts symbols from purpose data'
signals:
  parse-success:
    description: '!parse-success: .purpose file parsed successfully'
    category: purpose
    severity: info
  parse-error:
    description: '!parse-error: Failed to parse .purpose file'
    category: purpose
    severity: error
  validation-passed:
    description: '!validation-passed: Validation checks passed'
    category: purpose
    severity: info
  validation-failed:
    description: '!validation-failed: Validation found issues'
    category: purpose
    severity: warn
aspects:
  ~purpose-schema-passthrough:
    description: PurposeItemSchema uses Zod passthrough() to allow extra fields (tags, location, uses, used-by, etc.) without validation errors
    category: decision
    severity: medium
    tags: [schema, extensibility]
    anchors:
      - src/parser.ts:16-39
    applies-to:
      - "#zod-schemas"

  ~purpose-file-depth-sort:
    description: ".purpose files are sorted by directory depth (shallowest first) for correct parent-to-child aggregation, with ties broken by REPO-RELATIVE path (stable string compare). Depth alone is not a total order — same-depth files fell back to glob/filesystem order, which varies across machines and temp-worktree checkouts and flipped duplicate-symbol last-write-wins resolution, cascading into the Loom Oracle's phantom semantic deltas. Repo-relative tiebreak (root prefix stripped) makes resolution + downstream Merkle essences deterministic. See scan-index nondeterminism (T-2026-06-13-011)."
    category: rule
    severity: high
    tags: [aggregation, ordering, determinism]
    anchors:
      - src/aggregator.ts:178-212
    applies-to:
      - "#aggregator"

  ~purpose-glob-ignore-patterns:
    description: "findPurposeFiles ignores DEFAULT_PURPOSE_IGNORE: node_modules, dist, .git (historical) plus, since 7.13.0, .claude/**, **/.worktrees/**, .warpline/**, build, .build, coverage, .next, .turbo, Pods, DerivedData — so build artefacts / scratch checkouts carrying stale .purpose copies never win duplicate last-write-wins resolution"
    category: configuration
    severity: low
    tags: [discovery, glob]
    anchors:
      - src/aggregator.ts:147-176
    applies-to:
      - "#aggregator"

flows:
  purpose-parsing:
    description: Parse a .purpose file from raw YAML into validated structured data
    signals:
      - '!parse-success'
      - '!parse-error'
    steps:
      - component: '#yaml-parser'
        action: Read YAML file and parse with js-yaml
      - component: '#zod-schemas'
        action: Validate parsed data against PurposeFileSchema
      - component: '#symbol-extractor'
        action: Extract components, gates, signals, flows, aspects from validated data
      - component: '#validator'
        action: Return structured PurposeFile or validation errors
