version: 2.0.0
purpose: MCP resource handlers serving on-demand content via paradigm:// URIs
description: >
  Each module serves a category of read-only content as MCP resources.
  Resources are listed via ListResourcesRequest and read via ReadResourceRequest.

components:
  ResourceIndex:
    description: Main resource dispatcher — registers all resource handlers with the MCP server
    type: router
    tags: [mcp, resources]
  ToolAnnotationsResources:
    description: 'paradigm://tool-annotations (tool-annotations.ts, application/json) — { schema: "io.gnomon/op-annotations:v1", tools: { <family tool>: { <op>: { readOnlyHint?, destructiveHint?, idempotentHint?, openWorldHint? } } } } for EVERY family tool (TD-2026-10-27-833: a constant built once from the compiled definitions by registerTools; neither .paradigm/config.yaml, the listing nor paradigm_tool_activate changes it, so nothing a model writes into the project can reclass an op; a client reads only the entries of the tools it was listed). Each op carries only the hints its per-op tool declares; undeclared ops are absent (consumers read them as mutate). Kept out of tools/list so it costs model-facing listings nothing. Consumer: Gnomon kernel per-op narrowing (TD-2026-10-27-833).'
    type: service
    tags: [mcp, resources, tool-surface, gnomon]
  GuidanceResources:
    description: "On-demand behavioral guidance — 12 topics previously baked into CLAUDE.md, now served via paradigm://guidance/{topic}"
    type: service
    tags: [mcp, resources, guidance, claude-md, context-engineering]
  DocsResources:
    description: Reference documentation served from package templates (commands, queries)
    type: service
    tags: [mcp, resources, docs]
  PromptsResources:
    description: Task prompt templates served from package templates
    type: service
    tags: [mcp, resources, prompts]
  SpecsResources:
    description: Reference specs served from package templates (disciplines, scan, context-tracking)
    type: service
    tags: [mcp, resources, specs]
  WisdomResources:
    description: 'Team wisdom — preferences, antipatterns, expertise. paradigm://wisdom/decisions and paradigm://wisdom/decision/{id} are ALIASES of the canonical TD store (.paradigm/decisions/) since 7.12.0 (D2) — the legacy wisdom/decisions dir is no longer read.'
    type: service
    tags: [mcp, resources, wisdom]
  HistoryResources:
    description: Symbol history — per-symbol changes, fragility, co-changes
    type: service
    tags: [mcp, resources, history]
  ContextResources:
    description: Session context — agent protocol, session stats, handoff guide
    type: service
    tags: [mcp, resources, context]
