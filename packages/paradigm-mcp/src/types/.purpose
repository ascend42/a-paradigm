version: 2.0.0
purpose: MCP-side type definitions for Paradigm features
description: >
  TypeScript type definitions used by MCP tools and loaders.
  Each file defines types for a major feature: university, personas, etc.

components:
  UniversityTypes:
    description: Type definitions for per-project university content
    type: types
    tags: [university, schema]
  AgentTypes:
    description: "Type definitions for persistent agent identity profiles — AgentProfile (with nickname for attributed responses), AgentPermissions, AgentExpertiseEntry, TransferablePattern, AgentProjectContext, plus v5.0 Renaissance extensions: AgentAttention, AgentLearning, AgentContext, AgentReporting, AgentCollaboration, AgentNomination. v6.0.3+ adds PartnerRef interface ({id, relation?, share_notebooks?: 'off'|'read'|'read-write'}) and partners?: PartnerRef[] field on AgentProfile (excluded from integrityHash)."
    type: types
    tags: [agent-identity, schema, permissions, attention, learning, collaboration, maestro, partners]
  NotebookTypes:
    description: "Type definitions for agent notebook entries — NotebookEntry, NotebookProvenance"
    type: types
    tags: [notebooks, schema]
  AmbientTypes:
    description: "Type definitions for ambient coordination — StreamEvent, AttentionScore, Nomination, Debate, SurfacingConfig. v6.0.3+ Nomination gains optional partner_id?: string annotation (written-but-unused at v6.0.3, consumed by Loid in v6.1+ for cross-pair analytics)."
    type: types
    tags: [ambient, coordination, event-stream, schema, partners]
  KnowledgeStreamTypes:
    description: "Type definitions for three knowledge streams — WorkLogEntry, JournalEntry, TeamDecision, KnowledgeStream"
    type: types
    tags: [knowledge-streams, work-log, journal, decisions, schema]
  DataPolicyTypes:
    description: "Type definitions for data sovereignty — TrustRing, DataPolicy, ObservationRules, EnforcementResult, AuditEntry"
    type: types
    tags: [data-policy, trust-rings, sovereignty, schema]
  CaptainTypes:
    description: "Type definitions for Cid (Captain agent) — ContextBrief, DebriefReport, CidSessionMarker, CidBriefedMarker. ContextBrief is the structured pre-task map (territory, symbols, blastRadius, gates, protocol, warnings, coverage, loreRefs, renderedBrief). DebriefReport captures post-task coverage changes and lore recording."
    type: types
    tags: [captain, cid, orchestration, coverage, schema]
  UniversityMetricsTypes:
    description: "Type definitions for v6.0 University metrics snapshots — UniversityMetricsSnapshot. Local-only counters (pack counts, per-tenant-kind breakdown, project pack entry counts, disciplines, activity windows). No content bodies, no titles, hashed project salt only. Feeds the v6.3 sunset review."
    type: types
    tags: [university, metrics, telemetry, v6.0, schema]
  PackTypes:
    description: "Pack manifest constants and convenience re-exports — PACK_MANIFEST_FILENAME ('pack.yaml'), PACK_SCHEMA_VERSION ('1'), PACKAGE_JSON_POINTER_FIELD ('paradigm.universityPack'), FIRST_PARTY_PACK_IDS. Re-exports TenantKind, Origin, PackDependency, PackCompliance, PackManifest, PackLocation from university.ts."
    type: types
    tags: [university, pack, manifest, v6.0, schema]
