version: 2.0.0
description: |
  Utility modules for the MCP server — loaders, caches, and data access.
components:
  symphony-loader:
    description: 'The Score: file-based agent messaging — agent identity, JSONL parts, threads, file pipeline, trust config. ensureMailDirs renamed to ensureScoreDirs (deprecated alias retained). Ring 1 content filtering seam: isRing1Content, recordRing1Interception (audit trail), readOutboxRaw (unfiltered, relay-internal), readOutbox (filtered). SymphonyMessage.contentType field added.'
    type: loader
    anchors:
      - symphony-loader.ts:1-1205
    tags:
      - feature
      - symphony
  university-loader:
    description: 'Per-project university loader — CRUD for notes/policies/quizzes/paths/diplomas, index rebuild, validation, symbol linking for ripple. v6.0 sub-phase 1: accepts optional packRoot on all CRUD fns, walks discipline sub-packs via discoverDisciplineSubPacks, preserves v5 behavior via loadOrFabricatePackManifest (implicit pack when pack.yaml absent), stamps pack_id on writes.'
    type: loader
    tags:
      - feature
      - university
      - v6.0
  platform-bridge:
    description: HTTP bridge for MCP → Platform server communication. Resolves port from config.yaml, resolves agent identity, sends POST to /api/platform/agent-command.
    type: loader
    tags:
      - feature
      - platform
      - agent-ui
  symphony-peers:
    description: Peer trust records for Symphony cross-machine networking — peers.json CRUD, pairing code generation/verification, HMAC authentication.
    type: loader
    anchors:
      - symphony-peers.ts:1-229
    tags:
      - feature
      - symphony
      - networking
  symphony-relay:
    description: WebSocket relay engine for cross-machine Symphony networking — hub/spoke modes, outbox watcher, message routing, dedup, keepalive, auto-reconnect. Unsafe inline Ring 1 filter sites removed; delegates to symphony-loader for content filtering.
    type: integration
    anchors:
      - symphony-relay.ts:1-1000
    tags:
      - feature
      - symphony
      - networking
  agent-loader:
    description: CRUD for .agent identity files — load/save profiles, expertise queries, auto-update from lore, merge with agents.yaml, sync from lore history, permission checking (path/tool), integrity hash computation/verification, integrity status at load time, prompt sanitization, permission constraint extraction, permission enforcement facade
    type: loader
    tags:
      - feature
      - agent-identity
      - permissions
      - security
  notebook-loader:
    description: CRUD for agent notebook entries — load/save, search, promote from lore, increment applied count
    type: loader
    tags:
      - feature
      - notebooks
      - agent-identity
    components:
      - '#soft-provenance'
  tool-registry:
    description: Tiered tool registration system — core/feature/advanced tiers with auto-detection
    type: loader
    tags:
      - feature
      - tool-loading
      - mcp
  compliance-checker:
    description: Shared compliance checking logic — purpose coverage, portal gates, aspect anchors, code quality
    type: service
    tags:
      - feature
      - review
      - compliance
  DocsLoader:
    description: Reads scan-index, .purpose files, portal.yaml, and flows.yaml to produce structured documentation page data
    type: loader
    tags:
      - feature
      - docs
  graduation-types:
    description: Type definitions for the automation tier graduation system — GraduationState, GraduationConfig, GraduationTier, NON_GRADUATABLE_CHECK_TYPES
    type: types
    tags:
      - feature
      - graduation
      - automation
  graduation-store:
    description: YAML read/write for .paradigm/graduation.yaml — state accessors, mutations, 30s cache
    type: store
    tags:
      - feature
      - graduation
      - persistence
  graduation-engine:
    description: Core graduation logic — eligibility checking against practice events, graduate/demote actions, failure tracking
    type: engine
    tags:
      - feature
      - graduation
      - automation
  aspect-fingerprint:
    description: Phase 3 content fingerprint search — Levenshtein distance, sliding window, structural hashing, cross-file search for relocated anchors
    type: engine
    tags:
      - feature
      - drift-detection
      - fingerprint
  event-stream:
    description: Ambient event stream — emit, store (JSONL), query, and attention-score events for ambient coordination. Append-only with automatic pruning.
    type: engine
    anchors:
      - event-stream.ts:1-199
    tags:
      - feature
      - ambient
      - event-stream
  data-policy-loader:
    description: Data policy loader — reads .paradigm/data-policy.yaml, merges with defaults, enforces trust rings, observation rules, content redaction, and per-agent overrides.
    type: loader
    anchors:
      - data-policy-loader.ts:1-195
    tags:
      - feature
      - data-policy
      - sovereignty
  work-log-loader:
    description: Work Log CRUD — record/search/summarize what agents did. Date-partitioned YAML in .paradigm/work-log/{date}/
    type: loader
    tags:
      - feature
      - knowledge-streams
      - work-log
  journal-loader:
    description: Learning Journal CRUD — record/search/stats for agent learnings. Agent-private YAML in ~/.paradigm/agents/{id}/journal/
    type: loader
    tags:
      - feature
      - knowledge-streams
      - journal
  decision-loader:
    description: 'Team Decisions CRUD — record/search/supersede institutional decisions. YAML in .paradigm/decisions/. v6.0 sub-phase 1: updateDecision accepts absorbed ADR fields (context/consequences/date/migrated_from/supersedes); supersedeDecision backfills supersedes[] on the new entry (D2 Loid addendum); exposes writeCompanionLoreEntry helper for D3 companion-lore writes (not yet wired — sub-phase 2 wires the tool handler).'
    type: loader
    tags:
      - feature
      - knowledge-streams
      - decisions
      - v6.0
  nomination-engine:
    description: 'Nomination engine — processes events into agent nominations and debates. Core loop: event → attention scoring → nomination → debate detection → surfacing. Includes learning feedback (threshold adjustment), journal-to-notebook auto-promotion (pattern_discovered + human_feedback triggers), Neverland validation metrics, stale nomination expiry (7-day), reason storage on engage, Symphony relay forwarding, and surfacing config.'
    type: engine
    anchors:
      - nomination-engine.ts:1
    tags:
      - feature
      - ambient
      - nominations
      - debates
      - learning
      - surfacing
      - neverland
  session-work-log:
    description: Session work log — JSONL append log capturing agent contributions and user verdicts during a session. Read by Maestro at postflight for targeted learning feedback. Bounded at 200 entries, cleared on session start.
    type: loader
    anchors:
      - session-work-log.ts:1
    tags:
      - feature
      - maestro
      - learning
      - session
    components:
      - '#activity-metrics'
  agent-state:
    description: Per-project + global state tracking for agent continuity. Tracks last session summary, pending work, decisions, patterns, and career stats across sessions.
    type: service
    flows:
      - $agent-learning-loop
    signals:
      - '!agent-state-recorded'
    file: packages/paradigm-mcp/src/utils/agent-state.ts
  gap-narrator:
    description: Human-readable narration engine for enforcement check gaps. Produces explanations and fix instructions for 13 check types (missing-purpose, missing-gates, aspect-drift, stale-purpose, unregistered-symbol, unregistered-event, missing-flow, uncovered-endpoint, uncovered-gate, uncovered-flow, undocumented-aspect, missing-tests, missing-lore). Used by doctor --explain and postflight report generation.
    type: engine
    file: gap-narrator.ts
  activity-metrics:
    description: 'Proxy metrics tracking for session activity. Records tool call count, payload size, and session duration per agent. No dollar figures or token counts. Types: ActivityMetric, SessionActivitySummary. Functions: recordActivityMetric(), getSessionActivitySummary(), clearActivityMetrics().'
    type: service
    components:
      - '#session-work-log'
  soft-provenance:
    description: Optional parentId and lineageType fields on NotebookEntry for tracking derivation chains without DAG validation. Enables notebook promotion lineage tracking (promoted-from-lore, derived-from-notebook, manual-input). Used by paradigm_notebook_add tool and prepareForPublish() ringfencing.
    type: service
    components:
      - '#notebook-loader'
  outcome-reference-tracking:
    description: Records which notebook entries were loaded into agent prompts during orchestration. Pure data collection — no scoring or attribution.
    type: utility
    file: packages/paradigm-mcp/src/utils/session-work-log.ts
  compliance-health:
    description: Tracks stop hook violation frequency over time and computes compliance trends (improving/stable/degrading). Powers Conductor health dot.
    type: utility
    file: packages/paradigm-mcp/src/utils/compliance-health.ts
  yaml-validator:
    description: Fail-closed YAML loader returning a discriminated union (missing/unparseable/invalid/ok). Classifies YAMLException by reason into duplicate-key/syntax/other; detail strings are redacted classifiers only — never file contents, gate names, or route paths. Optional zod schema validation. v5.37.12 security patch (2026-04-22 audit). v5.38.0 re-exports classifyYamlError from @a-company/portal-core (single source of truth) and honors PARADIGM_STRICT=1 by throwing on non-ok results.
    type: utility
    tags:
      - security
      - fail-closed
      - portal
    file: packages/paradigm-mcp/src/utils/yaml-validator.ts
  write-and-confirm:
    description: v5.38.0 atomic-write + read-back verify wrapper for mutation handlers. Writes to .tmp sibling then renames; re-reads the file; runs verify callback; throws WriteVerificationError on failure. Returns WriteEnvelope with truncated HMAC (first 12 hex chars of HMAC-SHA256 keyed with per-install secret) and byte count. Applied to portal_add_gate, portal_add_route, purpose_add_component, purpose_link, purpose_remove. Logs redacted — no gate names or file paths in error surfaces.
    type: utility
    tags:
      - security
      - fail-closed
      - mutation-safety
    file: packages/paradigm-mcp/src/utils/write-and-confirm.ts
  consistency-tracker:
    description: v5.38.0 round-trip consistency audit log. Records transformation CLASSES (prefix-stripped/array-coerced/default-applied/duplicate-key-detected/case-normalized) with fixed surface classifiers (portal.yaml/purpose.yaml) and counts — never gate names, route paths, or file contents. One injectable singleton per reindex pass; report rendered into paradigm_reindex envelope and .paradigm/manifest.consistency.json. Lossy transformations trigger strict-mode reindex failure.
    type: engine
    tags:
      - security
      - redacted
      - portal
      - consistency
    file: packages/paradigm-mcp/src/utils/consistency-tracker.ts
  strict-mode:
    description: v5.38.0 PARADIGM_STRICT=1 env var gate. Default OFF; flip ON in v5.39.0 after field observation. In strict mode, safeLoad throws on any non-ok/non-missing result, reindex fails on lossy transformations, and writeAndConfirm verify failures are never downgraded.
    type: utility
    tags:
      - security
      - fail-closed
      - configuration
    file: packages/paradigm-mcp/src/utils/strict-mode.ts
  pack-loader:
    description: 'v6.0 (v5.39.0 sub-phase 1) multi-tenant content-pack discovery + resolution. loadPackManifest reads pack.yaml via safeLoad (classifier-only errors — never leaks file contents). discoverPacks scans three sources in precedence order: (1) node_modules/@a-company/university, (2) direct-deps with paradigm.universityPack pointer in package.json, (3) local .paradigm/university/ + discipline sub-packs. resolveEntryAddress parses <pack-id>:<entry-id> or bare ids; bare ids throw ambiguity errors when present in multiple active packs. Cache at .paradigm/cache/packs.json keyed by node_modules + local-university mtimes so npm install / local edits invalidate automatically. No consumers wired yet — sub-phase 2.'
    type: loader
    tags:
      - feature
      - university
      - pack
      - v6.0
    file: packages/paradigm-mcp/src/utils/pack-loader.ts
  university-metrics:
    description: v6.0 (v5.39.0 sub-phase 1, D7 locked) local-only metrics snapshot capture. captureSnapshot writes .paradigm/university/.metrics/snapshot-YYYY-MM-DD.json idempotent-per-day with counts + classifiers + hashed project salt only — no entry titles / gate names / file contents. Honors config.metrics.local_snapshots_enabled (no-op when false). loadRecentSnapshots returns newest-first slice. pruneOldSnapshots removes files older than 90 days (default). computeProjectSaltHash creates/reads .paradigm/.metrics-salt with 0o600 perms; salt is 32 bytes of crypto.randomBytes. Feeds v6.3 sunset review per spec §8.
    type: loader
    tags:
      - feature
      - university
      - metrics
      - telemetry
      - privacy
      - v6.0
    file: packages/paradigm-mcp/src/utils/university-metrics.ts
  wisdom-loader:
    description: 'Reads team wisdom from .paradigm/wisdom/ — preferences/antipatterns/expertise/decisions. 30s TTL cache, invalidated on writes. Global wisdom merged from ~/.paradigm/wisdom/ (local wins on id collision). v5.39.0 sub-phase 1: emits a one-time deprecation warning when .paradigm/wisdom/decisions/ still contains YAML files, pointing at `paradigm migrate decisions` (v6.0). Continues to read the directory — deprecation is additive; breaking removal is v6.0.'
    type: loader
    tags:
      - feature
      - knowledge-streams
      - wisdom
      - v6.0
    file: packages/paradigm-mcp/src/utils/wisdom-loader.ts
  arch-loader:
    description: Symbol architecture loader — reads and resolves project symbol graph for arch tools. Provides structured access to component hierarchy, flows, gates, and signals for the Atlas cartographer agent.
    file: packages/paradigm-mcp/src/utils/arch-loader.ts
    type: loader
