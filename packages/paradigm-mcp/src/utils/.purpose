version: 2.0.0
description: |
  Utility modules for the MCP server — loaders, caches, and data access.

components:
  symphony-loader:
    description: "The Score: file-based agent messaging — agent identity, JSONL parts, threads, file pipeline, trust config. ensureMailDirs renamed to ensureScoreDirs (deprecated alias retained)."
    type: loader
    tags: [feature, symphony]
    anchors:
      - symphony-loader.ts:1-988
  university-loader:
    description: "Per-project university loader — CRUD for notes/policies/quizzes/paths/diplomas, index rebuild, validation, symbol linking for ripple"
    type: loader
    tags: [feature, university]
  platform-bridge:
    description: "HTTP bridge for MCP → Platform server communication. Resolves port from config.yaml, resolves agent identity, sends POST to /api/platform/agent-command."
    type: loader
    tags: [feature, platform, agent-ui]
  symphony-peers:
    description: "Peer trust records for Symphony cross-machine networking — peers.json CRUD, pairing code generation/verification, HMAC authentication."
    type: loader
    tags: [feature, symphony, networking]
    anchors:
      - symphony-peers.ts:1-229
  symphony-relay:
    description: "WebSocket relay engine for cross-machine Symphony networking — hub/spoke modes, outbox watcher, message routing, dedup, keepalive, auto-reconnect."
    type: integration
    tags: [feature, symphony, networking]
    anchors:
      - symphony-relay.ts:1-925
  agent-loader:
    description: "CRUD for .agent identity files — load/save profiles, expertise queries, auto-update from lore, merge with agents.yaml, sync from lore history, permission checking (path/tool), integrity hash computation/verification"
    type: loader
    tags: [feature, agent-identity, permissions]
  notebook-loader:
    description: "CRUD for agent notebook entries — load/save, search, promote from lore, increment applied count"
    type: loader
    tags: [feature, notebooks, agent-identity]
  tool-registry:
    description: "Tiered tool registration system — core/feature/advanced tiers with auto-detection"
    type: loader
    tags: [feature, tool-loading, mcp]
  compliance-checker:
    description: "Shared compliance checking logic — purpose coverage, portal gates, aspect anchors, code quality"
    type: service
    tags: [feature, review, compliance]
