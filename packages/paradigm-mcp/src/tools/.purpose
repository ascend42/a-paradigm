version: 2.0.0
description: |
  MCP tool handlers — dispatch layer for all paradigm_* tool calls.
  Each tool file exports getXToolsList() + handleXTool() functions.
components:
  paradigm-propose-block:
    description: v6.1 soft-block primitive — agent-initiated remediation that the Stop hook honors
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - v6.1
      - mcp
      - enforcement
  paradigm-authority-claim:
    description: v6.1 authority MCP tool — claim authority over a scope in .paradigm/authority.yaml
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - v6.1
      - mcp
      - authority
  paradigm-authority-release:
    description: v6.1 authority MCP tool — release authority over a scope (removes claim entry)
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - v6.1
      - mcp
      - authority
  symphony-peek:
    description: Ultra-cheap inbox check — fs.stat only, no parsing. Returns hasNew true/false for near-free /loop monitoring
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-poll:
    description: Poll Score part for new notes (agent heartbeat)
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-send:
    description: Send a note to other agents or broadcast via The Score
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-status:
    description: List agents, threads, peers, and unread count in The Score
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-thread:
    description: Get full thread context with notes and decisions
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-request-file:
    description: Request a file from another agent's project via The Score
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-approve-file:
    description: Approve or deny a pending file request
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  SymphonyEventBridge:
    description: Bridges Score notes to Sentinel events via fire-and-forget POST. Auto-registers paradigm-symphony schema on first call, maps MessageIntent to event types and categories.
    type: integration
    parent: '#SymphonyTools'
    anchors:
      - symphony.ts:657-756
    tags:
      - integration
      - symphony
      - sentinel
  graduation-check:
    description: 'paradigm_graduate_check: check habit graduation eligibility with compliance data and reasoning'
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - graduation
      - mcp
  graduation-status:
    description: 'paradigm_graduate_status: show automation tier map (hook/habit/mcp) with savings estimate'
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - graduation
      - mcp
  lore-record:
    description: "paradigm_lore_record: record a lore entry. v6.0 hard-rejects type:'decision' with a structured envelope (code:lore_type_decision_removed, successor_tool:paradigm_decision_record) — shared with assessment-record via utils/lore-rejection.ts."
    type: tool
    parent: '#LoreTools'
    tags:
      - feature
      - lore
      - mcp
  assessment-record:
    description: "[DEPRECATED] paradigm_assessment_record: thin wrapper around lore. v6.0 also hard-rejects type:'decision' here (back-door closure) using the same shared rejection envelope as paradigm_lore_record."
    type: tool
    parent: '#LoreTools'
    tags:
      - deprecated
      - lore
      - mcp
  lore-assess:
    description: 'paradigm_lore_assess: record human assessment verdict (correct/partial/incorrect) on a lore entry, auto-compute calibration delta'
    type: tool
    parent: '#LoreTools'
    tags:
      - feature
      - lore
      - calibration
      - mcp
  lore-calibration:
    description: 'paradigm_lore_calibration: query calibration statistics — accuracy rate, avg confidence, calibration score, verdict breakdown, groupBy (symbol/tag/type), low-N insights'
    type: tool
    parent: '#LoreTools'
    tags:
      - feature
      - lore
      - calibration
      - mcp
  UniversityTools:
    description: 9 MCP tools for per-project university (search, get, create, update, quiz, submit, onboard, diplomas, validate)
    type: tool-group
    tags:
      - feature
      - university
      - mcp
  PlatformTools:
    description: 5 MCP tools for agent-driven UI (navigate, highlight, annotate, observe, clear) — HTTP bridge to Platform server
    type: tool-group
    tags:
      - feature
      - platform
      - agent-ui
      - mcp
  AgentTools:
    description: 3 MCP tools for agent identity (paradigm_agent_list, paradigm_agent_expertise, paradigm_agent_get) — persistent profiles with expertise tracking, permission display, integrity verification
    type: tool-group
    tags:
      - feature
      - agent-identity
      - permissions
      - mcp
  NotebookTools:
    description: 3 MCP tools for agent notebooks (paradigm_notebook_search, paradigm_notebook_add, paradigm_notebook_promote) — curated snippet libraries
    type: tool-group
    tags:
      - feature
      - notebooks
      - agent-identity
      - mcp
  DocsTools:
    description: MCP tools for auto-generated documentation — manifest, page, search
    type: tool-group
    tags:
      - feature
      - docs
  StreamsTools:
    description: 6 MCP tools for the three knowledge streams — paradigm_work_log_record/search, paradigm_journal_record/search, paradigm_decision_record/search
    type: tool-group
    tags:
      - feature
      - knowledge-streams
      - work-log
      - journal
      - decisions
      - mcp
  AmbientTools:
    description: 8 MCP tools for ambient coordination — paradigm_ambient_nominations, paradigm_ambient_events, paradigm_ambient_engage (with reason storage), paradigm_ambient_learn, paradigm_ambient_promote, paradigm_ambient_health (validation metrics), paradigm_context_compose, plus surfacing config
    type: tool-group
    tags:
      - feature
      - ambient
      - nominations
      - events
      - context-composition
      - learning
      - neverland
      - mcp
  CaptainTools:
    description: 2 MCP tools for Cid (the Captain agent) — paradigm_captain_brief (pre-task context discovery pipeline: search + navigate + ripple + wisdom + protocol + lore → Context Brief injected into every agent prompt) and paradigm_captain_debrief (post-task coverage audit: .purpose stub creation, pending-review queueing, lore recording, .cid-briefed stop hook marker, sessionInsights object handed off to Loid for the learning pass). Core-tier always loaded. Cid closes navigation; Loid closes learning.
    type: tool-group
    tags:
      - core
      - captain
      - cid
      - orchestration
      - coverage
      - session-learning
      - mcp
    signals:
      - '!cid-brief-produced'
      - '!cid-debrief-complete'
      - '!coverage-stub-created'
      - '!session-insights-ready'
  OrchestrationTools:
    description: 2 MCP tools for Maestro team orchestration — paradigm_orchestrate_inline (plan/execute with ambient-enriched agent profiles, attributed responses, Symphony thread recording, documentor as final stage, Cid captain brief injected into every agent) and paradigm_agent_prompt (single agent with full context injection). Nora (ftux) is a core tier-1 agent in the roster — runs after Builder on user-visible surfaces, before Documentor. v6.0.3+ adds Scholar (tier-1 core, paired with Sheila/educator via partners primitive — research/curation specialist) and Swift (tier-2 ecosystem, auto-rosters on *.swift detection — Swift/SwiftUI/Apple-platform expertise with global cross-project notebook compounding).
    type: tool-group
    tags:
      - feature
      - orchestration
      - maestro
      - agents
      - partners
      - symphony
      - documentor
      - ftux
      - mcp
  tool-aliases:
    description: Alternate names and intent phrases on tool definitions for better LLM tool matching. Simple string arrays, not semantic embeddings.
    file: packages/paradigm-mcp/src/tools/tool-registry.ts
    type: utility
