version: 2.0.0
description: |
  MCP tool handlers — dispatch layer for all paradigm_* tool calls.
  Each tool file exports getXToolsList() + handleXTool() functions.
components:
  paradigm-retrieve:
    description: Rehydrate a large payload SPILLED to .paradigm/spill/{handle}.json (the #spill primitive) — full data on disk, bounded preview + handle inline; optional offset/limit windows for arrays
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - mcp
      - spill
  paradigm-propose-block:
    description: v6.1 soft-block primitive — agent-initiated remediation that the Stop hook honors
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - v6.1
      - mcp
      - enforcement
  paradigm-authority-claim:
    description: v6.1 authority MCP tool — claim authority over a scope in .paradigm/authority.yaml
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - v6.1
      - mcp
      - authority
  paradigm-authority-release:
    description: v6.1 authority MCP tool — release authority over a scope (removes claim entry)
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - v6.1
      - mcp
      - authority
  symphony-peek:
    description: Ultra-cheap inbox check — fs.stat only, no parsing. Returns hasNew true/false for near-free /loop monitoring
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-poll:
    description: Poll Score part for new notes (agent heartbeat). v7.1 also runs a peer status flow-back pass (applyTaskStatusFlowBack) — inbound task-protocol notes (progress/task-complete/task-failed) carrying metadata.task.taskId map onto a LOCAL updateTask (in-progress/done/shelved), closing loop-closure for the Symphony/peer (Cursor, cross-machine) path. Best-effort, local-only, never breaks poll; settlement fires automatically for parented tasks.
    type: tool
    parent: '#ToolHandlers'
    signals:
      - symphony-status-flowback
    tags:
      - feature
      - symphony
      - mcp
  symphony-send:
    description: Send a note to other agents or broadcast via The Score
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-status:
    description: List agents, threads, peers, and unread count in The Score
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-thread:
    description: Get full thread context with notes and decisions
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-request-file:
    description: Request a file from another agent's project via The Score
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  symphony-approve-file:
    description: Approve or deny a pending file request
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - symphony
      - mcp
  SymphonyEventBridge:
    description: Bridges Score notes to Sentinel events via fire-and-forget POST. Auto-registers paradigm-symphony schema on first call, maps MessageIntent to event types and categories.
    type: integration
    parent: '#SymphonyTools'
    anchors:
      - symphony.ts:657-756
    tags:
      - integration
      - symphony
      - sentinel
  graduation-check:
    description: 'paradigm_graduate_check: check habit graduation eligibility with compliance data and reasoning'
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - graduation
      - mcp
  graduation-status:
    description: 'paradigm_graduate_status: show automation tier map (hook/habit/mcp) with savings estimate'
    type: tool
    parent: '#ToolHandlers'
    tags:
      - feature
      - graduation
      - mcp
  lore-record:
    description: 'paradigm_lore_record: record a lore entry. v6.0 hard-rejects type:''decision'' with a structured envelope (code:lore_type_decision_removed, successor_tool:paradigm_decision_record) — shared with assessment-record via utils/lore-rejection.ts.'
    type: tool
    parent: '#LoreTools'
    tags:
      - feature
      - lore
      - mcp
  assessment-record:
    description: '[DEPRECATED] paradigm_assessment_record: thin wrapper around lore. v6.0 also hard-rejects type:''decision'' here (back-door closure) using the same shared rejection envelope as paradigm_lore_record.'
    type: tool
    parent: '#LoreTools'
    tags:
      - deprecated
      - lore
      - mcp
  lore-assess:
    description: 'paradigm_lore_assess: record human assessment verdict (correct/partial/incorrect) on a lore entry, auto-compute calibration delta'
    type: tool
    parent: '#LoreTools'
    tags:
      - feature
      - lore
      - calibration
      - mcp
  lore-calibration:
    description: 'paradigm_lore_calibration: query calibration statistics — accuracy rate, avg confidence, calibration score, verdict breakdown, groupBy (symbol/tag/type), low-N insights'
    type: tool
    parent: '#LoreTools'
    tags:
      - feature
      - lore
      - calibration
      - mcp
  UniversityTools:
    description: 9 MCP tools for per-project university (search, get, create, update, quiz, submit, onboard, diplomas, validate)
    type: tool-group
    tags:
      - feature
      - university
      - mcp
  PlatformTools:
    description: 5 MCP tools for agent-driven UI (navigate, highlight, annotate, observe, clear) — HTTP bridge to Platform server
    type: tool-group
    tags:
      - feature
      - platform
      - agent-ui
      - mcp
  AgentTools:
    description: 3 MCP tools for agent identity (paradigm_agent_list, paradigm_agent_expertise, paradigm_agent_get) — persistent profiles with expertise tracking, permission display, integrity verification
    type: tool-group
    tags:
      - feature
      - agent-identity
      - permissions
      - mcp
  NotebookTools:
    description: 3 MCP tools for agent notebooks (paradigm_notebook_search, paradigm_notebook_add, paradigm_notebook_promote) — curated snippet libraries
    type: tool-group
    tags:
      - feature
      - notebooks
      - agent-identity
      - mcp
  DocsTools:
    description: MCP tools for auto-generated documentation — manifest, page, search
    type: tool-group
    tags:
      - feature
      - docs
  StreamsTools:
    description: 6 MCP tools for the three knowledge streams — paradigm_work_log_record/search, paradigm_journal_record/search, paradigm_decision_record/search
    type: tool-group
    tags:
      - feature
      - knowledge-streams
      - work-log
      - journal
      - decisions
      - mcp
  AmbientTools:
    description: 8 MCP tools for ambient coordination — paradigm_ambient_nominations, paradigm_ambient_events, paradigm_ambient_engage (with reason storage), paradigm_ambient_learn, paradigm_ambient_promote, paradigm_ambient_health (validation metrics), paradigm_context_compose, plus surfacing config. The postflight learning pass (runPostflightLearning) also consumes durable iteration-revisions (agent belief-revisions from iteration loops) into self_reflection journal entries, separate from the human-verdict path.
    type: tool-group
    tags:
      - feature
      - ambient
      - nominations
      - events
      - context-composition
      - learning
      - neverland
      - mcp
  CaptainTools:
    description: '3 MCP tools for Cid (the Captain agent) — paradigm_captain_brief (pre-task context discovery pipeline: search + navigate + ripple + wisdom + protocol + lore → Context Brief injected into every agent prompt), paradigm_captain_debrief (post-task coverage audit: .purpose stub creation, pending-review queueing, lore recording, .cid-briefed stop hook marker, sessionInsights object handed off to Loid; v7 §3 adds a postflight-liveness check that self-heals — runs runPostflightLearning itself when the settlement-liveness probe shows no postflight ran, and on self-heal failure proposes an ADVISE block, never guard), and paradigm_captain_board (#captain-board — Cid''s owned run-DAG read+write artifact: read assembles the live orchestration DAG from non-terminal epic tasks + their stage-children ordered by stage/dependsOn, plus ripple-ranked unclaimed open tasks and a summary; claim writes a task claimant keeping status open with a human/peer-over-archetype override guard; advance records a Cid-owned blocked_on reason without changing status — v7.0 has no blocked status). Core-tier always loaded. Cid closes navigation; Loid closes learning. Ownership boundary: Cid writes claimant/blocked_on (present tense); Loid writes settledAt (past tense) — they never co-write a field.'
    type: tool-group
    tags:
      - core
      - captain
      - cid
      - orchestration
      - coverage
      - session-learning
      - captain-board
      - mcp
    signals:
      - '!cid-brief-produced'
      - '!cid-debrief-complete'
      - '!coverage-stub-created'
      - '!session-insights-ready'
      - '!cid-claim-written'
      - '!cid-postflight-self-healed'
  OrchestrationTools:
    description: 2 MCP tools for Maestro team orchestration — paradigm_orchestrate_inline (plan/execute with ambient-enriched agent profiles, attributed responses, Symphony thread recording, documentor as final stage, Cid captain brief injected into every agent) and paradigm_agent_prompt (single agent with full context injection). Role-prompt precedence in buildAgentPromptInternal is hardcoded ROLE_PROMPTS constant → rich .agent profile description → one-line role → generic builder, so all 67 bundled archetypes render their full persona. AGENT_TIERS + DEFAULT_TIER_MODELS cover all 67 archetypes with a deterministic tier-2/sonnet fallback for any unmapped agent. Nora (ftux) is a core tier-1 agent in the roster — runs after Builder on user-visible surfaces, before Documentor. v6.0.3+ adds Scholar (tier-1 core, paired with Sheila/educator via partners primitive — research/curation specialist) and Swift (tier-2 ecosystem, auto-rosters on *.swift detection — Swift/SwiftUI/Apple-platform expertise with global cross-project notebook compounding). v7.1 #calibration — the cost-preview token estimate is now LEARNED-FIRST. loadLearnedTokenTable reads .paradigm/learned/token-estimates.json (best-effort; missing or malformed yields empty) and resolveAgentEstimate prefers the archetype/taskType learned band, falling back to the AGENT_TOKEN_ESTIMATES constant (now the cold-start prior, not the source of truth) for any cell the crew hasn't learned. Written by `paradigm calibrate` from actuals the CLI orchestrator captures.
    type: tool-group
    tags:
      - feature
      - orchestration
      - maestro
      - agents
      - partners
      - symphony
      - documentor
      - ftux
      - mcp
  tool-aliases:
    description: Alternate names and intent phrases on tool definitions for better LLM tool matching. Simple string arrays, not semantic embeddings.
    type: utility
    file: packages/paradigm-mcp/src/tools/tool-registry.ts
  paradigm-arch-status:
    description: 'paradigm_arch_status MCP tool — returns a structured snapshot of the project symbol graph: component counts, flow coverage, gate coverage, and orphan detection. Consumed by the Atlas cartographer agent.'
    type: tool
    parent: '#arch-tools'
    file: packages/paradigm-mcp/src/tools/arch.ts
  paradigm-arch-diagram:
    description: paradigm_arch_diagram MCP tool — generates a text or Mermaid diagram of the project symbol graph (components, flows, gates). Consumed by the Atlas cartographer agent and the paradigm arch CLI.
    type: tool
    parent: '#arch-tools'
    file: packages/paradigm-mcp/src/tools/arch.ts
  arch-tools:
    description: MCP tool group for symbol architecture inspection — paradigm_arch_status and paradigm_arch_diagram. Backed by arch-loader; used by the Atlas cartographer agent to surface project structure.
    type: tool-group
    components:
      - '#paradigm-arch-status'
      - '#paradigm-arch-diagram'
    file: packages/paradigm-mcp/src/tools/arch.ts
  captain-board:
    description: v7 §3 — paradigm_captain_board, Cid's owned run-DAG artifact (read|claim|advance). read assembles the live orchestration DAG from non-terminal epic tasks + their stage children (ordered by stage/dependsOn) plus ripple-ranked unclaimed open tasks; claim writes a task claimant keeping status open (human/peer override archetype); advance records a Cid-owned blocked_on reason. Session-open proposes claimants (a real per-session mutation, replacing the anonymous task dump); session-close debrief reads the settlement-liveness probe and self-heals (runs postflight itself, advise-not-guard). Resolves the audit's inert-Captain finding.
    file: src/tools/captain.ts
    type: tool
