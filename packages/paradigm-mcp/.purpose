version: 1.0.0
description: |
  @a-company/paradigm-mcp - MCP (Model Context Protocol) server for Paradigm.
  Exposes symbols, gates, flows, and analysis tools to AI assistants like Claude.
  Technology agnostic - works with any language or framework.

features:
  mcp-resources:
    description: "Read-only data exposed via MCP protocol"
    components: ["#symbols-resource", "#gates-resource", "#flows-resource"]
    signals: ["!resource-read"]

  mcp-tools:
    description: "Actions AI can invoke via MCP protocol"
    components: ["#search-tool", "#ripple-tool", "#related-tool", "#status-tool", "#gates-for-route-tool"]
    signals: ["!tool-invoked"]

  index-loading:
    description: "Load project symbol index on startup"
    components: ["#index-loader", "#context-manager"]
    signals: ["!context-loaded", "!context-error"]

components:
  symbols-resource:
    description: "paradigm://symbols and paradigm://symbol/{symbol}"
    used-by: ["@mcp-resources"]

  gates-resource:
    description: "paradigm://gates with lock/key details"
    used-by: ["@mcp-resources"]

  flows-resource:
    description: "paradigm://flows with step sequences"
    used-by: ["@mcp-resources"]

  search-tool:
    description: "paradigm_search - find symbols by query"
    used-by: ["@mcp-tools"]

  ripple-tool:
    description: "paradigm_ripple - impact analysis"
    used-by: ["@mcp-tools"]

  related-tool:
    description: "paradigm_related - connected symbols"
    used-by: ["@mcp-tools"]

  status-tool:
    description: "paradigm_status - project overview"
    used-by: ["@mcp-tools"]

  gates-for-route-tool:
    description: "paradigm_gates_for_route - suggest gates for a route"
    used-by: ["@mcp-tools"]

  index-loader:
    description: "Loads symbol index using premise-core"
    used-by: ["@index-loading"]

  context-manager:
    description: "Manages project context state"
    used-by: ["@index-loading"]

signals:
  resource-read:
    description: "MCP resource was fetched"
    category: mcp
    severity: info

  tool-invoked:
    description: "MCP tool was called"
    category: mcp
    severity: info

  context-loaded:
    description: "Project context successfully loaded"
    category: mcp
    severity: info

  context-error:
    description: "Failed to load project context"
    category: mcp
    severity: error
