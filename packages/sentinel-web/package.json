{
  "name": "@a-company/sentinel-web",
  "version": "0.1.0",
  "description": "Zero-dependency browser client for Sentinel — schema-driven event ingestion",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git",
    "directory": "packages/sentinel-web"
  },
  "keywords": [
    "sentinel",
    "observability",
    "browser",
    "telemetry",
    "events"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
