version: 2.0.0
description: Zero-dependency browser client for Sentinel schema-driven observability
components:
  sentinel-web-client:
    description: Browser SDK for emitting events to Sentinel via HTTP
    type: service
  ring-buffer:
    description: Fixed-size circular buffer for event batching with backpressure
    type: utility
signals:
  events-flushed:
    description: Emitted when buffered events are sent to Sentinel server
    emitters:
      - '#sentinel-web-client'
  events-dropped:
    description: Emitted when events are dropped due to buffer overflow
    emitters:
      - '#ring-buffer'
flows:
  event-ingestion:
    description: emit() → buffer → periodic flush → POST /api/events
    signals:
      - '!events-flushed'
      - '!events-dropped'
    components:
      - '#sentinel-web-client'
      - '#ring-buffer'
    steps:
      - component: '#sentinel-web-client'
        action: emit() call from application code
      - component: '#ring-buffer'
        action: push event into circular buffer
      - component: '#sentinel-web-client'
        action: setInterval flush to server
      - component: '#sentinel-web-client'
        action: POST /api/events
