purpose: Zero-dependency browser client for Sentinel schema-driven observability
version: 0.1.0

components:
  - id: "#sentinel-web-client"
    description: "Browser SDK for emitting events to Sentinel via HTTP"
    tags: [feature, browser, sdk]
  - id: "#ring-buffer"
    description: "Fixed-size circular buffer for event batching with backpressure"
    tags: [feature, data-structure]

signals:
  - id: "!events-flushed"
    description: "Emitted when buffered events are sent to Sentinel server"
  - id: "!events-dropped"
    description: "Emitted when events are dropped due to buffer overflow"

flows:
  - id: "$event-ingestion"
    description: "emit() → buffer → periodic flush → POST /api/events"
    steps:
      - "#sentinel-web-client emit()"
      - "#ring-buffer push"
      - "setInterval flush"
      - "POST /api/events"
      - "!events-flushed"

dependencies:
  - "@a-company/sentinel (server-side)"

notes: |
  This package has zero runtime dependencies. It uses:
  - crypto.randomUUID() for ID generation
  - navigator.sendBeacon() for beforeunload flush
  - fetch() for HTTP transport
  Self-contained types — does not import from @a-company/sentinel.
