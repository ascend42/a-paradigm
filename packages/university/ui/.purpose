version: 2.0.0
description: |
  React SPA for Paradigm University. v6.5 adds SectionNav (tab strip) and
  SectionView (style dispatcher) so multi-section packs render their declared
  tabs. Single-section packs collapse SectionNav and render pixel-identical
  to v6.4 (back-compat path).
components:
  header:
    description: Header component
    type: view
  progress-ring:
    description: ProgressRing component
    type: view
  question-card:
    description: QuestionCard component
    type: view
  seal:
    description: Seal component
    type: view
  timer:
    description: Timer component
    type: view
  certificate-view:
    description: CertificateView component
    type: view
  course-view:
    description: CourseView component
    type: view
  courses-view:
    description: CoursesView component — routes through SectionView when the active pack declares sections, falls back to the v6.4 track renderer otherwise
    type: view
  home-view:
    description: HomeView component
    type: view
  plsatview:
    description: PLSATView component
    type: view
  quiz-view:
    description: QuizView component
    type: view
  reference-view:
    description: ReferenceView component
    type: view
  section-nav:
    description: v6.5 tab strip rendering the active pack's declared sections; collapsed when only one section is present (back-compat with v6.4)
    type: view
    tags: [university, sections, v6.5]
  section-view:
    description: v6.5 style dispatcher — renders track at v6.5; index/chronological/featured fall back to track with a dev-console warning until dedicated renderers ship
    type: view
    tags: [university, sections, v6.5]
