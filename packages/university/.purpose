version: 2.0.0
name: university
description: |
  First-party Paradigm University content pack (`id: paradigm`) — PARA notes,
  quizzes, learning paths and the PLSAT, under src/content with pack.yaml at the
  package root. 7.0.0 (Paradigm 7.11.0): the standalone UI + Express server were
  removed; the pack is read through @a-company/university-core and shown in the
  Paradigm Platform's Academy section (`paradigm university serve` redirects there).

components:
  university-pack:
    description: |
      Pack locator exports only — universityPackRoot() (the package root holding
      pack.yaml) and universityContentDir() (src/content). No server, no UI.
    type: config
    file: src/index.ts
    tags: [feature, university, pack]
  university-content:
    description: >-
      The pack's content, read by @a-company/university-core: src/content/pack.yaml
      (pack manifest), src/content/reference.json, src/content/notes/ (N-*.md
      lesson notes), src/content/quizzes/ (Q-*.yaml quizzes, one per note) and
      src/content/paths/ (LP-*.yaml learning paths that order notes and quizzes).
      Data only, no code.
    type: config
    paths:
      - src/content
      - src/content/notes
      - src/content/quizzes
      - src/content/paths
    components:
      - '#university-pack'
    tags: [university, pack, content]
