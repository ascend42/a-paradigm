version: 2.0.0
name: university
description: |
  Interactive academia-themed learning platform for the Paradigm framework — courses, quizzes, the PLSAT certification exam, and a reference library.
  v6.5: packs can declare a `sections:` block grouping entries into named tabs (styles: track | index | chronological | featured). First-party pack ships two sections (Courses, Field Notes). Single-section packs render identically to v6.4 via implicit-default back-compat.

components:
  university-server:
    description: Express server serving static UI and content API endpoints
    type: service
    file: src/server/index.ts
    tags: [feature]
    endpoints:
      - GET /api/courses
      - GET /api/courses/:id
      - GET /api/courses/:id/lessons/:lessonId
      - GET /api/plsat
      - GET /api/plsat/:version
      - GET /api/reference
      - GET /api/health

  courses-router:
    description: API routes for course listing and individual course/lesson retrieval
    type: route
    file: src/server/routes/courses.ts

  plsat-router:
    description: API routes for PLSAT exam versions — resolves v3.0 variants, flattens passage groups, shuffles blocks (Fisher-Yates). Backward-compatible with v2.0 flat questions. v3.0 includes variants for two-stage review protocol and clarification markers.
    type: route
    file: src/server/routes/plsat.ts

  university-ui:
    description: React SPA with academia theme — course reader, quiz engine, PLSAT exam, certificate viewer, reference library
    type: app
    file: ui/src/App.tsx
    tags: [feature]
    components:
      - "#home-view"
      - "#course-view"
      - "#quiz-view"
      - "#plsat-view"
      - "#reference-view"
      - "#certificate-view"

  home-view:
    description: Campus landing page with course catalog, progress rings, and quick links
    type: view
    file: ui/src/views/HomeView.tsx

  course-view:
    description: Lesson reader with sidebar navigation, markdown rendering, and quiz links
    type: view
    file: ui/src/views/CourseView.tsx

  quiz-view:
    description: Per-lesson quiz with ABCDE questions and immediate feedback
    type: view
    file: ui/src/views/QuizView.tsx

  plsat-view:
    description: Timed 99-question certification exam with intro, exam, review, and results phases. Renders passage blocks above passage-group questions.
    type: view
    file: ui/src/views/PLSATView.tsx

  reference-view:
    description: Quick reference cards for symbols, MCP tools, CLI commands, tags, and workflows
    type: view
    file: ui/src/views/ReferenceView.tsx

  certificate-view:
    description: Printable PLSAT certificate with university seal, score, and version tracking
    type: view
    file: ui/src/views/CertificateView.tsx

  progress-store:
    description: Zustand store with LocalStorage persistence for lesson completion and quiz scores
    type: store
    file: ui/src/store/progressStore.ts
    tags: [state]

  plsat-store:
    description: Zustand store with LocalStorage persistence for PLSAT certificates and student name
    type: store
    file: ui/src/store/plsatStore.ts
    tags: [state]

  courses-store:
    description: Zustand store for fetched course data from API with caching
    type: store
    file: ui/src/store/coursesStore.ts
    tags: [state]

  university-seal:
    description: SVG university seal component — "Universitas Paradigmatica — Lux in Codice"
    type: view
    file: ui/src/components/Seal.tsx

  question-card:
    description: ABCDE question renderer with controlled (PLSAT) and uncontrolled (quiz) modes
    type: view
    file: ui/src/components/QuestionCard.tsx

  plsat-timer:
    description: Countdown timer component for PLSAT exam (90 minutes)
    type: view
    file: ui/src/components/Timer.tsx

  progress-ring:
    description: Circular SVG progress indicator for course completion percentages
    type: view
    file: ui/src/components/ProgressRing.tsx

  university-header:
    description: Navigation bar with university seal, course/PLSAT/reference links, and version badge
    type: view
    file: ui/src/components/Header.tsx

  section-nav:
    description: v6.5 tab strip rendering the active pack's declared sections; collapsed when only one section is present (back-compat with v6.4)
    type: view
    file: ui/src/components/SectionNav.tsx
    tags: [university, sections, v6.5]

  section-view:
    description: v6.5 style dispatcher routing track | index | chronological | featured to a renderer; only track renders natively at v6.5, others fall back to track with a warning
    type: view
    file: ui/src/views/SectionView.tsx
    tags: [university, sections, v6.5]

  academia-theme:
    description: CSS theme with Crimson Pro serif fonts, parchment colors, burgundy/gold accents
    type: config
    file: ui/src/styles/academia.css

aspects:
  ~plsat-pass-threshold-90pct:
    description: "PLSAT pass threshold is 0.9 (90%); defined in content JSON and read by the server at runtime"
    category: configuration
    severity: high
    tags: [plsat, certification]
    anchors:
      - src/server/routes/plsat.ts:50
    applies-to:
      - "#plsat-router"

  ~plsat-fisher-yates-shuffle:
    description: "v3.0 exam blocks are shuffled using Fisher-Yates algorithm; passage groups move as a unit to keep related questions together"
    category: decision
    severity: high
    tags: [plsat, randomization]
    anchors:
      - src/server/routes/plsat.ts:77-83
      - src/server/routes/plsat.ts:130
    applies-to:
      - "#plsat-router"

  ~plsat-v3-variant-resolution:
    description: "v3.0 items have multiple variants per slot; server picks one random variant per slot so each exam attempt is unique while covering the same topics"
    category: decision
    severity: high
    tags: [plsat, variants]
    anchors:
      - src/server/routes/plsat.ts:72-74
      - src/server/routes/plsat.ts:90-133
    applies-to:
      - "#plsat-router"

  ~university-cors-wildcard:
    description: "University server sets Access-Control-Allow-Origin: * for development cross-origin API access"
    category: configuration
    severity: low
    tags: [cors, development]
    anchors:
      - src/server/index.ts:102-107
    applies-to:
      - "#university-server"

signals:
  "!plsat-completed":
    description: Student has completed a PLSAT exam attempt
    emitters: ["#plsat-view"]
    category: business

  "!quiz-completed":
    description: Student has completed a per-lesson quiz
    emitters: ["#quiz-view"]
    category: business

flows:
  $plsat-exam-flow:
    description: Full PLSAT exam lifecycle from intro through certification
    steps:
      - component: "#plsat-view"
        action: Display intro, rules, and name input
      - component: "#plsat-timer"
        action: Start 90-minute countdown
      - component: "#question-card"
        action: Present 99 shuffled questions (with passage blocks for grouped questions)
      - component: "#plsat-view"
        action: Calculate score on submit or time-up
      - component: "#plsat-store"
        action: Persist certificate to LocalStorage
      - component: "#certificate-view"
        action: Display printable certificate if passed
