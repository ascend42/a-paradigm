version: 2.0.0
description: |
  @a-company/portal-sdk - Runtime SDK for checking gates in applications.
  Provides decorators, evaluators, and client APIs for authorization checks.
features:
  gate-checking:
    description: '@gate-checking: Runtime evaluation of gate conditions'
    gates:
      - ^gate-check
    signals:
      - '!gate-passed'
      - '!gate-denied'
    components:
      - '#evaluator'
      - '#context-resolver'
  decorator-api:
    description: '@decorator-api: TypeScript decorators for gate protection'
    components:
      - '#gate-decorator'
      - '#require-decorator'
  client-api:
    description: '@client-api: Programmatic API for gate checks'
    components:
      - '#portal-client'
      - '#gate-client'
components:
  evaluator:
    description: '#evaluator: Evaluates gate keys against context'
    type: utility
  context-resolver:
    description: '#context-resolver: Resolves user context for evaluation'
    type: utility
  gate-decorator:
    description: '#gate-decorator: @Gate() decorator for methods'
    type: utility
  require-decorator:
    description: '#require-decorator: @Require() decorator for properties'
    type: utility
  portal-client:
    description: '#portal-client: High-level client for portal operations'
    type: service
  gate-client:
    description: '#gate-client: Low-level gate checking client'
    type: service
gates:
  gate-check:
    description: '^gate-check: Internal gate for SDK validation'
    keys:
      - context.valid
aspects:
  ~safe-expression-evaluator-no-eval:
    description: "Expression evaluator uses custom tokenizer + recursive descent parser; never uses eval()"
    category: decision
    severity: critical
    tags: [security, evaluation]
    anchors:
      - src/evaluator.ts:1-6
      - src/evaluator.ts:155-388
    applies-to:
      - "#evaluator"

  ~one-time-prize-tracking:
    description: One-time prizes are tracked per entity ID and skipped if already fired for that entity
    category: rule
    severity: high
    tags: [prizes, state]
    anchors:
      - src/client.ts:196-212
    applies-to:
      - "#gate-client"

  ~watcher-reconnect-5s:
    description: WebSocket watcher reconnects after 5 seconds on close (dev mode only)
    category: configuration
    severity: low
    tags: [dev, websocket]
    anchors:
      - src/client.ts:89-92
    applies-to:
      - "#gate-client"

  ~gate-guard-fail-modes:
    description: "GateGuard decorator supports three failure modes: throw, return-null, return-false"
    category: decision
    severity: medium
    tags: [decorators, error-handling]
    anchors:
      - src/decorators/index.ts:36
      - src/decorators/index.ts:86-94
    applies-to:
      - "#gate-decorator"

  ~validator-production-disabled:
    description: Portal validator logging is disabled in production unless PORTAL_VALIDATION=true
    category: rule
    severity: medium
    tags: [logging, environment]
    anchors:
      - src/validator.ts:27-46
    applies-to:
      - "#portal-client"

  ~validator-max-stored-results-100:
    description: Gate results store keeps at most 100 entries to prevent memory leaks
    category: configuration
    severity: low
    tags: [memory, testing]
    anchors:
      - src/validator.ts:73
      - src/validator.ts:328-329
    applies-to:
      - "#portal-client"

signals:
  gate-passed:
    description: '!gate-passed: Gate check passed, access granted'
    category: portal
    severity: info
  gate-denied:
    description: '!gate-denied: Gate check failed, access denied'
    category: portal
    severity: warn
