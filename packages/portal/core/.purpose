version: 2.0.0
description: |
  @a-company/portal-core - Core library for parsing and validating portal.yaml files.
  Handles gate definitions, locks, keys, prizes, and authorization topology.
features:
  portal-parsing:
    description: '@portal-parsing: Parse portal.yaml into structured data'
    aspects:
      - "~yaml-config-loading"
    flows:
      - $portal-validation-flow
    signals:
      - '!parse-success'
      - '!parse-error'
    components:
      - '#yaml-parser'
      - '#gate-schemas'
  portal-validation:
    description: '@portal-validation: Validate portal.yaml configuration'
    signals:
      - '!validation-passed'
      - '!validation-failed'
    components:
      - '#validator'
      - '#topology-checker'
    aspects:
      - "~file-glob-discovery"
components:
  yaml-parser:
    description: '#yaml-parser: Parses YAML content from portal.yaml'
    type: utility
  gate-schemas:
    description: '#gate-schemas: Zod schemas for GateConfig, Gate, Lock, Key'
    type: schema
  validator:
    description: '#validator: Validates gate configuration'
    type: utility
  topology-checker:
    description: '#topology-checker: Checks for circular dependencies in gates'
    type: utility
signals:
  parse-success:
    description: '!parse-success: portal.yaml parsed successfully'
    category: portal
    severity: info
  parse-error:
    description: '!parse-error: Failed to parse portal.yaml'
    category: portal
    severity: error
  validation-passed:
    description: '!validation-passed: Portal validation passed'
    category: portal
    severity: info
  validation-failed:
    description: '!validation-failed: Portal validation found issues'
    category: portal
    severity: warn
aspects:
  ~portal-yaml-version-required:
    description: Gate config must have a "version" field; parsing throws if missing
    category: invariant
    severity: critical
    tags: [validation, parsing]
    anchors:
      - src/parser.ts:43-45
    applies-to:
      - "#yaml-parser"

  ~gate-id-kebab-case:
    description: Gate, lock, and prize IDs must match kebab-case pattern /^[a-z][a-z0-9-]*$/
    category: rule
    severity: medium
    tags: [validation, naming]
    anchors:
      - src/validator.ts:56-62
      - src/validator.ts:84-90
      - src/validator.ts:119-125
    applies-to:
      - "#validator"

  ~lock-mode-default-all:
    description: Lock mode defaults to "all" when not specified; only "all" and "any" are valid
    category: decision
    severity: medium
    tags: [parsing, evaluation]
    anchors:
      - src/parser.ts:169
      - src/validator.ts:157-163
    applies-to:
      - "#yaml-parser"

  ~portal-glob-ignore-patterns:
    description: "findGateFiles ignores node_modules, dist, and .git directories"
    category: configuration
    severity: low
    tags: [discovery, glob]
    anchors:
      - src/parser.ts:284-288
    applies-to:
      - "#yaml-parser"

  ~portal-dev-ports-marathon:
    description: Default dev ports are 42195 (visualizer, marathon 42.195km) and 42196 (watcher)
    category: configuration
    severity: low
    tags: [dev, configuration]
    anchors:
      - src/parser.ts:22-26
    applies-to:
      - "#yaml-parser"

  ~gates-portals-key-alias:
    description: "Parser supports both 'gates' and legacy 'portals' keys for backward compatibility"
    category: decision
    severity: low
    tags: [parsing, backward-compatibility]
    anchors:
      - src/parser.ts:48-55
    applies-to:
      - "#yaml-parser"

  ~lock-requires-keys:
    description: A lock with zero keys is a validation error (can never be opened)
    category: invariant
    severity: high
    tags: [validation]
    anchors:
      - src/validator.ts:128-134
    applies-to:
      - "#validator"

  ~flow-gates-must-exist:
    description: Flow gate references must point to declared gate IDs; unknown refs are errors
    category: invariant
    severity: high
    tags: [validation, referential-integrity]
    anchors:
      - src/validator.ts:182-189
    applies-to:
      - "#topology-checker"

  ~strict-equality-warning:
    description: "Key expressions using == instead of === emit a warning suggesting strict equality"
    category: rule
    severity: low
    tags: [validation, best-practice]
    anchors:
      - src/validator.ts:147-153
    applies-to:
      - "#validator"

flows:
  portal-validation-flow:
    description: Validate portal.yaml gate configuration and route compliance
    signals:
      - '!validation-passed'
      - '!validation-failed'
    steps:
      - component: '#yaml-parser'
        action: Find and parse portal.yaml via glob
      - component: '#gate-schemas'
        action: Validate gate definitions against Zod schemas
      - component: '#topology-checker'
        action: Check for circular dependencies in gate requires
      - component: '#validator'
        action: Validate routes reference declared gates
      - component: '#validator'
        action: Report issues and compliance status
