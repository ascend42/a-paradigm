version: 1.0.0
description: |
  @a-company/portal-viewer - Real-time visualization of authorization flows.
  WebSocket-based viewer showing gate decisions, sessions, and timelines.
features:
  realtime-visualization:
    description: '@realtime-visualization: Live view of authorization decisions'
    signals:
      - '!decision-received'
      - '!session-started'
    components:
      - '#websocket-server'
      - '#event-stream'
  session-management:
    description: '@session-management: Track entity journeys through gates'
    states:
      - '%session.active'
      - '%session.entity'
    components:
      - '#session-tracker'
      - '#journey-recorder'
  event-timeline:
    description: '@event-timeline: Chronological view of gate events'
    components:
      - '#timeline-component'
      - '#event-renderer'
  test-checklist:
    description: '@test-checklist: Visual checklist for testing gates'
    components:
      - '#checklist-component'
      - '#test-runner'
  command-palette:
    description: '@command-palette: Contextual CLI command suggestions'
    components:
      - '#palette-component'
      - '#command-generator'
components:
  websocket-server:
    description: '#websocket-server: WebSocket server for real-time events'
  event-stream:
    description: '#event-stream: Streams gate events to clients'
  session-tracker:
    description: '#session-tracker: Tracks active sessions'
  journey-recorder:
    description: '#journey-recorder: Records entity paths through gates'
  timeline-component:
    description: '#timeline-component: React component for event timeline'
  event-renderer:
    description: '#event-renderer: Renders individual timeline events'
  checklist-component:
    description: '#checklist-component: React component for test checklist'
  test-runner:
    description: '#test-runner: Executes gate tests'
  palette-component:
    description: '#palette-component: React component for command palette'
  command-generator:
    description: '#command-generator: Generates contextual CLI commands'
states:
  session: {}
signals:
  decision-received:
    description: '!decision-received: Gate decision event received'
    category: viewer
    severity: info
  session-started:
    description: '!session-started: New session tracking started'
    category: viewer
    severity: info
