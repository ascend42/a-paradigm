version: 2.0.0
description: |
  @a-company/portal-viewer - Real-time visualization of authorization flows.
  WebSocket-based viewer showing gate decisions, sessions, and timelines.
features:
  realtime-visualization:
    description: '@realtime-visualization: Live view of authorization decisions'
    signals:
      - '!decision-received'
      - '!session-started'
    components:
      - '#websocket-server'
      - '#event-stream'
  session-management:
    description: '@session-management: Track entity journeys through gates'
    states:
      - '%session.active'
      - '%session.entity'
    components:
      - '#session-tracker'
      - '#journey-recorder'
  event-timeline:
    description: '@event-timeline: Chronological view of gate events'
    components:
      - '#timeline-component'
      - '#event-renderer'
  test-checklist:
    description: '@test-checklist: Visual checklist for testing gates'
    components:
      - '#checklist-component'
      - '#test-runner'
  command-palette:
    description: '@command-palette: Contextual CLI command suggestions'
    components:
      - '#palette-component'
      - '#command-generator'
components:
  websocket-server:
    description: '#websocket-server: WebSocket server for real-time events'
    type: service
  event-stream:
    description: '#event-stream: Streams gate events to clients'
    type: service
  session-tracker:
    description: '#session-tracker: Tracks active sessions'
    type: service
  journey-recorder:
    description: '#journey-recorder: Records entity paths through gates'
    type: service
  timeline-component:
    description: '#timeline-component: React component for event timeline'
    type: view
  event-renderer:
    description: '#event-renderer: Renders individual timeline events'
    type: view
  checklist-component:
    description: '#checklist-component: React component for test checklist'
    type: view
  test-runner:
    description: '#test-runner: Executes gate tests'
    type: tool
  palette-component:
    description: '#palette-component: React component for command palette'
    type: view
  command-generator:
    description: '#command-generator: Generates contextual CLI commands'
    type: utility
aspects:
  ~viewer-ws-port-42196:
    description: WebSocket server defaults to port 42196 (marathon + 1); UI defaults to 42195
    category: configuration
    severity: low
    tags: [ports, websocket]
    anchors:
      - src/server.ts:44-45
    applies-to:
      - "#websocket-server"

  ~viewer-cors-wildcard:
    description: "API responses set Access-Control-Allow-Origin: * for cross-origin access"
    category: decision
    severity: medium
    tags: [cors, security]
    anchors:
      - src/server.ts:369
    applies-to:
      - "#websocket-server"

  ~viewer-sdk-ui-client-routing:
    description: "WebSocket clients are routed to SDK or UI handler based on URL path (/ui prefix)"
    category: rule
    severity: medium
    tags: [websocket, routing]
    anchors:
      - src/server.ts:113-121
    applies-to:
      - "#websocket-server"

states:
  session: {}
signals:
  decision-received:
    description: '!decision-received: Gate decision event received'
    category: viewer
    severity: info
  session-started:
    description: '!session-started: New session tracking started'
    category: viewer
    severity: info
