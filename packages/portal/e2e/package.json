{
  "name": "@a-company/portal-e2e",
  "version": "3.5.0",
  "description": "Portal validation utilities for AI-agent driven E2E testing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "keywords": [
    "portal",
    "e2e",
    "validation",
    "authorization",
    "paradigm",
    "ai-agent"
  ],
  "license": "MIT"
}
