# Paradigm Sentinel - Symbolic Incident Triage
# Version: 2.0 (Symbol System v2)

description: |
  Sentinel provides semantic incident recording, pattern matching, and failure triage.
  It uses Paradigm symbols to contextualize errors and suggest resolutions based on
  learned patterns.

# ============================================
# Components (#)
# ============================================

#IncidentStorage:
  description: SQLite-based storage for incidents, patterns, and resolutions
  tags: [feature, persistence]
  anchors:
    - src/storage.ts:1-500
  signals:
    - !incident-recorded
    - !incident-resolved

#PatternMatcher:
  description: Matches incoming incidents to known failure patterns using symbolic criteria
  tags: [feature, ml]
  anchors:
    - src/matcher.ts:1-200
  signals:
    - !pattern-matched
    - !pattern-confidence-updated

#IncidentEnricher:
  description: Enriches incidents with symbol descriptions and context from the project index
  tags: [feature]
  anchors:
    - src/enricher.ts:1-150

#IncidentGrouper:
  description: Groups similar incidents by common symbols and error patterns
  tags: [feature]
  anchors:
    - src/grouper.ts:1-250

#StatisticsEngine:
  description: Calculates incident statistics, pattern effectiveness, and symbol health metrics
  tags: [feature, analytics]
  anchors:
    - src/stats.ts:1-300

#PatternSuggester:
  description: Suggests new patterns from clustered incidents for human review
  tags: [feature, ml]
  anchors:
    - src/suggester.ts:1-350
  signals:
    - !pattern-suggested

#TimelineBuilder:
  description: Builds flow timelines showing gate/signal sequence leading to failure
  tags: [feature]
  anchors:
    - src/timeline.ts:1-150

#SentinelServer:
  description: Express server exposing REST API for incident and pattern management
  tags: [feature, api]
  aspects: ["~express-server"]
  anchors:
    - src/server/index.ts:1-100
  gates:
    - ^api-authenticated

#SentinelUI:
  description: React application for visualizing incidents, patterns, and codebase symbols
  tags: [feature, ui]
  anchors:
    - ui/src/App.tsx:1-150
  components:
    - #CanvasView
    - #GridView
    - #ListView
    - #PropertiesPanel

#CanvasView:
  description: Interactive canvas for dragging and connecting symbol nodes
  tags: [ui]
  anchors:
    - ui/src/components/Canvas/Canvas.tsx:1-100

#GridView:
  description: Column-based view grouping symbols by type
  tags: [ui]
  anchors:
    - ui/src/components/Views/GridView.tsx:1-130

#ListView:
  description: Sortable table view of all symbols
  tags: [ui]
  anchors:
    - ui/src/components/Views/ListView.tsx:1-130

#PropertiesPanel:
  description: Side panel for editing symbol properties, tags, and viewing references
  tags: [ui]
  anchors:
    - ui/src/components/Panel/PropertiesPanel.tsx:1-350

#sentinel-sdk:
  description: Unified Sentinel SDK — TypeScript client for sending structured logs, metrics, and traces to Sentinel with batching, ring buffer, auto-retry, and graceful degradation. See also #SentinelRustClient in sentinel-rs for the Rust variant.
  tags: [feature, sdk]
  components:
    - '#SentinelClient'

#SentinelClient:
  description: Lightweight JS/TS client SDK for sending structured logs, metrics, and traces to the Sentinel server with batching, ring buffer, auto-retry, and graceful degradation
  tags: [sdk, client]
  anchors:
    - src/client.ts:1-350
  endpoints:
    - POST /api/logs
    - POST /api/metrics
    - POST /api/traces
    - POST /api/services
    - POST /api/state

#NodesStore:
  description: Zustand store managing symbol nodes, filters, and layout state
  tags: [state]
  anchors:
    - ui/src/store/nodesStore.ts:1-420

#SchemaRegistry:
  description: Schema-driven event registry — applications register event schemas, Sentinel ingests/stores/queries any structured event data
  tags: [feature, observability]
  anchors:
    - src/schema/types.ts:1-50
    - src/storage.ts:2545-2620
  signals:
    - !schema-registered

#EventsStore:
  description: Generic event storage with scope-aware querying, causality tracking, and batch ingestion
  tags: [feature, persistence]
  anchors:
    - src/storage.ts:2620-2850
  endpoints:
    - POST /api/events
    - GET /api/events
    - GET /api/events/scopes
    - GET /api/events/scope/:value

#EventsView:
  description: Schema-adaptive event viewer with scope navigation, category filters, and real-time WebSocket updates
  tags: [feature, ui]
  anchors:
    - ui/src/views/EventsView.tsx:1-300
  components:
    - '#SchemaSelector'
    - '#ScopeNavigator'
    - '#CategoryFilters'
    - '#EventTable'

#BuiltinParadigmSchema:
  description: Built-in schema declaration for Paradigm's existing log/metric/trace types (informational)
  tags: [feature, builtin]
  anchors:
    - src/schema/builtin-paradigm.ts:1-150

# ============================================
# Flows ($)
# ============================================

$incident-triage:
  description: Complete flow from incident recording to resolution suggestion
  tags: [critical]
  steps:
    - "#IncidentStorage"      # Record incident
    - "#PatternMatcher"       # Match to known patterns
    - "#IncidentEnricher"     # Add symbol context
    - "#IncidentGrouper"      # Group with similar
    - "#PatternSuggester"     # Suggest new patterns
  on-failure:
    - "!triage-failed"

$pattern-lifecycle:
  description: Pattern creation through confidence validation
  steps:
    - "Create pattern from suggestion or manual input"
    - "#PatternMatcher"       # Start matching
    - "!pattern-matched"      # Track matches
    - "#StatisticsEngine"     # Calculate confidence
    - "!pattern-confidence-updated"

$resolution-flow:
  description: Incident investigation and resolution tracking
  steps:
    - "Investigate incident"
    - "Apply fix"
    - "#IncidentStorage"      # Mark resolved
    - "!incident-resolved"
    - "Track for recurrence"

# ============================================
# Gates (^)
# ============================================

^api-authenticated:
  description: API requests require authentication when auth is configured
  tags: [security]
  anchors:
    - src/server/index.ts:50-70
  check: |
    If SENTINEL_API_KEY is set, requests must include
    Authorization: Bearer <key> header

# ============================================
# Signals (!)
# ============================================

!incident-recorded:
  description: Emitted when a new incident is recorded in storage
  tags: [audit]
  payload:
    incidentId: string
    timestamp: ISO8601
    symbols: object

!pattern-matched:
  description: Emitted when an incident matches a known failure pattern
  payload:
    incidentId: string
    patternId: string
    confidence: number

!incident-resolved:
  description: Emitted when an incident is marked as resolved
  tags: [audit]
  payload:
    incidentId: string
    patternId: string?
    commitHash: string?

!pattern-confidence-updated:
  description: Emitted when pattern confidence score is recalculated
  payload:
    patternId: string
    oldScore: number
    newScore: number

!pattern-suggested:
  description: Emitted when AI suggests a new pattern from incident clusters
  payload:
    suggestion: object
    incidentCount: number

# ============================================
# Aspects (~)
# ============================================

~symbolic-context-required:
  description: All incidents MUST include at least one Paradigm symbol for triage to work
  tags: [compliance]
  anchors:
    - src/storage.ts:100-120
    - src/types.ts:28-36
  applies-to:
    - "#IncidentStorage"
  enforcement: |
    Incidents without symbolic context (feature, component, flow, gate, signal)
    cannot be effectively triaged. The SymbolicContext interface requires at
    least one symbol to be present.

~confidence-tracking:
  description: All pattern matches must update pattern confidence metrics
  tags: [compliance]
  anchors:
    - src/matcher.ts:150-180
    - src/stats.ts:200-250
  applies-to:
    - "#PatternMatcher"
  enforcement: |
    When a pattern matches an incident:
    1. Increment timesMatched
    2. Track resolution status
    3. Recalculate confidence score
    4. Emit !pattern-confidence-updated

# ── Storage Aspects ──────────────────────────────────────────────

~schema-version-5:
  description: SQLite schema is versioned at v5 with sequential migration support (v1->v2->v3->v4->v5). v5 adds schemas and events tables for schema-driven observability.
  category: invariant
  severity: critical
  tags: [persistence, migration]
  anchors:
    - src/storage.ts:49-49
    - src/storage.ts:377-570
  applies-to:
    - "#IncidentStorage"

~incident-id-format-inc-nnn:
  description: Incident IDs use sequential format INC-NNN (zero-padded to 3 digits), derived from an in-memory counter
  category: invariant
  severity: high
  tags: [persistence, identity]
  anchors:
    - src/storage.ts:293-294
  applies-to:
    - "#IncidentStorage"

~default-pattern-confidence-50:
  description: New patterns start with a default confidence score of 50, 0 matches, 0 resolved, 0 recurred
  category: configuration
  severity: medium
  tags: [pattern-matching]
  anchors:
    - src/storage.ts:52-57
  applies-to:
    - "#IncidentStorage"
    - "#PatternMatcher"

~confidence-score-adjustment-rules:
  description: Confidence score adjusts +2 on resolution (max 100), -5 on recurrence (min 10)
  category: rule
  severity: high
  tags: [pattern-matching, scoring]
  anchors:
    - src/storage.ts:893-922
  applies-to:
    - "#IncidentStorage"
    - "#PatternMatcher"

~sqlite-write-after-mutation:
  description: Every mutation (insert, update, delete) calls save() to persist the in-memory SQLite database to disk
  category: invariant
  severity: critical
  tags: [persistence, durability]
  anchors:
    - src/storage.ts:277-282
    - src/storage.ts:330-331
  applies-to:
    - "#IncidentStorage"

~db-path-env-resolution:
  description: Database path resolved via SENTINEL_DATA_DIR, then PARADIGM_DATA_DIR, then .paradigm/sentinel/sentinel.db
  category: configuration
  severity: medium
  tags: [persistence, configuration]
  anchors:
    - src/storage.ts:71-78
  applies-to:
    - "#IncidentStorage"

~log-pruning-oldest-first:
  description: Log pruning deletes oldest entries first (ORDER BY timestamp ASC) when count exceeds maxLogs
  category: rule
  severity: medium
  tags: [persistence, retention]
  anchors:
    - src/storage.ts:1970-1987
  applies-to:
    - "#IncidentStorage"

~app-state-latest-wins:
  description: App state uses UPSERT (latest-wins) per service+session composite key
  category: decision
  severity: medium
  tags: [persistence, state]
  anchors:
    - src/storage.ts:209-217
    - src/storage.ts:2077-2098
  applies-to:
    - "#IncidentStorage"

~bidirectional-incident-linking:
  description: Linking incidents creates references in both directions automatically
  category: rule
  severity: low
  tags: [persistence, relationships]
  anchors:
    - src/storage.ts:689-712
  applies-to:
    - "#IncidentStorage"

# ── Matcher Aspects ──────────────────────────────────────────────

~match-score-cap-100:
  description: Pattern match scores are capped at 100 with weighted categories — symbols max 50, error text max 25, missing signals max 25
  category: constraint
  severity: high
  tags: [pattern-matching, scoring]
  anchors:
    - src/matcher.ts:114-153
  applies-to:
    - "#PatternMatcher"

~min-match-score-30:
  description: Default minimum match score threshold is 30; matches below this are discarded
  category: configuration
  severity: medium
  tags: [pattern-matching, scoring]
  anchors:
    - src/matcher.ts:20-24
  applies-to:
    - "#PatternMatcher"

~max-match-results-5:
  description: Pattern matcher returns at most 5 results by default, sorted by confidence descending
  category: configuration
  severity: low
  tags: [pattern-matching]
  anchors:
    - src/matcher.ts:20-24
    - src/matcher.ts:72-76
  applies-to:
    - "#PatternMatcher"

~confidence-boost-formula:
  description: When boostConfidence is enabled, final confidence = score * (0.5 + 0.5 * patternConfidence/100)
  category: rule
  severity: medium
  tags: [pattern-matching, scoring]
  anchors:
    - src/matcher.ts:53-58
  applies-to:
    - "#PatternMatcher"

~wildcard-symbol-matching:
  description: Symbol matching supports wildcards — prefix (foo*), suffix (*bar), interior (foo*bar), and universal (*)
  category: rule
  severity: medium
  tags: [pattern-matching]
  anchors:
    - src/matcher.ts:206-233
  applies-to:
    - "#PatternMatcher"

~symbol-score-exact-10-wildcard-5-array-7:
  description: Symbol matching scoring — exact match = 10pts, wildcard match = 5pts, array-any match = 7pts
  category: rule
  severity: medium
  tags: [pattern-matching, scoring]
  anchors:
    - src/matcher.ts:182-201
  applies-to:
    - "#PatternMatcher"

~environment-filter-precheck:
  description: Patterns with environment filters are skipped before scoring if incident environment does not match
  category: rule
  severity: medium
  tags: [pattern-matching]
  anchors:
    - src/matcher.ts:44-48
    - src/matcher.ts:313-325
  applies-to:
    - "#PatternMatcher"

# ── Grouper Aspects ──────────────────────────────────────────────

~similarity-threshold-0-6:
  description: Default similarity threshold for incident grouping is 0.6 (60%)
  category: configuration
  severity: medium
  tags: [grouping, clustering]
  anchors:
    - src/grouper.ts:14-15
  applies-to:
    - "#IncidentGrouper"

~time-decay-half-life-14d:
  description: Time-decay half-life for similarity scoring is 14 days — older incidents contribute exponentially less
  category: configuration
  severity: medium
  tags: [grouping, clustering]
  anchors:
    - src/grouper.ts:18-18
    - src/grouper.ts:244-250
  applies-to:
    - "#IncidentGrouper"

~similarity-weights-with-stack:
  description: Similarity weights vary by stack availability — with stacks (symbol 0.45, error 0.25, env 0.1, stack 0.2), without stacks (symbol 0.6, error 0.3, env 0.1)
  category: rule
  severity: medium
  tags: [grouping, scoring]
  anchors:
    - src/grouper.ts:189-193
  applies-to:
    - "#IncidentGrouper"

~stack-fingerprint-top-10-frames:
  description: Stack trace fingerprinting normalizes and compares only the top 10 frames, stripping line numbers, column numbers, and absolute paths
  category: rule
  severity: low
  tags: [grouping, clustering]
  anchors:
    - src/grouper.ts:258-270
  applies-to:
    - "#IncidentGrouper"

~group-join-threshold-50pct:
  description: An incident joins an existing group if it matches >= 50% of common symbols OR any common error pattern
  category: rule
  severity: medium
  tags: [grouping]
  anchors:
    - src/grouper.ts:340-372
  applies-to:
    - "#IncidentGrouper"

~common-error-pattern-60pct-majority:
  description: Error words appearing in >= 60% of grouped incidents are extracted as common patterns (max 5 words)
  category: rule
  severity: low
  tags: [grouping, text-analysis]
  anchors:
    - src/grouper.ts:444-451
  applies-to:
    - "#IncidentGrouper"

~auto-group-min-size-3:
  description: Automatic grouping (analyzeAndGroup) requires a minimum cluster size of 3 incidents by default
  category: configuration
  severity: low
  tags: [grouping]
  anchors:
    - src/grouper.ts:124-125
  applies-to:
    - "#IncidentGrouper"

# ── Suggester Aspects ────────────────────────────────────────────

~pattern-candidate-min-occurrences-3:
  description: Pattern candidate discovery requires at least 3 resolved incidents with the same symbol signature
  category: configuration
  severity: low
  tags: [pattern-suggestion]
  anchors:
    - src/suggester.ts:101-101
  applies-to:
    - "#PatternSuggester"

~priority-from-count-thresholds:
  description: Auto-suggested pattern priority is derived from occurrence count — >=20 critical, >=10 high, >=5 medium, else low
  category: rule
  severity: low
  tags: [pattern-suggestion, priority]
  anchors:
    - src/suggester.ts:551-558
  applies-to:
    - "#PatternSuggester"

~strategy-inference-keyword-heuristics:
  description: Resolution strategy is inferred from error message keywords using ordered heuristic rules (rollback, config-change, scale-up, retry, fallback, fix-data, escalate, investigate, fix-code)
  category: decision
  severity: medium
  tags: [pattern-suggestion, resolution]
  anchors:
    - src/suggester.ts:497-546
  applies-to:
    - "#PatternSuggester"

~duplicate-pattern-guard-2-symbol-match:
  description: Pattern suggestion is skipped if an existing pattern already matches >= 2 symbols of the candidate incident
  category: rule
  severity: medium
  tags: [pattern-suggestion]
  anchors:
    - src/suggester.ts:460-490
  applies-to:
    - "#PatternSuggester"

