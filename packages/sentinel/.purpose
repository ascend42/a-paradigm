# ── Client SDK Aspects ───────────────────────────────────────────

~client-default-url-localhost-3838:
  description: Client SDK defaults to http://localhost:3838 as the Sentinel server URL
  category: configuration
  severity: low
  tags: [client, sdk]
  anchors:
    - src/client.ts:65-65
  applies-to:
    - "#SentinelClient"

~client-batch-size-50:
