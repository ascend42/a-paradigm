    - "#SentinelClient"

~client-graceful-degradation:
  description: Client degrades gracefully — if fetch is unavailable, returns undefined; registration is fire-and-forget; close swallows errors
  category: decision
  severity: high
  tags: [client, sdk, resilience]
  anchors:
    - src/client.ts:451-454
    - src/client.ts:346-349
    - src/client.ts:299-304
  applies-to:
    - "#SentinelClient"

~client-browser-beforeunload-flush:
  description: Client registers a beforeunload handler in browser environments to flush buffered entries using sendBeacon before page unload
  category: rule
  severity: medium
  tags: [client, sdk, browser]
  anchors:
    - src/client.ts:124-130
    - src/client.ts:315-331
  applies-to:
    - "#SentinelClient"

~client-failed-send-restore-to-buffer:
  description: On send failure, unsent log/metric entries are restored to the front of the buffer (up to maxBufferSize), excess entries trigger onDrop
  category: rule
  severity: high
  tags: [client, sdk, resilience]
  anchors:
    - src/client.ts:404-421
    - src/client.ts:425-443
  applies-to:
    - "#SentinelClient"

# ── Config Aspects ───────────────────────────────────────────────

~config-resolution-order:
  description: Server config resolution order — env vars override local .sentinel.yaml which overrides global ~/.paradigm/sentinel.yaml which overrides defaults
  category: decision
