{
  "name": "@a-company/sentinel",
  "version": "0.1.1",
  "description": "Unified codebase intelligence: symbol visualization and semantic observability for Paradigm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "src/seeds",
    "ui/dist"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "tsup src/index.ts src/server/index.ts --format esm --dts --clean",
    "build:ui": "cd ui && npm run build",
    "dev": "tsup src/index.ts src/server/index.ts --format esm --dts --watch",
    "dev:ui": "cd ui && npm run dev",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "open": "^10.0.0",
    "simple-git": "^3.22.0",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "zustand": "^4.4.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git",
    "directory": "packages/sentinel"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-paradigm/issues"
  },
  "homepage": "https://github.com/ascend42/a-paradigm#readme",
  "keywords": [
    "paradigm",
    "sentinel",
    "visualizer",
    "observability",
    "error-tracking",
    "patterns",
    "codebase-intelligence"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
