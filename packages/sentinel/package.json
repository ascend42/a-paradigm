{
  "name": "@a-company/sentinel",
  "version": "0.3.0",
  "description": "Semantic error monitoring — errors that speak your language",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sentinel": "./dist/cli.js",
    "sentinel-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js"
    }
  },
  "files": [
    "dist",
    "src/seeds",
    "ui/dist"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "tsup",
    "build:ui": "cd ui && npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "open": "^10.0.0",
    "simple-git": "^3.22.0",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0",
    "ws": "^8.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.0",
    "zustand": "^4.4.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git",
    "directory": "packages/sentinel"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-paradigm/issues"
  },
  "homepage": "https://github.com/ascend42/a-paradigm#readme",
  "keywords": [
    "sentinel",
    "error-monitoring",
    "observability",
    "error-tracking",
    "patterns",
    "semantic",
    "paradigm"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
