{
  "name": "@a-company/sentinel",
  "version": "0.1.0",
  "description": "Semantic observability and failure pattern matching for Paradigm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/seeds"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git",
    "directory": "packages/sentinel"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-paradigm/issues"
  },
  "homepage": "https://github.com/ascend42/a-paradigm#readme",
  "keywords": [
    "paradigm",
    "sentinel",
    "observability",
    "error-tracking",
    "patterns"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
