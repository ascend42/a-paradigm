version: 1.0.0
description: |
  @a-company/probe-core - Visual discovery layer for AI agents.
  Generates scan indexes for UI-to-code mapping via screenshots.
features:
  scan-index-generation:
    description: '@scan-index-generation: Generate scan-index.json for component mapping'
    signals:
      - '!index-generated'
    components:
      - '#generator'
      - '#component-scanner'
  probe-protocol:
    description: '@probe-protocol: Protocol for image-to-code queries'
    components:
      - '#protocol-handler'
      - '#matcher'
components:
  generator:
    description: '#generator: Generates scan-index.json'
  component-scanner:
    description: '#component-scanner: Scans for UI components'
  protocol-handler:
    description: '#protocol-handler: Handles probe protocol requests'
  matcher:
    description: '#matcher: Matches images to components'
signals:
  index-generated:
    description: '!index-generated: Scan index was generated'
    category: probe
    severity: info
