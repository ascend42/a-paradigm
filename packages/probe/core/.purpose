version: 1.0.0
description: |
  @a-company/probe-core - Visual discovery layer for AI agents.
  Generates scan indexes for UI-to-code mapping via screenshots.
features:
  scan-index-generation:
    description: '@scan-index-generation: Generate scan-index.json for component mapping'
    signals:
      - '!index-generated'
    components:
      - '#generator'
      - '#component-scanner'
  probe-protocol:
    description: '@probe-protocol: Protocol for image-to-code queries'
    components:
      - '#protocol-handler'
      - '#matcher'
components:
  generator:
    description: '#generator: Generates scan-index.json'
    type: service
  component-scanner:
    description: '#component-scanner: Scans for UI components'
    type: service
  protocol-handler:
    description: '#protocol-handler: Handles probe protocol requests'
    type: service
  matcher:
    description: '#matcher: Matches images to components'
    type: utility
aspects:
  ~visual-tag-inference-patterns:
    description: Component names are matched against 30+ regex patterns (button, form, modal, nav, etc.) to infer visual tags for image-to-code mapping
    category: rule
    severity: medium
    tags: [visual-tags, inference]
    anchors:
      - src/generator.ts:365-408
    applies-to:
      - "#component-scanner"

  ~scan-index-schema-version-1-0-0:
    description: "Scan index $meta.version is always '1.0.0'; tracked separately from paradigmVersion"
    category: configuration
    severity: low
    tags: [versioning, schema]
    anchors:
      - src/generator.ts:20
      - src/generator.ts:108
    applies-to:
      - "#generator"

signals:
  index-generated:
    description: '!index-generated: Scan index was generated'
    category: probe
    severity: info
