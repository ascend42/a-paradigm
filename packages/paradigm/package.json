{
  "name": "@a-company/paradigm",
  "version": "8.0.2",
  "description": "Unified CLI for Paradigm developer tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paradigm": "./dist/index.js",
    "paradigm-mcp": "./dist/mcp.js",
    "sentinel": "./dist/sentinel.js",
    "sentinel-mcp": "./dist/sentinel-mcp.js",
    "gnomon": "./bin/gnomon.js"
  },
  "files": [
    "dist",
    "templates",
    "platform-ui/dist",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/generate-hooks.mjs && tsup && npm run build:platform-ui && npm run build:sentinel-assets",
    "build:sentinel-assets": "rm -rf dist/sentinel-ui && cp -r ../sentinel/ui/dist dist/sentinel-ui",
    "check:hooks": "node scripts/generate-hooks.mjs --check",
    "build:platform-ui": "cd platform-ui && npx vite build",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/commands/",
    "sync:readme": "node scripts/sync-readme.mjs",
    "check:readme": "node scripts/sync-readme.mjs --check",
    "prepack": "node scripts/sync-readme.mjs",
    "prepublishOnly": "node scripts/check-gnomon-published.mjs && npm run build"
  },
  "dependencies": {
    "@a-company/gnomon": "8.0.2",
    "@a-company/portal-core": "*",
    "@a-company/premise-core": "*",
    "@a-company/university-core": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^5.2.1",
    "glob": "^13.0.0",
    "js-yaml": "^4.1.0",
    "open": "^10.0.3",
    "ora": "^8.0.1",
    "prompts": "^2.4.2",
    "simple-git": "^4.0.2",
    "sql.js": "^1.10.3",
    "ws": "^8.19.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@a-company/warpline": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git",
    "directory": "packages/paradigm"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-paradigm/issues"
  },
  "homepage": "https://github.com/ascend42/a-paradigm#readme",
  "keywords": [
    "paradigm",
    "cli",
    "developer-tools",
    "ai-context",
    "mcp",
    "documentation"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
