{
  "name": "@a-company/paradigm",
  "version": "3.22.0",
  "description": "Unified CLI for Paradigm developer tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paradigm": "./dist/index.js",
    "paradigm-mcp": "./dist/mcp.js",
    "sentinel": "./dist/sentinel.js",
    "sentinel-mcp": "./dist/sentinel-mcp.js"
  },
  "files": [
    "dist",
    "templates",
    "lore-ui/dist",
    "graph-ui/dist"
  ],
  "scripts": {
    "build": "node scripts/generate-hooks.mjs && tsup && npm run build:sentinel-assets && npm run build:university-assets",
    "build:sentinel-assets": "rm -rf dist/sentinel-ui && cp -r ../sentinel/ui/dist dist/sentinel-ui",
    "check:hooks": "node scripts/generate-hooks.mjs --check",
    "build:lore-ui": "cd lore-ui && npx vite build",
    "build:graph-ui": "cd graph-ui && npx vite build",
    "build:university-assets": "rm -rf dist/university-ui dist/university-content && cp -r ../university/ui/dist dist/university-ui && cp -r ../university/src/content dist/university-content",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^5.2.1",
    "glob": "^13.0.0",
    "js-yaml": "^4.1.0",
    "open": "^10.0.3",
    "ora": "^8.0.1",
    "prompts": "^2.4.2",
    "simple-git": "^3.22.0",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0",
    "ws": "^8.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git",
    "directory": "packages/paradigm"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-paradigm/issues"
  },
  "homepage": "https://github.com/ascend42/a-paradigm#readme",
  "keywords": [
    "paradigm",
    "cli",
    "developer-tools",
    "ai-context",
    "mcp",
    "documentation"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
