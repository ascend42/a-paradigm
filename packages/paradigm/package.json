{
  "name": "@a-company/paradigm",
  "version": "0.7.0",
  "description": "Unified CLI for Paradigm developer tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paradigm": "./dist/index.js"
  },
  "files": [
    "dist",
    "visualizer-dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/bundle-visualizer.js",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@a-company/premise-core": "*",
    "@a-company/portal-core": "*",
    "@a-company/portal-manager": "*",
    "@a-company/portal-sdk": "*",
    "@a-company/purpose-core": "*",
    "@a-company/probe-core": "*",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "open": "^10.0.3",
    "ora": "^8.0.1",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-horizon.git",
    "directory": "packages/paradigm"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-horizon/issues"
  },
  "homepage": "https://github.com/ascend42/a-horizon#readme",
  "keywords": [
    "paradigm",
    "cli",
    "developer-tools",
    "ai-context",
    "documentation",
    "visualization"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
