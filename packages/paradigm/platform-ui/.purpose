version: 2.0.0
description: Paradigm Platform SPA — unified React UI shell with sidebar navigation, absorbing lore-ui and graph-ui as sections
components:
  PlatformShell:
    description: App shell with sidebar nav, header, and section router
    type: view
    tags: [feature, ui]
  SidebarNav:
    description: Section navigation sidebar with icons and labels
    type: view
  PlatformHeader:
    description: Top header bar with project name and section indicator
    type: view
  OverviewSection:
    description: Full project health dashboard — 6 stat cards, 5 health bars, merged activity feed from git commits and lore entries
    type: view
    tags: [feature, dashboard]
  OverviewStore:
    description: Zustand store fetching /api/platform/overview aggregation
    type: store
    tags: [state, dashboard]
  GitSection:
    description: Full git management — branch bar, file list with stage/unstage, diff viewer, commit composer with symbol autocomplete, paginated commit log
    type: view
    tags: [feature, git]
  GitStore:
    description: Zustand store for git status, branches, log, diff, staging, commit, push operations
    type: store
    tags: [state, git]
  LoreSection:
    description: Absorbed lore-ui — timeline, session, symbol, and author views
    type: view
  GraphSection:
    description: Absorbed graph-ui — React Flow canvas with symbol nodes
    type: view
  AgentToast:
    description: Toast notification component for agent-driven annotations
    type: view
    tags: [feature, agent-ui]
  AgentCallout:
    description: Floating callout and navigation prompt for agent-driven UI
    type: view
    tags: [feature, agent-ui]
  AgentStore:
    description: Zustand store for agent presence, highlights, annotations, toasts, and mute state
    type: store
    tags: [feature, agent-ui, state]
  SentinelSection:
    description: Live observability dashboard with 4 sub-tabs — Logs, Incidents, Events, Flows
    type: view
    tags: [feature, sentinel, observability]
  SentinelLogsStore:
    description: Zustand store for structured log data with exclusion filters and WS message handling
    type: store
    tags: [state, sentinel]
  SentinelIncidentsStore:
    description: Zustand store for incident triage with status filtering and resolution
    type: store
    tags: [state, sentinel]
  SentinelEventsStore:
    description: Zustand store for generic schema-driven events with scope navigation
    type: store
    tags: [state, sentinel]
  SentinelSchemasStore:
    description: Zustand store for event schema registry
    type: store
    tags: [state, sentinel]
  LogsTab:
    description: Real-time log viewer with resizable columns, context menu exclusions, and live streaming
    type: view
    parent: '#SentinelSection'
    tags: [feature, sentinel]
  IncidentsTab:
    description: Incident list with status filtering and detail panel
    type: view
    parent: '#SentinelSection'
    tags: [feature, sentinel]
  EventsTab:
    description: Schema-adaptive event viewer with scope navigation and category filters
    type: view
    parent: '#SentinelSection'
    tags: [feature, sentinel]
  FlowsTab:
    description: Flow definition cards with live activity indicators and flow composer
    type: view
    parent: '#SentinelSection'
    tags: [feature, sentinel]
  SymphonySection:
    description: Live agent-to-agent communication dashboard with 3 sub-tabs — Threads, Network, Files
    type: view
    tags: [feature, symphony]
  SymphonyStore:
    description: Zustand store for agents, threads, messages, file requests, and network status
    type: store
    tags: [state, symphony]
  ThreadsTab:
    description: Two-panel thread browser — sidebar with status filter, conversation view with messages and compose box
    type: view
    parent: '#SymphonySection'
    tags: [feature, symphony]
  NetworkTab:
    description: Agent grid with awake/asleep status indicators and network stats
    type: view
    parent: '#SymphonySection'
    tags: [feature, symphony]
  FilesTab:
    description: File request list with approve/deny/redact actions
    type: view
    parent: '#SymphonySection'
    tags: [feature, symphony]
  ClassroomSection:
    description: The Academy — wave-1 READ-ONLY gated-learning view. Fetches /api/classroom/status on mount; if !bootstrapped renders the Bootstrap Doorway empty-state ("never been to class" + the honesty line, nothing green), else the Term Board — a hero with the ghosted-denominator repeat-failure bar (null-safe: 0 resolved → all-ghost track + "no settled exams yet" caption) and three lifecycle columns (Staged from /staged, On Trial = pending certs, Settled = resolved certs from /certifications) with GATED/LEGACY badges from the cert loop + SURVIVED/OVERTURNED/PENDING outcome badges. Local component state (no store); resilient to empty data.
    type: view
    tags: [feature, classroom, academy, read-only]
