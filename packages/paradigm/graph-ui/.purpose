version: 2.0.0
description: |
  Interactive Symbol Graph UI — a React + xyflow canvas for visualizing
  Paradigm symbol relationships. Drag-and-drop node positioning, grouping,
  save/load persistence, and PNG/JSON export.

components:
  graph-ui:
    description: React app with xyflow for rendering symbol nodes, edges, and groups
    tags: [feature, visualization]

  symbol-node:
    description: Custom xyflow node component for rendering individual symbols with category colors
    path: src/components/SymbolNode.tsx

  group-node:
    description: Custom xyflow node for grouping related symbols
    path: src/components/GroupNode.tsx

  symbol-panel:
    description: Side panel showing symbol details and relationships
    path: src/components/SymbolPanel.tsx

  toolbar:
    description: Top toolbar with graph name, save/load, export controls
    path: src/components/Toolbar.tsx

  canvas:
    description: Main xyflow canvas with node rendering and interaction handlers
    path: src/components/Canvas.tsx

  graph-store:
    description: Zustand store managing graph state, node/edge CRUD, and API integration
    path: src/components/graphStore.ts

  export-dialog:
    description: Dialog for exporting graph as PNG image or JSON file
    path: src/components/ExportDialog.tsx

  load-dialog:
    description: Dialog for loading saved graph states
    path: src/components/LoadDialog.tsx
