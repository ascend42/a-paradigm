version: 2.0.0
description: |
  Agent provider implementations. Each provider knows how to spawn an AI agent
  and collect its results. Providers are tried in cascade order until one is available.

components:
  claude-provider:
    description: "Anthropic API direct — requires ANTHROPIC_API_KEY environment variable. Offers the model read_file, write_file, search_files and run_command (claude-tools.ts). Every model-supplied path and the run_command cwd must resolve by realpath inside the run's workingDirectory (resolveContained, symlinks that lead out refused). run_command is offered and run only as ^command-execution-consent allows, and every call (command, cwd, exit code, timestamp, refusals too; never env values) is appended to ~/.paradigm/logs/<project-hash>/agent-commands.jsonl (0600, O_NOFOLLOW, command cut to 4 KB with its full length). Refuses to start when the working directory is /, the home folder or above it (unsafeRunRoot). Whether run_command is offered is snapshotted at run start; a later flip of the setting cannot enable it."
    type: service
    path: claude.ts
    files: [claude.ts, claude-tools.ts]
    aspects: ["~provider-cascade", "~agent-tools-confined"]
    gates: ["^command-execution-consent"]

  write-guard:
    description: "write_file deny-list for the Anthropic API provider. Protects the OFF state and the time before consent; bounds nothing once run_command is ON. Checks the requested and the resolved path (lexical containment, then realpath of the longest existing prefix); segments NFC + lowercase + trailing dots/spaces stripped; refuses ':' segments, new 8.3-style '~N' segments, empty segments, existing symlink or nlink>1 targets. Denies .git/.hg/.svn at any depth (files too), the gitdir a root .git file points to, root .claude .mcp.json .cursor .vscode .idea .devcontainer .husky .githooks .pre-commit-config.yaml lefthook .github .gitlab-ci.yml .circleci .buildkite azure-pipelines.yml Jenkinsfile .envrc mise .npmrc .yarnrc and all of .paradigm, plus absolute ~/.paradigm, ~/.claude and the command log. package.json: install-time scripts may not be added or changed; other edits allowed and listed. portal.yaml, CLAUDE.md, .gitmodules, .gitattributes allowed and listed in the run summary (AgentMessage.reviewWrites on done). writeChecked opens with O_NOFOLLOW and checks nlink before truncating."
    type: service
    path: write-guard.ts
    gates: ["^command-execution-consent"]

  command-consent:
    description: "Decides whether run_command is offered and allowed for an API-run agent. Order: --allow-commands / --no-allow-commands for one run (never saved); then agent-provider.allow-commands in ~/.paradigm/config.yaml (home from os.userInfo, not $HOME; per user only, never the project config; ignored if it resolves inside the run root, is owned by another uid, or is group/world-writable; saved atomically, 0600); then, when undecided, an interactive terminal is asked once on the first call ('Paradigm agents can run shell commands on your machine with your permissions. Keep this on? [y/N]', on stderr) and the answer is saved, while background, orchestrated, MCP, piped and CI runs do not get the tool (pty automation counts as interactive). Parallel first calls share one question."
    type: service
    path: command-consent.ts
    gates: ["^command-execution-consent"]

  claude-code-provider:
    description: Claude Code Task tool — requires Max subscription
    type: service
    path: claude-code.ts
    aspects: ["~provider-cascade"]

  claude-code-teams-provider:
    description: Parallel agent execution via Claude Code teams (experimental)
    type: service
    path: claude-code-teams.ts
    aspects: ["~provider-cascade"]

  cursor-cli-provider:
    description: "Cursor agent CLI — auto-detected when running in Cursor IDE. `-p` (--print) is a boolean flag and the prompt is positional, so args end with `-p -- <prompt>` (after --model): a prompt starting with `-` is never read as an option."
    type: service
    path: cursor-cli.ts
    aspects: ["~provider-cascade"]

  claude-cli-provider:
    description: "Spawn claude CLI processes directly (argv, no shell). The prompt follows `-p --` so a prompt starting with `-` is never read as a flag."
    type: service
    path: claude-cli.ts
    aspects: ["~provider-cascade"]

  manual-provider:
    description: File-based handoffs — always available as ultimate fallback
    type: service
    path: manual.ts
    aspects: ["~provider-cascade"]

signals:
  provider-selected:
    description: A provider was selected from the cascade for agent spawning
    tags: [team]

  provider-unavailable:
    description: A provider was tried but not available, falling back to next
    tags: [team, warning]

aspects:
  ~agent-tools-confined:
    description: The Anthropic API provider's file tools and run_command cwd stay inside the run's working directory (realpath of the longest existing prefix, so symlinks are followed), and run_command needs ^command-execution-consent. The consent setting lives outside the working directory, so the agent cannot grant it to itself.
    category: invariant
    severity: high
    tags: [providers, security]
    anchors:
      - claude-tools.ts:1-1
      - command-consent.ts:1-1
    applies-to:
      - "#claude-provider"
      - "#command-consent"

  ~provider-api-key-requirements:
    description: Each provider has specific environment detection — claude requires ANTHROPIC_API_KEY, claude-code requires CLAUDE_CODE=1 or TERM_PROGRAM=claude, cursor-cli requires Cursor IDE environment, claude-cli checks claude command in PATH
    category: constraint
    severity: high
    tags: [providers, configuration]
    anchors:
      - claude.ts:1-1
      - claude-code.ts:1-1
      - cursor-cli.ts:1-1
      - claude-cli.ts:1-1
    applies-to:
      - "#claude-provider"
      - "#claude-code-provider"
      - "#cursor-cli-provider"
      - "#claude-cli-provider"

  ~manual-always-available-fallback:
    description: Manual provider is always available (isAvailable returns true unconditionally) and creates file-based handoff tasks in .paradigm/handoffs/ and .paradigm/tasks/ for human execution
    category: invariant
    severity: high
    tags: [providers, fallback]
    anchors:
      - manual.ts:54-57
      - manual.ts:62-160
    applies-to:
      - "#manual-provider"
