version: 2.0.0
description: |
  IDE adapter layer — generates IDE-specific instruction files from .paradigm/ configuration.
  Each adapter implements a shared interface from the base class, overriding detection and
  generation methods for its target IDE.

components:
  adapter-base:
    description: Shared generation helpers — symbol table, logger spec, navigation, context sections
    type: utility
    path: base.ts
    aspects: ["~ide-adapter-pattern"]

  cursor-adapter:
    description: Generate .cursor/rules/*.mdc files with frontmatter and rule sections
    type: service
    path: cursor.ts
    aspects: ["~ide-adapter-pattern"]

  claude-adapter:
    description: "Generate slim CLAUDE.md (~150 lines) with core identity, session lifecycle, on-demand guidance pointers to paradigm://guidance/{topic} MCP resources, a Native Memory Hygiene redirect (Memory Steward B1 — route durable facts to lore/habits/decisions/tasks, keep native MEMORY.md ephemeral; T-2026-11-06-002: the habits line names paradigm_habits and paradigm_tool_activate({feature:habits}), since habits is on-demand), and agent contributions section from high-priority .agent context"
    type: service
    path: claude.ts
    aspects: ["~ide-adapter-pattern"]

  copilot-adapter:
    description: Generate .github/copilot-instructions.md for GitHub Copilot
    type: service
    path: copilot.ts
    aspects: ["~ide-adapter-pattern"]

  windsurf-adapter:
    description: Generate .windsurfrules file for Windsurf IDE
    type: service
    path: windsurf.ts
    aspects: ["~ide-adapter-pattern"]

  agents-adapter:
    description: Generate AGENTS.md universal AI agent instruction file (cross-IDE standard)
    type: service
    path: agents.ts
    aspects: ["~ide-adapter-pattern"]

  adapter-registry:
    description: "IDE adapter discovery, selection, and factory. loadParadigmFiles sets files.warpline from #warpline-detect; syncToIDE runs preserveWarplineBlock on single-file outputs (an existing Warpline block is kept byte for byte, a block Paradigm no longer generates is dropped); every syncToIDE call (any adapter) deletes a stale .cursor/rules/paradigm-warpline.mdc when Warpline is not detected."
    type: service
    path: index.ts

  warpline-block:
    description: "T-2026-11-12-001 Warpline awareness. types.ts holds WARPLINE_BLOCK_BEGIN/END and WARPLINE_BLOCK_TEXT (native and git modes), byte-identical to @a-company/warpline renderAgentGuide(mode) — Paradigm never imports Warpline at runtime; src/core/warpline-block-parity.test.ts compares them. base.ts generateWarplineSection(files) ('' unless files.warpline) and preserveWarplineBlock(existing, generated): markers match only as whole lines outside fenced code; exactly one well-formed block in both texts keeps the existing block (CRLF converted to the generated line endings), else the generated text wins. Projects with integrations.warpline.guidance off should run warpline init --no-agent-guide, since sync drops the block. Placement: CLAUDE.md cacheable head between On-Demand Guidance and Directory Structure (#cache-aligner: byte-stable text); AGENTS.md, .windsurfrules and copilot-instructions.md right after the overview; Cursor gets paradigm-warpline.mdc (alwaysApply true) only when detected. Without Warpline no generated file mentions it. The AGENTS.md checkpoint example was compacted to keep the default AGENTS.md well under the always-on cap; the block itself is Warpline-owned census in #always-on-budget."
    type: utility
    path: types.ts
    aspects: ["~ide-adapter-pattern"]

  mcp-config-portability:
    description: "generateMcpConfig (claude.ts → .mcp.json, cursor.ts → .cursor/mcp.json) writes NO absolute cwd: these files are committed, and a machine path broke every other clone (2x-engineers, 2026-11-01). The server resolves `.` by walking up to `.paradigm/`; Cursor also gets env PARADIGM_PROJECT_DIR=${workspaceFolder} (Cursor's spawn cwd is not reliably the workspace; no PATH touched). writeMcpConfig replaces the paradigm entry, so `paradigm sync`/`shift` heal an old file. `paradigm mcp setup` keeps an absolute cwd only for user-level configs (Claude Desktop, Continue). Doctor: 'MCP config portability' (commands/doctor/mcp-portability-audit.ts)."
    type: utility
    path: cursor.ts
    aspects: ["~ide-adapter-pattern"]

flows:
  ide-sync-flow:
    description: Sync .paradigm/ to IDE instruction files
    steps:
      - component: "#adapter-registry"
        action: Detect target IDE from project files
      - component: "#adapter-base"
        action: Load config, specs, and docs
      - component: "#cursor-adapter"
        action: Generate IDE-specific output files
      - component: "#adapter-registry"
        action: Write files to appropriate locations

aspects:
  ~adapter-section-ordering:
    description: All IDE adapters emit sections in a shared order — header, overview, symbol system, terminal guidance, navigation, MCP tools, workflow protocol, session recovery, checkpoints, logging rules, conventions, commit convention, update rules, scan protocol, footer; sections are only included if the config has relevant data
    category: rule
    severity: medium
    tags: [ide-adapters, generation]
    anchors:
      - base.ts:12-19
      - base.ts:24-44
      - base.ts:49-71
      - base.ts:76-112
      - base.ts:229-275
      - base.ts:377-411
    applies-to:
      - "#adapter-base"
      - "#cursor-adapter"
      - "#claude-adapter"
      - "#copilot-adapter"
      - "#windsurf-adapter"
      - "#agents-adapter"
