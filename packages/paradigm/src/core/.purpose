version: 2.0.0
description: |
  Core orchestration and configuration engine for the Paradigm CLI.
  Contains agent management, budget tracking, IDE adapters, provider registry,
  and all internal logic that powers the CLI commands.
components:
  pipeline-types:
    description: Spec pipeline type definitions — 5 stages, 3 gate modes, pipeline state, templates
    type: model
    tags: [pipeline, types]
    path: pipeline-types.ts
  pipeline-utils:
    description: Pipeline YAML utilities — load, save, list, create, archive pipeline state files
    type: utility
    tags: [pipeline, utilities]
    path: pipeline-utils.ts
  orchestrator:
    description: Multi-agent task conductor supporting solo and faceted modes
    type: engine
    aspects:
      - ~budget-enforced
    flows:
      - $agent-orchestration-flow
    path: orchestrator.ts
  agent-spawner:
    description: Spawn individual agents with task, context, and budget constraints. Includes completion confirmation — validates relay output before accepting success status.
    type: service
    aspects:
      - ~provider-cascade
      - ~completion-confirmation
    path: agent-spawner.ts
  agent-matcher:
    description: Classify tasks and match appropriate agent teams based on triggers
    type: service
    path: agent-matcher.ts
  agent-prompts:
    description: Generate agent-specific prompts with role context and handoff data. Builder prompt includes Fresh Context Principle; reviewer prompt uses two-stage review protocol (spec compliance then code quality) with minimum 3 categorized findings.
    type: utility
    path: agent-prompts.ts
  model-discovery:
    description: Discover available LLM models from APIs, remote manifest, and presets
    type: service
    path: model-discovery.ts
  provider-registry:
    description: Registry for agent providers with priority cascade and availability checking
    type: store
    aspects:
      - ~provider-cascade
    path: provider-registry.ts
  task-classifier:
    description: Classify task complexity (simple/moderate/complex) and assign models
    type: service
    path: task-classifier.ts
  budget-tracker:
    description: Track token and cost budgets during orchestration execution
    type: engine
    aspects:
      - ~budget-enforced
    path: budget-tracker.ts
  cost-estimator:
    description: Estimate token costs for models based on pricing data
    type: utility
    path: cost-estimator.ts
  context-builder:
    description: Build AI context from symbols, files, and role-specific includes/excludes
    type: service
    path: context-builder.ts
  flow-validator:
    description: Validate flow definitions against the actual codebase implementation and generate Mermaid flowchart diagrams
    type: service
    path: flow-validator.ts
  portal-compliance:
    description: Validate portal.yaml gates are used in routes and routes reference declared gates
    type: service
    path: portal-compliance.ts
  audit-logger:
    description: Log orchestration execution details and costs to .paradigm/orchestrations/
    type: service
    path: audit-logger.ts
  background-orchestrator:
    description: Run orchestration in background with progress reporting
    type: engine
    path: background-orchestrator.ts
signals:
  orchestration-started:
    description: Multi-agent orchestration has begun
  orchestration-completed:
    description: Multi-agent orchestration finished successfully
  agent-spawned:
    description: Individual agent spawned via provider
  budget-exceeded:
    description: Token or cost budget limit was reached
aspects:
  ~solo-vs-faceted-modes:
    description: Orchestrator supports two modes — solo (single generalist agent, uses opus) and faceted (multi-agent with role-specific prompts); default is faceted
    tags:
      - orchestration
      - modes
    anchors:
      - orchestrator.ts:39-39
      - orchestrator.ts:260-260
      - orchestrator.ts:291-307
    applies-to:
      - '#orchestrator'
  ~default-agent-model-assignments:
    description: Default model tier per agent role — architect/security use opus, reviewer uses sonnet, builder/tester use haiku
    tags:
      - orchestration
      - models
    anchors:
      - orchestrator.ts:130-136
      - agent-prompts.ts:298-305
    applies-to:
      - '#orchestrator'
      - '#agent-prompts'
  ~confidence-threshold-3-match:
    description: Agent matcher confidence levels — high requires 3+ matches or multiple match types, medium requires 2, low is 1
    tags:
      - classification
      - matching
    anchors:
      - agent-matcher.ts:196-218
    applies-to:
      - '#agent-matcher'
  ~fresh-context-principle:
    description: Builder prompt enforces Fresh Context Principle — each builder task runs in separate clean context with no assumptions carried from prior tasks
    tags:
      - orchestration
      - prompts
    anchors:
      - agent-prompts.ts:118-123
    applies-to:
      - '#agent-prompts'
  ~reviewer-two-stage-minimum-3:
    description: Reviewer prompt uses two-stage review (spec compliance then code quality) with Stage 1 blocking Stage 2; every review must produce at least 3 categorized findings
    tags:
      - orchestration
      - prompts
      - review
    anchors:
      - agent-prompts.ts:156-182
    applies-to:
      - '#agent-prompts'
  ~model-discovery-order:
    description: Model discovery follows a 3-tier fallback — API providers first, then remote manifest (cached 7 days), then hardcoded presets
    tags:
      - discovery
      - models
    anchors:
      - model-discovery.ts:1-9
      - model-discovery.ts:22-22
      - model-discovery.ts:42-42
      - model-discovery.ts:137-166
    applies-to:
      - '#model-discovery'
  ~provider-cascade-order:
    description: Provider cascade order is claude, claude-code-teams, claude-code, cursor-cli, claude-cli, manual — manual is always-available ultimate fallback
    tags:
      - providers
      - cascade
    anchors:
      - provider-registry.ts:38-38
      - provider-registry.ts:196-218
      - provider-registry.ts:357-377
    applies-to:
      - '#provider-registry'
      - '#agent-spawner'
  ~task-classification-priority:
    description: Task type classification priority is analysis > documentation > bugfix > refactor > feature (default); complexity scored from symbol count, word count, prefix diversity, gate/flow symbols, affected files
    tags:
      - classification
      - complexity
    anchors:
      - task-classifier.ts:311-388
      - task-classifier.ts:226-266
    applies-to:
      - '#task-classifier'
  ~budget-defaults-500k-5usd-80pct:
    description: Default budget limits are 500K tokens, $5.00 USD max cost, warning at 80% usage; enforced at global and per-agent levels
    tags:
      - budget
      - limits
    anchors:
      - budget-tracker.ts:319-323
      - budget-tracker.ts:89-163
    applies-to:
      - '#budget-tracker'
  ~cost-estimation-per-million:
    description: Model pricing is per-million tokens — opus $15/$75, sonnet $3/$15, haiku $0.25/$1.25 (input/output); cost estimation uses complexity multipliers (low 0.6x, medium 1.0x, high 1.5x)
    tags:
      - cost
      - pricing
    anchors:
      - cost-estimator.ts:64-79
    applies-to:
      - '#cost-estimator'
  ~context-role-specific-includes:
    description: Context builder uses role-specific include/exclude patterns — architect gets specs and .purpose files (excludes src), builder gets src and tests (excludes specs), security gets portal.yaml and auth directories
    tags:
      - context
      - roles
    anchors:
      - context-builder.ts:95-183
    applies-to:
      - '#context-builder'
  ~flow-mermaid-generation:
    description: Flow validator generates Mermaid flowchart TD diagrams — gates as diamonds, actions as rectangles, signals as rounded rectangles; includes deny paths for gates and color-coded class definitions
    tags:
      - flows
      - visualization
    anchors:
      - flow-validator.ts:603-668
    applies-to:
      - '#flow-validator'
  ~portal-language-agnostic-grep:
    description: Portal compliance uses grep-based language-agnostic pattern matching to find gate references across ts/js/py/go files; searches for ^symbol patterns and function-based checks (checkGate, requireGate, @Gate)
    tags:
      - portal
      - compliance
    anchors:
      - portal-compliance.ts:128-198
    applies-to:
      - '#portal-compliance'
  ~completion-confirmation:
    description: Agent spawner validates relay output before accepting success — builders must write files, all agents must produce artifacts/decisions/handoff. Failures downgrade to partial with logged message.
    tags:
      - orchestration
      - completion
    anchors:
      - agent-spawner.ts:270-300
    applies-to:
      - '#agent-spawner'
  ~audit-log-yaml-per-orchestration:
    description: Audit logs are stored as YAML files in .paradigm/orchestrations/ with date-prefixed filenames; each file contains full agent details, token counts, costs, and artifacts
    tags:
      - audit
      - logging
    anchors:
      - audit-logger.ts:75-81
      - audit-logger.ts:161-174
    applies-to:
      - '#audit-logger'
  ~background-accept-reject-workflow:
    description: Background orchestrations follow a pending/running/completed/accepted/rejected lifecycle; only completed orchestrations can be accepted or rejected, rejection can optionally clean up created files
    tags:
      - orchestration
      - background
    anchors:
      - background-orchestrator.ts:21-21
      - background-orchestrator.ts:190-233
    applies-to:
      - '#background-orchestrator'
  habits-loader:
    description: Habits engine — 5-step merge loader (seeds → global yaml → global .habit → project yaml → project .habit), validation, and individual .habit file support
    tags:
      - habits
      - loading
    anchors:
      - habits/loader.ts:57-57
      - habits/loader.ts:79-79
      - habits/loader.ts:163-163
    applies-to:
      - '#orchestrator'
  habits-types:
    description: Habit type definitions — HabitDefinition, HabitCheck, HabitCategory, HabitTrigger, HabitSeverity, check type enums
    anchors:
      - habits/types.ts:12-12
      - habits/types.ts:66-66
    tags:
      - habits
      - types
    applies-to:
      - '#orchestrator'
flows:
  agent-orchestration-flow:
    description: Orchestrate a multi-agent task from classification through execution
    signals:
      - '!orchestration-started'
      - '!orchestration-completed'
    steps:
      - component: '#task-classifier'
        action: Classify task complexity and match agent team
      - component: '#budget-tracker'
        action: Check token/cost budget availability
      - component: '#agent-spawner'
        action: Spawn agents in parallel where possible
      - component: '#orchestrator'
        action: Collect results and handle handoffs
      - component: '#audit-logger'
        action: Log execution and costs
