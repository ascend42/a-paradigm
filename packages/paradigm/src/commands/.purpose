version: 2.0.0
description: CLI command implementations for the paradigm binary
components:
  ServeCommand:
    description: paradigm serve — launches the unified Platform server
    type: command
    tags:
      - feature
  ShiftCommand:
    description: paradigm shift — full project setup in one command. 7.11.0 — no longer scaffolds .paradigm/university/ or writes a university metrics snapshot (packs are opt-in via `paradigm university init`).
    type: command
  InitCommand:
    description: paradigm init — initialize Paradigm in a project
    type: command
  ScanCommand:
    description: paradigm scan — rebuild symbol index. navigator.ts buildSymbolMap (exported) maps premise-core aggregator `filePath` to the project-relative containing directory (v7.9.1 fix — navigator.yaml had 0 symbol mappings because only path/directory were read)
    type: command
  DoctorCommand:
    description: 'paradigm doctor — health checks. 7.12.0 (D7): learning liveness reads the UNION of postflight-liveness.jsonl + settlement-liveness.jsonl (summarizeLearningLiveness levels red/amber/thin/green/nodata, never green on no data; "probe silent" warn when settlements exist but no postflight rows); learning-store census via #learning-stores; warns on leftover legacy .paradigm/wisdom/decisions/.'
    type: command
  GraphCommand:
    description: paradigm graph — interactive symbol graph (standalone)
    type: command
  MigrateCommand:
    description: paradigm migrate — version-aware project migration
    type: command
  MigrateDecisionsCommand:
    description: 'paradigm migrate decisions — v6.0 decision-store consolidation: wisdom/decisions + lore(type=decision) → .paradigm/decisions/TD-*'
    type: command
    tags:
      - v6
      - migration
      - decisions
    file: packages/paradigm/src/commands/migrate-decisions.ts
  MigrateLearningStoresCommand:
    description: 'paradigm migrate learning-stores (7.12.0) — --dry-run plans every step with zero writes. Steps: (1) back up originals → .paradigm/backups/learning-stores-<ts>/, (2) legacy wisdom/decisions → TD store (reuses migrate-decisions wisdom converter) + rmdir, (3) unengaged "Work completed" nominations → backup nominations-boilerplate.jsonl, (4) habits referencing removed University paths — report only unless --apply, (5) marker .paradigm/migrations/learning-stores.done. Idempotent; global ~/.paradigm/wisdom/decisions reported, never touched. Also registered as migration learning-stores-7.12 (auto:false) in migrate/migrations.ts.'
    type: command
    tags:
      - migration
      - learning
      - v7.12
    file: packages/paradigm/src/commands/migrate-learning-stores.ts
  DocsServeCommand:
    description: paradigm docs serve — launches the Platform with docs section enabled
    type: command
    tags:
      - feature
      - docs
  DocsBuildCommand:
    description: paradigm docs build — static export of symbol-graph documentation
    type: command
    tags:
      - feature
      - docs
  GraduateCommand:
    description: paradigm graduate — automation tier graduation CLI (status, promote, demote)
    type: command-group
    tags:
      - feature
      - graduation
      - automation
  PersonaCommand:
    description: paradigm persona — actor-driven journey testing CLI (list, show, validate, coverage, run, affected, delete)
    type: command-group
    tags:
      - feature
      - personas
      - testing
  drift-command:
    description: 'paradigm drift — CLI aspect-anchor drift check over .paradigm/aspect-graph.db with git line-shift auto-heal. The line mapping diffs through #safe-git (no shell, hex commit ids only). Anchor file_path and the aspect defined_in come from the DB (repo content), so resolveInsideRoot (#path-containment; realpath, symlinks followed) refuses anything outside the project: such an anchor reports missing, and only a real .purpose file inside the project is ever healed.'
    type: command
    file: packages/paradigm/src/commands/drift.ts
    tags: [aspects, drift, security]
  conductor-install:
    description: 'Global binary install for Conductor. --install copies native binary to ~/.paradigm/conductor/bin/. Three-tier resolution: installed → monorepo dev → error.'
    type: command
    file: packages/paradigm/src/commands/conductor.ts
  UtilNamespace:
    description: paradigm util — utility command namespace grouping beacon, constellation, echo, sync-llms, thread, and probe under a single namespace. Top-level registrations of those commands emit a deprecation notice to stderr.
    type: command-group
    tags:
      - feature
      - util
    file: packages/paradigm/src/commands/util/index.ts
  paradigm-override-cli:
    description: paradigm override [id] | list | clear-all --force — public CLI to clear active soft-block remediations authored by archetype agents (v6.1 Sprint 1 Wave 3). Symmetric to PARADIGM_OVERRIDE env-var path; both writers append to .paradigm/events/overrides.jsonl with mechanism cli|env. Archives cleared remediations to .paradigm/remediations/.archived/ with archived_at stamp.
    type: command-group
    tags:
      - feature
      - v6.1
      - soft-block
      - override
    file: packages/paradigm/src/commands/override.ts
  paradigm-arch-cli:
    description: paradigm arch — CLI command for symbol architecture inspection. Delegates to arch MCP tools; surfaces project component graph, flows, and gates as human-readable output.
    file: packages/paradigm/src/commands/arch.ts
    components:
      - '#arch-tools'
    type: command
  paradigm-solo-cli:
    description: paradigm solo <reason> [note] — declare a deliberate no-team session (Pillar 0 invocation funnel). Enumerated reasons (trivial|hotfix|user-directed|exploratory) + optional note; writes the .paradigm/.solo-declared marker (TTL-expired, ~4h via PARADIGM_GATE_TTL_HOURS — NOT stop-cleared, Stop fires per turn) and appends a solo-declared event to team-funnel telemetry. Satisfies the prompt-gate, edit-gate, and stop-hook orchestration-required check.
    type: command
    components:
      - '#team-funnel'
    tags:
      - feature
      - orchestration
      - team-funnel
    file: packages/paradigm/src/commands/solo.ts
