version: 2.0.0
description: |
  #doctor-command - Health check and diagnostics for Paradigm setup.
  Includes core setup validation and context audit checks for AI instruction file quality.
features:
  context-audit-checks:
    description: Context audit with 7 checks — stale-references, convention-contradictions, undocumented-stack, purpose-coverage, orphaned-symbols, stale-portal, instruction-vagueness
    components:
      - '#context-audit'
components:
  doctor-handler:
    description: Core health checks for .paradigm directory, config, specs, docs, IDE files, portal, flows, lore, hooks, and habits. v6.0.4 added 'info' status for non-blocking metric surfacing (renderer only — Wave 3 wires the aspect-coverage line item that consumes it).
    type: handler
    file: index.ts
    components:
      - '#gap-narrator'
  info-status:
    description: |
      v6.0.4 CheckResult status added to the existing ok/warn/error/missing
      union. Renders as a dim '⠂' icon in chalk.gray. Surfaces metrics
      without affecting exit code or summary counters — used by line items
      that report data when no claimant is active.
    type: model
    file: index.ts
    tags:
      - doctor
      - status
      - v6.0.4
  context-audit:
    description: 7 context quality checks for AI instruction files (CLAUDE.md, .cursorrules, AGENTS.md)
    type: utility
    tags:
      - feature
      - context-quality
    file: context-audit.ts
  agent-audit:
    description: 'v7.9.1 (TD-2026-09-26-846) auditAgents(rootDir, {globalDir?}) — pure check behind doctor''s "Agent profile keys" (warn on keys outside a local KNOWN_AGENT_KEYS copy; info when `behaviors:` is present but unread until skills Phase 1) and "Roster dispatchability" (warn on active roster ids with no project/global .agent and no agents.yaml entry, or benched on the roster; fix = paradigm agent sync-global or deactivate). Scans project .agent files plus roster-relevant global ones. v7.10.0 (Skills Phase 1): `skills` is a known key; skillMigrations() scans project + global SKILL.md provenance.migratedFrom and auditAgents returns migratedBehaviors, which doctor renders as info lines "<file> `behaviors.<block>` migrated to skill <id>".'
    type: utility
    file: agent-audit.ts
    tags:
      - doctor
      - agent-identity
  legacy-names-audit:
    description: 'v7.13.0 (T-2026-09-26-005, MCP surface cut) auditLegacyToolNames(rootDir) — scans CLAUDE.md, AGENTS.md, .cursor/rules/** and .claude/settings{,.local}.json permissions.{allow,deny,ask} for renamed pre-7.13 `paradigm_<family>_<op>` tool names (anchors and same-name entries excluded). Driven by #legacy-tool-map (single source of truth, imported from paradigm-mcp). Doctor renders "Legacy tool names (permissions)" warn (dead allowlist entries re-prompt) and "Legacy tool names" warn with the family({op}) replacement; ok when clean. Advisory — never fails doctor.'
    type: utility
    file: legacy-names-audit.ts
    tags:
      - doctor
      - mcp-surface
      - v7.13.0
