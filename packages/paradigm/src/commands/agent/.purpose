version: 2.0.0
description: |
  CLI commands for managing persistent agent identity files (.agent).
  CRUD for profiles, expertise bootstrapping from lore, and profile viewing.

components:
  AgentCommands:
    description: "CLI: paradigm agent list, show, create, sync — manages .agent identity files with permission scoping (--deny-paths) and permissions display"
    type: command-group
    tags: [feature, agent-identity, permissions, cli]
  AdoptionCRUD:
    description: "CRUD for .paradigm/adoptions.yaml — load, save, add, remove adoption records. Handles kebab/camelCase normalization and roster migration."
    type: module
    tags: [feature, agent-adoption, cli]
  AdoptionRendering:
    description: "Terminal rendering for adoption ceremony UX — marketplace install cards (renderAdoptionCard) and shift batch summary (renderBatchSummary)."
    type: module
    tags: [feature, agent-adoption, ceremony, cli]
  ScopesEngine:
    description: "Scope diffing, approval, denial, and persistence engine for agent scoped permissions. Manages .paradigm/adoptions.yaml scopes and .paradigm/.pending-scope-reviews."
    type: module
    tags: [feature, agent-identity, scopes, adoption]
  ScopesCommands:
    description: "CLI command handlers for agent scope management: paradigm agent review, approve, deny, scopes. User-facing entry points that delegate to ScopesEngine and AdoptionCRUD."
    type: command-group
    tags: [feature, agent-identity, scopes, cli]

signals:
  agent-created:
    description: Emitted when a new .agent file is created via paradigm agent create
    tags: [agent-identity]
  agent-synced:
    description: Emitted when agent expertise is rebuilt from project lore history
    tags: [agent-identity]
  expertise-updated:
    description: Emitted when agent expertise auto-updates after lore recording
    tags: [agent-identity]
  !scopes-approved:
    description: Emitted when a user approves an agent's scoped permissions
    tags: [agent-identity, scopes]
  !scopes-denied:
    description: Emitted when a user denies an agent's scope update
    tags: [agent-identity, scopes]

flows:
  $agent-expertise-flow:
    description: "Lore recorded → expertise updated → profile saved → notebook entries loaded → orchestrator enriched"
    tags: [agent-identity, orchestration]
  $agent-adoption-flow:
    description: "Shift detects project → suggests agents → ceremony renders batch summary → user accepts → adoptions.yaml written"
    tags: [agent-adoption, ceremony]
  $scope-approval-flow:
    description: "Scope change detected → diff computed → user prompted → approved/denied → adoption record updated → pending review cleared"
    tags: [agent-identity, scopes, adoption]
