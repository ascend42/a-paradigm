version: 2.0.0
description: |
  CLI commands for managing persistent agent identity files (.agent).
  CRUD for profiles, expertise bootstrapping from lore, and profile viewing.

components:
  AgentCommands:
    description: "CLI: paradigm agent list, show, create, sync — manages .agent identity files with permission scoping (--deny-paths) and permissions display"
    type: command-group
    tags: [feature, agent-identity, permissions, cli]
  AdoptionCRUD:
    description: "CRUD for .paradigm/adoptions.yaml — load, save, add, remove adoption records. Handles kebab/camelCase normalization, roster migration, and SHA-256 integrity hashing for tamper detection."
    type: module
    tags: [feature, agent-adoption, cli, security]
  AdoptionRendering:
    description: "Terminal rendering for adoption ceremony UX — marketplace install cards (renderAdoptionCard) and shift batch summary (renderBatchSummary)."
    type: module
    tags: [feature, agent-adoption, ceremony, cli]
  ScopesEngine:
    description: "Scope diffing, approval, denial, and persistence engine for agent scoped permissions. Manages .paradigm/adoptions.yaml scopes and .paradigm/.pending-scope-reviews."
    type: module
    tags: [feature, agent-identity, scopes, adoption]
  ScopesCommands:
    description: "CLI command handlers for agent scope management: paradigm agent review, approve, deny, scopes. User-facing entry points that delegate to ScopesEngine and AdoptionCRUD."
    type: command-group
    tags: [feature, agent-identity, scopes, cli]
  RegistryCommands:
    description: "CLI: paradigm agent install, search, publish — wires Paradigm to nevr.land registry via @a-company/registry-client. Lazy-loads the client, writes .agent profiles, records adoption. v6.0.3+ surfaces PartnerCoverage indicator from registry response when present."
    type: command-group
    tags: [feature, agent-registry, nevr, cli]
  Partners:
    description: "Pure-helper module for the v6.0.3 partners primitive. Exports validateReciprocity, findMissingPartners, pairLabel (alphabetically canonical), pairNotebookPath (returns _pairs/{a-b}/), getPartnerStatus returning 'reciprocal'|'pending'|'not-installed'. No I/O — agents passed in by caller."
    type: module
    tags: [feature, agent-partners, partners-primitive]
  RegistryTypes:
    description: "v6.0.3 marketplace SKU primitives — typed-only contracts, no live consumer. Exports PartnerBundle (groups partnered agents into single SKU), ReciprocalInstallMeta (typed install-prompt metadata), PartnerCoverage (registry-index indicator). Forward-compat for nevr.land MVP."
    type: module
    tags: [feature, agent-partners, marketplace-primitive, contracts-only]
  SyncGlobalCommand:
    description: "CLI: paradigm agent sync-global — copies the ~67 bundled canonical .agent profiles from <packageRoot>/templates/agents/ into ~/.paradigm/agents/. Default skip-if-exists preserves user customizations; --force overwrites; --dry-run previews. Fixes the frozen-roster problem so npm update + sync-global gets the full team."
    type: command
    tags: [feature, agent-identity, cli, university-cli]

signals:
  agent-created:
    description: Emitted when a new .agent file is created via paradigm agent create
    tags: [agent-identity]
  agent-synced:
    description: Emitted when agent expertise is rebuilt from project lore history
    tags: [agent-identity]
  expertise-updated:
    description: Emitted when agent expertise auto-updates after lore recording
    tags: [agent-identity]
  !scopes-approved:
    description: Emitted when a user approves an agent's scoped permissions
    tags: [agent-identity, scopes]
  !scopes-denied:
    description: Emitted when a user denies an agent's scope update
    tags: [agent-identity, scopes]
  !agent-installed:
    description: Emitted when an agent is installed from the nevr.land registry
    tags: [agent-registry, nevr]

flows:
  $agent-expertise-flow:
    description: "Lore recorded → expertise updated → profile saved → notebook entries loaded → orchestrator enriched"
    tags: [agent-identity, orchestration]
  $agent-adoption-flow:
    description: "Shift detects project → suggests agents → ceremony renders batch summary → user accepts → adoptions.yaml written"
    tags: [agent-adoption, ceremony]
  $scope-approval-flow:
    description: "Scope change detected → diff computed → user prompted → approved/denied → adoption record updated → pending review cleared"
    tags: [agent-identity, scopes, adoption]
  $agent-install-flow:
    description: "User runs install → registry queried → package downloaded (or metadata fallback) → .agent profile written → adoption recorded"
    tags: [agent-registry, nevr, adoption]
  $partners-rendering-flow:
    description: "agent get/list rendering → loadAllProfiles → reciprocity computed via getPartnerStatus → Partners block renders with reciprocal (✓ green) / pending (⚠ yellow) / not-installed (yellow + install hint) variants"
    tags: [agent-partners, cli]
