version: 2.0.0
purpose: University CLI commands
description: >
  CLI command group for per-project university management.
  Subcommands: serve, list, add, show, quiz, status, validate, init (v6.0),
  migrate-plsat (v6.0, hidden).
  v6.5: add/list honor --section flag; init prints a sections tip; serve emits a one-shot
  FTUX advisory when running a pack without sections; validate runs section integrity checks
  (duplicate id, two defaults, unknown ref, invalid style, dangling section warning).

components:
  UniversityCommands:
    description: CLI interface for university content management
    type: command-group
    tags: [university, cli]
  UniversityInit:
    description: Scaffold project-pack or discipline sub-pack pack.yaml. v6.5 emits a sections tip after scaffold.
    type: command
    tags: [university, cli, pack, v6]
  UniversityValidate:
    description: >
      Pack integrity validator — broken path steps, bad quiz answer keys,
      missing titles. v6.5: adds section integrity checks (duplicate id,
      multiple defaults, unknown section ref on entry, invalid style,
      dangling section warning, non-kebab section id).
    type: command
    tags: [university, cli, validation, v6.5]
  UniversityMigratePlsat:
    description: >
      One-shot PLSAT JSON → v6 content-pack migration (hidden).
      With --delete-sources, also removes orphan .purpose files in courses/
      and plsat/ source dirs and warns on any unexpected leftovers (Jinx
      pre-mortem mitigation #1, v6.0 finalization).
    type: command
    tags: [university, cli, migration, v6]
