version: 2.0.0
purpose: University CLI commands
description: >
  CLI command group for per-project university management.
  Subcommands: serve, list, add, show, quiz, status, validate, init (v6.0),
  migrate-plsat (v6.0, hidden).
  v6.5: add/list honor --section flag; init prints a sections tip; serve emits a one-shot
  FTUX advisory when running a pack without sections; validate runs section integrity checks
  (duplicate id, two defaults, unknown ref, invalid style, dangling section warning).
  v6.6.5: subcommands now honor the pack selector end-to-end. list/status/validate read the
  SELECTED pack's index (loadPackIndex) when a selector is present; show/quiz resolve packRoot
  from a flag OR the <pack-id>:<entry-id> address; add writes under the selected pack and only
  rebuilds the project index when the target is the project pack; serve forwards packRoot/packId
  to the server and uses the dual-base probe for contentDir. No-selector paths are byte-identical.

components:
  UniversityCommands:
    description: >
      CLI interface for university content management. v6.6.5: pack-selector
      honored across list/add/show/quiz/status/validate/serve (gated on
      hasSelector → byte-identical default path).
    type: command-group
    tags: [university, cli, pack, v6.6.5]
  UniversityServe:
    description: >
      7.11.0 redirect: the standalone University UI + server were retired.
      Prints "University moved to Platform → Academy", starts the Platform with
      sections ['academy'] on --port (default 3839) and opens /academy unless
      --no-open. Pack selectors are accepted for compatibility and ignored.
    type: command
    tags: [university, cli, serve, academy]
  UniversityInit:
    description: Scaffold project-pack or discipline sub-pack pack.yaml. v6.5 emits a sections tip after scaffold.
    type: command
    tags: [university, cli, pack, v6]
  UniversityValidate:
    description: >
      Pack integrity validator — broken path steps, bad quiz answer keys,
      missing titles. v6.5: adds section integrity checks (duplicate id,
      multiple defaults, unknown section ref on entry, invalid style,
      dangling section warning, non-kebab section id).
    type: command
    tags: [university, cli, validation, v6.5]
  UniversityMigratePlsat:
    description: >
      One-shot PLSAT JSON → v6 content-pack migration (hidden).
      With --delete-sources, also removes orphan .purpose files in courses/
      and plsat/ source dirs and warns on any unexpected leftovers (Jinx
      pre-mortem mitigation #1, v6.0 finalization).
    type: command
    tags: [university, cli, migration, v6]
