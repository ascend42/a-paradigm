version: 2.0.0
description: |
  Symphony CLI commands — terminal interface for The Score agent-to-agent messaging.
  Part of Symphony: file-based agent parts polled via /loop.

components:
  symphony-join:
    description: Join this session to the Symphony network
    type: command
    tags: [feature, symphony]
  symphony-leave:
    description: Remove this session from the Symphony network
    type: command
    tags: [feature, symphony]
  symphony-whoami:
    description: Show agent identity and linked peers
    type: command
    tags: [feature, symphony]
  symphony-list:
    description: List all joined agents with awake/asleep status
    type: command
    tags: [feature, symphony]
  symphony-send:
    description: Send a note to agents (human CLI entry point)
    type: command
    tags: [feature, symphony]
  symphony-read:
    description: Show unread notes with tree rendering
    type: command
    tags: [feature, symphony]
  symphony-threads:
    description: List all threads (active and resolved)
    type: command
    tags: [feature, symphony]
  symphony-thread:
    description: Show full thread conversation with all notes
    type: command
    tags: [feature, symphony]
  symphony-resolve:
    description: Mark a thread as resolved with optional decision
    type: command
    tags: [feature, symphony]
  symphony-status:
    description: Show Symphony network overview
    type: command
    tags: [feature, symphony]
  symphony-serve:
    description: Start TCP server for remote Symphony linking (Phase 0 stub)
    type: command
    tags: [feature, symphony]
  symphony-request:
    description: Request a file from another agent's project
    type: command
    tags: [feature, symphony]
  symphony-approve:
    description: Approve a pending file request
    type: command
    tags: [feature, symphony]
  symphony-requests:
    description: List pending file requests awaiting approval
    type: command
    tags: [feature, symphony]
  symphony-deny:
    description: Deny a pending file request
    type: command
    tags: [feature, symphony]
  symphony-watch:
    description: Zero-token real-time inbox monitor — pure file-system polling with intent color-coding and thread detection
    type: command
    tags: [feature, symphony]

flows:
  symphony-send-flow:
    description: Human types note -> built -> routed to agent inboxes
    tags: [symphony]
    steps:
      - '#symphony-send'
      - '#symphony-loader'
      - '!note-sent'

  symphony-poll-flow:
    description: /loop fires -> poll -> read inbox -> agent processes -> reply
    tags: [symphony]
    steps:
      - '#symphony-poll'
      - '#symphony-loader'
      - '!note-received'

  file-request-flow:
    description: Request file -> trust check -> human approval -> read file -> deliver
    tags: [symphony, security]
    steps:
      - '#symphony-request'
      - '^file-trust'
      - '#symphony-approve'
      - '!file-delivered'

gates:
  file-trust:
    description: Trust config check on file requests — hard-deny list always blocks
    tags: [security, symphony]

signals:
  note-sent:
    description: A note was sent via Symphony
    category: business
    tags: [symphony]
  note-received:
    description: A note was received in an agent's inbox
    category: business
    tags: [symphony]
  thread-created:
    description: A new conversation thread was auto-created
    category: business
    tags: [symphony]
  thread-resolved:
    description: A thread was marked as resolved
    category: business
    tags: [symphony]
  file-requested:
    description: An agent requested a file from another project
    category: business
    tags: [symphony]
  file-approved:
    description: A file request was approved by the human owner
    category: business
    tags: [symphony]
  file-denied:
    description: A file request was denied
    category: business
    tags: [symphony]
  file-delivered:
    description: File content was delivered to the requesting agent
    category: business
    tags: [symphony]

aspects:
  human-gated-transfer:
    description: File transfers always require explicit human approval (unless auto-approved in trust config)
    category: rule
    severity: critical
    tags: [security, symphony]
    anchors:
      - ../../../../../packages/paradigm-mcp/src/utils/symphony-loader.ts:600-650
  hard-deny-list:
    description: Certain file patterns (.env, *.key, *.pem, credentials) are always blocked regardless of approval
    category: invariant
    severity: critical
    tags: [security, symphony]
    anchors:
      - ../../../../../packages/paradigm-mcp/src/utils/symphony-loader.ts:660-690
