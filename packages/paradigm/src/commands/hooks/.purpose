version: 2.0.0
components:
  skill-used-hook:
    description: 'v7.10.0 (Skills Phase 1) Claude Code PostToolUse hook (matcher: Skill) — scripts/claude-code-skill-used.sh, copied to the plugin as paradigm-skill-used.sh and installed by `paradigm hooks install --claude-code`. Pre-filters payloads without `pdg-`, then pipes the payload to the hidden `paradigm skill record-usage` verb, which appends a !skill-used row. Always exit 0, no output.'
    type: hook
    file: scripts/claude-code-skill-used.sh
    signals:
      - '!skill-used'
    tags:
      - hooks
      - skills
  paradigm-hooks:
    description: CLI hook installer and enforcement scripts for Claude Code, Cursor, and git. Stop hook validates 13 compliance checks including .purpose freshness, portal.yaml coverage, aspect anchors, and lore recording. Supports PARADIGM_AUTO_FIX=1 for auto-fixing trivial violations (missing .purpose stubs, missing lore entries). Includes plugin version compatibility checking against semver ranges from hooks.json compatibleVersions field.
    type: command
    signals:
      - '!compliance-violation'
      - '!hook-installed'
  hook-monitor:
    description: |
      7.15.2 hook self-monitoring (scripts/paradigm-hook-monitor.sh, sourced by
      every Claude Code hook via _pm_begin <Hook> <timeoutMs> <budgetMs>).
      Appends a start record and, from an EXIT trap, an end record (wall ms,
      rc, outcome ok|blocked|error|killed; SIGTERM/HUP/INT -> killed) to the
      ring .paradigm/events/hook-timings.jsonl. A SIGKILLed hook leaves a
      start with no end; readers treat it as killed once older than its
      timeout + 5 s. Cost: two date(1) calls and two shell appends, no CLI or
      node spawn. Ring trimmed to PARADIGM_HOOK_RING_MAX (500) lines on ~1 in
      64 runs and deterministically at SessionStart. Fail open: no stdout,
      exit code preserved, every write best-effort; PARADIGM_HOOK_MONITOR_OFF=1
      disables it. Ring + marker are in the #session-markers-gitignore block.
    type: utility
    file: scripts/paradigm-hook-monitor.sh
    tags:
      - hooks
      - observability
  stop-hook-timing:
    description: |
      7.15.2 timing contract for every plugin hook. Claude Code waits for EOF on
      a hook's stdout/stderr, not for its exit, until the hook timeout (Stop: 30 s).
      Rules: (1) never background a command without </dev/null >/dev/null 2>&1;
      (2) paradigm-common.sh discovers .purpose files via `git ls-files -co
      --exclude-standard` (nested agent worktrees and node_modules are skipped)
      and keeps hot loops fork-free (_parent, _is_modified, one awk pass for
      Check 4 anchors); (3) no network (npx --no-install). Enforced by
      tests/hooks-timing.test.ts (each hook under 2 s through a pipe, plus a
      lint check on background jobs).
    type: utility
    file: scripts/paradigm-common.sh
    tags:
      - hooks
      - performance
  has-compliance-claimant:
    description: |
      v6.0.4 POSIX sh helper in paradigm-common.sh that reads
      .paradigm/roster.yaml and sets HAS_COMPLIANCE_CLAIMANT=true iff the
      'active:' list contains 'compliance' (block-list or inline-array form).
      Falls back to false on missing/unparseable. Wave 1 introduces the
      helper only — no callers yet (Wave 2 wires Check 6 and Check 10 to
      consume it).
    type: utility
    file: scripts/paradigm-common.sh
    tags:
      - hooks
      - roster
      - v6.0.4
  team-invocation-gates:
    description: |
      Pillar 0 (invocation reliability) advisory tier — two new Claude Code
      hooks: prompt-gate (UserPromptSubmit; classifies the incoming prompt and
      injects a decision-time orchestration directive into model context, once
      per TTL window, telemetry on every match) and team-gate (PreToolUse
      Write|Edit; one-time stderr advisory before source edits in unresolved
      sessions). Both honor .orchestrated / fresh .solo-declared markers and
      the PARADIGM_TEAM_GATE=off kill switch. Markers expire by AGE
      (PARADIGM_GATE_TTL_HOURS, default 4h) — never stop-cleared, because Stop
      fires per assistant turn. Check 13 in paradigm-common.sh records deduped
      bypass events to team-funnel telemetry at both warn and block severity.
    type: utility
    components:
      - '#team-funnel'
    signals:
      - '!team-funnel'
    tags:
      - hooks
      - orchestration
      - team-funnel
      - pillar-0
    file: scripts/claude-code-prompt-gate.sh
  check-14-remediation-gate:
    description: |
      v6.1 Sprint 1 Wave 2 — Stop hook Check 14. Iterates the cached
      _REMEDIATIONS_JSON (sourced from `paradigm internal active-remediations
      --json`). severity=guard adds to VIOLATIONS (blocks); advise/auto-author
      route to ADVISORY. Honors PARADIGM_OVERRIDE comma-list to skip ids and
      append an audit row to .paradigm/events/overrides.jsonl with mechanism=env.
      Iteration uses temp-file + redirect (NOT pipe) for POSIX subshell-safe
      VIOLATION_COUNT propagation.
    type: utility
    file: scripts/paradigm-common.sh
    signals:
      - '!override-event'
    tags:
      - hooks
      - remediation
      - soft-block
      - v6.1
  check-15-memory-hygiene-nudge:
    description: |
      Memory Steward A3 (TD-2026-09-19-110) — Stop hook Check 15. Advisory-only
      cheap heuristic that nudges `paradigm memory review` when native Claude
      Code memory (outside the repo at $HOME/.claude/projects/<slug>/memory/)
      looks due. Metadata only (entry count > 25, MEMORY.md bytes > 32768, days
      since .paradigm/.memory-last-review > 30, or never-reviewed + entries > 15)
      — NO LLM, NO scan, NO content reads. Appends at most one line to ADVISORY;
      NEVER touches VIOLATIONS. Fail-open on missing HOME/dir/stat: emits nothing.
    type: utility
    file: scripts/paradigm-common.sh
    tags:
      - hooks
      - memory-steward
      - advisory
      - loid

aspects:
  ~stop-hook-8-compliance-checks:
    description: |
      Stop hook blocks agent completion unless 8 checks pass:
      (1) source files modified without .purpose updates (threshold 2+),
      (2) modified directories missing .purpose files entirely,
      (3) route patterns added without portal.yaml,
      (4) aspect anchor files that no longer exist,
      (5) per-directory .purpose freshness via .pending-review,
      (6) aspect coverage advisory,
      (7) lore entry expected for 3+ source file sessions,
      (8) blocking habits not satisfied
    category: rule
    severity: critical
    tags: [hooks, compliance, enforcement]
    anchors:
      - generated-hooks.ts:7-24
    applies-to:
      - "#paradigm-hooks"

  ~pre-tool-use-auto-reindex:
    description: PreToolUse hook intercepts Bash calls matching git commit patterns and automatically runs paradigm reindex before the commit proceeds; never blocks the tool call
    category: rule
    severity: low
    tags: [hooks, reindex]
    anchors:
      - generated-hooks.ts:7-7
    applies-to:
      - "#paradigm-hooks"

  ~post-tool-use-advisory:
    description: PostToolUse hook fires after Edit/Write tool calls and emits an advisory reminder when source files are edited without nearby .purpose coverage; advisory only, never blocks
    category: rule
    severity: low
    tags: [hooks, advisory]
    anchors:
      - generated-hooks.ts:7-7
    applies-to:
      - "#paradigm-hooks"
