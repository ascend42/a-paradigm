attention:
  symbols:
    - '#*-metrics'
    - '#*-analytics'
    - '#*-dashboard'
    - '#*-tracking'
    - '#*-funnel'
  concepts:
    - metrics
    - analytics
    - funnel
    - conversion
    - retention
    - churn
    - cohort
    - A/B test
    - dashboard
    - KPI
    - activation
    - engagement
    - LTV
    - CAC
    - ARPU
    - NPS
    - drop-off
    - SQL
    - query
    - report
    - revenue
    - margin
    - P&L
    - forecast
    - trend
    - anomaly
    - benchmark
    - variance
    - ROI
    - burn rate
    - MRR
    - ARR
