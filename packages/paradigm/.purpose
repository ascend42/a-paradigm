version: 1.0.0
description: |
  @a-company/paradigm - The unified CLI for the Paradigm framework.
  Entry point for all Paradigm commands including init, sync, status, beacon, 
  constellation, ripple, thread, echo, probe, and more.

features:
  init-command:
    description: "@init-command: Initialize Paradigm in a project"
    components: [#init-handler, #template-copier, #detection-engine]
    flows: [$init-flow]
    signals: [!init-success, !init-skipped]

  sync-command:
    description: "@sync-command: Sync .paradigm/ to IDE instruction files"
    components: [#sync-handler, #ide-adapters]
    flows: [$sync-flow]

  status-command:
    description: "@status-command: Show project symbol status"
    components: [#status-handler, #symbol-counter]

  beacon-command:
    description: "@beacon-command: Generate/show beacon.md for AI orientation"
    components: [#beacon-handler, #markdown-generator]

  constellation-command:
    description: "@constellation-command: Generate symbol graph JSON/YAML"
    components: [#constellation-handler, #graph-builder]

  ripple-command:
    description: "@ripple-command: Analyze change impact"
    components: [#ripple-handler, #impact-analyzer]

  thread-command:
    description: "@thread-command: Session continuity management"
    components: [#thread-handler, #session-storage]

  echo-command:
    description: "@echo-command: Error-to-symbol mapping"
    components: [#echo-handler, #error-mapper]

  probe-command:
    description: "@probe-command: Visual discovery via screenshots"
    components: [#probe-handler, #image-processor]

  doctor-command:
    description: "@doctor-command: Health check and diagnostics"
    components: [#doctor-handler, #health-checker]

  visualize-command:
    description: "@visualize-command: Open the Prism visualizer"
    components: [#visualize-handler, #server-launcher]

components:
  init-handler:
    description: "#init-handler: Handles paradigm init command logic"
    used-by: [@init-command]

  template-copier:
    description: "#template-copier: Copies templates to project"
    used-by: [@init-command]

  detection-engine:
    description: "#detection-engine: Detects existing IDE files and project type"
    used-by: [@init-command]

  sync-handler:
    description: "#sync-handler: Handles paradigm sync command logic"
    used-by: [@sync-command]

  ide-adapters:
    description: "#ide-adapters: Adapter implementations for each IDE"
    used-by: [@sync-command]

  status-handler:
    description: "#status-handler: Handles paradigm status command"
    used-by: [@status-command]

  symbol-counter:
    description: "#symbol-counter: Counts symbols by type"
    used-by: [@status-command]

  beacon-handler:
    description: "#beacon-handler: Generates beacon.md content"
    used-by: [@beacon-command]

  markdown-generator:
    description: "#markdown-generator: Generates markdown output"
    used-by: [@beacon-command]

  constellation-handler:
    description: "#constellation-handler: Builds constellation graph"
    used-by: [@constellation-command]

  graph-builder:
    description: "#graph-builder: Builds symbol relationship graph"
    used-by: [@constellation-command]

  ripple-handler:
    description: "#ripple-handler: Performs ripple analysis"
    used-by: [@ripple-command]

  impact-analyzer:
    description: "#impact-analyzer: Analyzes upstream/downstream impact"
    used-by: [@ripple-command]

  thread-handler:
    description: "#thread-handler: Manages thread.md operations"
    used-by: [@thread-command]

  session-storage:
    description: "#session-storage: Stores session state in thread.md"
    used-by: [@thread-command]

  echo-handler:
    description: "#echo-handler: Handles echo lookups"
    used-by: [@echo-command]

  error-mapper:
    description: "#error-mapper: Maps error codes to symbols"
    used-by: [@echo-command]

  probe-handler:
    description: "#probe-handler: Handles probe command"
    used-by: [@probe-command]

  image-processor:
    description: "#image-processor: Processes screenshot input"
    used-by: [@probe-command]

  doctor-handler:
    description: "#doctor-handler: Runs health checks"
    used-by: [@doctor-command]

  health-checker:
    description: "#health-checker: Validates project setup"
    used-by: [@doctor-command]

  visualize-handler:
    description: "#visualize-handler: Launches Prism visualizer"
    used-by: [@visualize-command]

  server-launcher:
    description: "#server-launcher: Starts local HTTP server for visualizer"
    used-by: [@visualize-command]
