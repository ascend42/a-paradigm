{
  "name": "@horizon/cli",
  "version": "0.1.0",
  "description": "Unified CLI for Horizon developer tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "horizon": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@horizon/dream-core": "*",
    "@horizon/purpose-core": "*",
    "@horizon/gate-core": "*",
    "@horizon/gate-manager": "*",
    "@horizon/gate-sdk": "*",
    "@horizon/scan-core": "*",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "open": "^10.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
