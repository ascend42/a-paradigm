{
  "name": "@a-company/warpline",
  "version": "0.1.0",
  "description": "Warpline — version control for meaning (experimental). The Convergence/Divergence Oracle plus a native hash-chained fabric: pick/admit/resolve multi-writer history, a content-addressed object store, and git-absent restore.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "warpline": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@a-company/premise-core": "*",
    "commander": "^11.1.0",
    "ignore": "^5.3.2",
    "typescript": "5.9.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ascend42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-paradigm.git",
    "directory": "packages/warpline"
  },
  "bugs": {
    "url": "https://github.com/ascend42/a-paradigm/issues"
  },
  "homepage": "https://github.com/ascend42/a-paradigm#readme",
  "keywords": [
    "paradigm",
    "warpline",
    "merge",
    "oracle",
    "symbol-graph",
    "semantic-diff"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
