version: 2.0.0
description: |
  @a-company/university-core - Lean, dependency-light shared core owning the
  Paradigm University content-loading contract. ZERO @a-company dependencies
  (js-yaml + zod leaf deps only). Extracted to de-duplicate the loader / pack
  discovery / content-base probe that had drifted across paradigm-mcp, the CLI,
  and the serve server (extract-university-core spec). paradigm-mcp consumes it
  via a re-export shim.
features:
  content-loading:
    description: '@content-loading: Read/write per-project + pack-scoped university content'
    aspects:
      - ~zod-validated-sections
      - ~content-base-dual-layout
    components:
      - '#university-loader'
      - '#content-base-resolver'
  pack-discovery:
    description: '@pack-discovery: SLIM reimplemented pack manifest discovery (no portal-core drag)'
    aspects:
      - ~classifier-only-errors
    components:
      - '#pack-discovery'
      - '#pack-schema'
  logger-seam:
    description: '@logger-seam: Injected no-op-default logger so core never imports a concrete logger'
    components:
      - '#university-core-logger'
components:
  university-loader:
    description: '#university-loader: Canonical content read/write + index/search/onboard/validate. resolveContentFile rejects a content file that is a symlink or whose realpath escapes the pack root realpath (same rules as resolveSkillDirs); tested in src/__tests__/content-containment.test.ts'
  content-base-resolver:
    description: '#content-base-resolver: Dual-layout (content/ + src/content/) base probe, C4-aligned with countPackEntries'
  pack-discovery:
    description: '#pack-discovery: Slim loadPackManifest/discoverPacks/normalizeSections/resolveEntryAddress using raw js-yaml. Single source of pack discovery since v7.11 (the paradigm-mcp pack-loader duplicate was deleted). v7.11 pack.yaml v2 (PACK_SCHEMA_VERSION 2, 1 still accepted): resolveSkillDirs validates the explicit skills: list (relative, no .., realpath inside root, no symlinks at/under the dir, kebab basename, SKILL.md present, SKILL.md frontmatter metadata.paradigm.id === basename so skillCount matches what the skill loader loads) — violations skipped with classifier-only warnings, never fatal; discoverPacks attaches PackLocation.skillDirs (re-resolved on every call, never cached).'
  pack-schema:
    description: '#pack-schema: zod Section schema (canonical since v7.11 — the paradigm-mcp copy was deleted) + v7.11 PackSkillRefSchema/PackSkillsArraySchema (MAX_SKILLS_PER_PACK 64). zod 4: custom messages use the unified `error` param (pinned by src/__tests__/pack-schema-messages.test.ts)'
  university-core-logger:
    description: '#university-core-logger: UniversityCoreLogger interface + setUniversityCoreLogger + NOOP default'
  pack-discovery-tests:
    description: '#pack-discovery-tests: Regression suite for pack discovery (moved from paradigm-mcp tests/pack-loader.test.ts in v7.11) — loadPackManifest / discoverPacks / resolveEntryAddress / resolveSkillDirs containment + frontmatter-id checks; SECURITY assertion that thrown errors never leak manifest content'
    type: test
    anchors:
      - src/__tests__/pack-discovery.test.ts
    tags:
      - test
      - regression
      - security
      - university
aspects:
  ~zod-validated-sections:
    description: Section blocks validated/synthesized via the copied zod pack-schema; byte-identical to pack-loader output
    tags:
      - validation
      - sections
    applies-to:
      - '#pack-discovery'
  ~content-base-dual-layout:
    description: Content base probes content/ then src/content/, preferring the first base that contains content (C4 / T-2026-05-31-001)
    tags:
      - content-base
    applies-to:
      - '#content-base-resolver'
  ~classifier-only-errors:
    description: PackLoadError messages are classifier-only (derived from js-yaml error name) — never echo manifest body
    tags:
      - security
      - error-handling
    applies-to:
      - '#pack-discovery'
