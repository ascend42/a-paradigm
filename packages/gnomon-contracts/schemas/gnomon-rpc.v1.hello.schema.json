{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ascend42/a-paradigm/packages/gnomon-contracts/schemas/gnomon-rpc.v1.hello.schema.json",
  "title": "gnomon-rpc:v1 hello",
  "description": "hello params and result (spec §4.9). Highest shared clientApi wins; none ⇒ UNSUPPORTED{data:{offered[]}}. The result echoes clientNonce and serverSig covers it (T-2026-10-18-016).",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "clientApis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:v[1-9][0-9]*$"
          },
          "minItems": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clientNonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,86}$"
        },
        "client": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "surface": {
              "type": "string",
              "enum": [
                "browser",
                "wrapper",
                "cli",
                "conductor"
              ],
              "x-gnomon-additive": true
            },
            "conformance": {
              "type": "object",
              "properties": {
                "suite": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "reportHash": {
                  "type": "string"
                }
              },
              "required": [
                "suite",
                "version",
                "reportHash"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "clientApis",
        "features",
        "clientNonce",
        "client"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "clientApi": {
          "type": "string",
          "pattern": "^gnomon-rpc:v[1-9][0-9]*$"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "clientNonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,86}$"
        },
        "serverKeyId": {
          "type": "string",
          "minLength": 1
        },
        "serverSig": {
          "type": "string",
          "minLength": 1
        },
        "clientApiId": {
          "type": "string",
          "minLength": 1
        },
        "kitId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "clientApi",
        "features",
        "nonce",
        "clientNonce",
        "serverKeyId",
        "serverSig",
        "clientApiId",
        "kitId"
      ],
      "additionalProperties": false
    }
  }
}
