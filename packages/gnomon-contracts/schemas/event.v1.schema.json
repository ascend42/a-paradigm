    "gate-class.detected",
    "inject.receipt",
    "key.device.added",
    "key.device.revoked",
    "key.keystore.unavailable",
    "key.mint",
    "key.registry.malformed",
    "key.registry.unsigned",
    "key.rotate",
    "link.auth.fail",
    "link.brief.accepted",
    "link.brief.declined",
    "link.brief.drafted",
    "link.brief.expired",
    "link.brief.received",
    "link.brief.sent",
    "link.connect",
    "link.declassified",
    "link.disconnect",
    "link.egress.refused",
    "link.expired",
    "link.frame.refused",
    "link.msg.in",
    "link.msg.out",
    "link.pair.offered",
