    "link.scan.hit",
    "liveness.digest.consumed",
    "liveness.violation",
    "loop.closed",
    "loop.open",
    "loop.paused",
    "loop.row",
    "manifest.generate",
    "manifest.installed",
    "manifest.load",
    "manifest.refuse",
    "manifest.staged",
    "manifest.uninstall",
    "manifest.widened",
    "merge.ci",
    "merge.conflict",
    "merge.landed",
    "merge.tree",
    "mod.dev.expired",
    "mod.effect.refused",
    "mod.health",
    "mod.installed",
    "mod.linked",
    "mod.paused",
    "mod.repinned",
    "mod.rolled-back",
    "mod.sandbox",
    "mod.snapshot.refused",
    "mod.stopped",
    "mod.unlinked",
    "mod.view.rendered",
    "model.capabilities",
    "model.fallback.decided",
    "model.fallback.requested",
    "model.probe",
    "model.repair",
    "neurons.event",
    "oracle.result",
    "oracle.run",
    "paradigm.doodle.exported",
    "paradigm.event",
    "permit.deny",
    "permit.grant",
    "permit.release",
