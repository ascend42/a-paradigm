{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ascend42/a-paradigm/packages/gnomon-contracts/schemas/review-finding.v1.schema.json",
  "title": "review-finding:v1",
  "description": "Reviewer finding (spec §4.11, §7.3). severity pre-existing is kernel-set; fingerprint = sha256(class ‖ (symbol ?? path) ‖ overlapping line range). Reserved M1.1 (P8-D86–D88).",
  "x-gnomon-responses": [
    "fixed",
    "wrong",
    "intentional",
    "immaterial"
  ],
  "type": "object",
  "properties": {
    "fid": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "important",
        "nit",
        "pre-existing"
      ],
      "x-gnomon-additive": true
    },
    "locus": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(-[1-9][0-9]*)?$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(-[1-9][0-9]*)?$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "claim": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "fid",
    "round",
    "class",
    "severity",
    "locus",
    "instances",
    "claim",
    "fingerprint"
  ],
  "additionalProperties": false
}
