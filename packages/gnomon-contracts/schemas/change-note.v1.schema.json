{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ascend42/a-paradigm/packages/gnomon-contracts/schemas/change-note.v1.schema.json",
  "title": "change-note:v1",
  "description": "Change note (spec §4.11, §3.4). Two forms: $defs/claim (contract.claim{note}: agentClaims only, never a kernel part) and $defs/card (cards, contract.built, brief:v1: agentClaims + kernel). agentClaims untrusted, kernel computed. Reserved M1.1 (P8-D86–D88).",
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "agentClaims": {
          "type": "object",
          "properties": {
            "testedHow": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "x-gnomon-max-utf8-bytes": 1024
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(ev|hsid|cc|gkey|dev|permit|card|contract|node|pev|peer|turn|spec|sym|wl|n|s|td|l|t|knot|doodle):[^\\s]+$"
                  }
                }
              },
              "required": [
                "summary",
                "refs"
              ],
              "additionalProperties": false
            },
            "risk": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ],
                  "x-gnomon-additive": true
                },
                "why": {
                  "type": "string",
                  "x-gnomon-max-utf8-bytes": 512
                },
                "blast": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^sym:.+$"
                  }
                }
              },
              "required": [
                "tier",
                "why",
                "blast"
              ],
              "additionalProperties": false
            },
            "revert": {
              "type": "object",
              "properties": {
                "how": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "command",
                    "manual"
                  ],
                  "x-gnomon-additive": true
                },
                "steps": {
                  "type": "string",
                  "x-gnomon-max-utf8-bytes": 1024
                },
                "reversible": {
                  "type": "boolean"
                }
              },
              "required": [
                "how",
                "steps",
                "reversible"
              ],
              "additionalProperties": false
            },
            "draftedBy": {
              "type": "string",
              "pattern": "^p:[0-9a-hjkmnp-tv-z]{8}\\/[a-z0-9][a-z0-9._-]{0,63}(@[0-9a-f]{8})?$"
            }
          },
          "required": [
            "testedHow",
            "risk",
            "revert",
            "draftedBy"
          ],
          "additionalProperties": false,
          "x-gnomon-trust": "untrusted: agent-claimed, sanitized (§4.5), never executed, never authority (B16)"
        },
        "kernel": false
      },
      "required": [
        "agentClaims"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "agentClaims": {
          "type": "object",
          "properties": {
            "testedHow": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "x-gnomon-max-utf8-bytes": 1024
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(ev|hsid|cc|gkey|dev|permit|card|contract|node|pev|peer|turn|spec|sym|wl|n|s|td|l|t|knot|doodle):[^\\s]+$"
                  }
                }
              },
              "required": [
                "summary",
                "refs"
              ],
              "additionalProperties": false
            },
            "risk": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ],
                  "x-gnomon-additive": true
                },
                "why": {
                  "type": "string",
                  "x-gnomon-max-utf8-bytes": 512
                },
                "blast": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^sym:.+$"
                  }
                }
              },
              "required": [
                "tier",
                "why",
                "blast"
              ],
              "additionalProperties": false
            },
            "revert": {
              "type": "object",
              "properties": {
                "how": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "command",
                    "manual"
                  ],
                  "x-gnomon-additive": true
                },
                "steps": {
                  "type": "string",
                  "x-gnomon-max-utf8-bytes": 1024
                },
                "reversible": {
                  "type": "boolean"
                }
              },
              "required": [
                "how",
                "steps",
                "reversible"
              ],
              "additionalProperties": false
            },
            "draftedBy": {
              "type": "string",
              "pattern": "^p:[0-9a-hjkmnp-tv-z]{8}\\/[a-z0-9][a-z0-9._-]{0,63}(@[0-9a-f]{8})?$"
            }
          },
          "required": [
            "testedHow",
            "risk",
            "revert",
            "draftedBy"
          ],
          "additionalProperties": false,
          "x-gnomon-trust": "untrusted: agent-claimed, sanitized (§4.5), never executed, never authority (B16)"
        },
        "kernel": {
          "type": "object",
          "properties": {
            "verified": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 0
                },
                "of": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "n",
                "of"
              ],
              "additionalProperties": false
            },
            "risk": {
              "type": "object",
              "properties": {
                "floor": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ],
                  "x-gnomon-additive": true
                },
                "effective": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ],
                  "x-gnomon-additive": true
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "floor",
                "effective",
                "reasons"
              ],
              "additionalProperties": false
            },
            "revert": {
              "type": "object",
              "properties": {
                "how": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "none"
                  ],
                  "x-gnomon-additive": true
                },
                "ref": {
                  "type": "string",
                  "pattern": "^(ev|hsid|cc|gkey|dev|permit|card|contract|node|pev|peer|turn|spec|sym|wl|n|s|td|l|t|knot|doodle):[^\\s]+$"
                }
              },
              "required": [
                "how"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "verified",
            "risk",
            "revert"
          ],
          "additionalProperties": false,
          "x-gnomon-trust": "kernel-computed; never written by the agent"
        }
      },
      "required": [
        "agentClaims",
        "kernel"
      ],
      "additionalProperties": false
    }
  }
}
