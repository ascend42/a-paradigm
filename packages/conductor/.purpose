purpose: Paradigm Conductor — multimodal mission control for Claude Code sessions
version: 0.1.0
description: >-
  Voice-to-buffer, gesture editing, gaze-targeted dispatch with
  Paradigm context enrichment. Native macOS Swift/SwiftUI app
  launched via paradigm conductor CLI command.
context:
  - Native macOS Swift/SwiftUI app
  - Ships via paradigm conductor CLI command
  - 7 platform abstraction protocols for future Windows port
  - All ML inference runs locally — zero cloud, zero cost

components:
  # Sprint 0 — Foundation
  - id: "#conductor-app"
    description: Main app entry point, lifecycle, menu bar
    path: Sources/Conductor/App/
    tags: [app, lifecycle, macos]

  - id: "#conductor-panel"
    description: NSPanel floating overlay window — always-on-top, draggable, transparent
    path: Sources/Conductor/App/ConductorPanel.swift
    tags: [ui, overlay, macos]

  - id: "#permissions-onboarding"
    description: Camera/Mic/Accessibility permission request flow
    path: Sources/Conductor/App/PermissionsManager.swift
    tags: [permissions, onboarding, macos]

  # Sprint 1 — Buffer + Window Detection + Manual Send
  - id: "#text-buffer"
    description: Staged text buffer with cursor, undo/redo — convergence point for all inputs
    path: Sources/Conductor/Buffer/BufferEngine.swift
    tags: [buffer, editing]

  - id: "#cursor-navigation"
    description: Character/word/line boundary cursor movement
    path: Sources/Conductor/Buffer/BufferEngine.swift
    tags: [buffer, navigation]

  - id: "#window-detector"
    description: AXUIElement-based Claude Code instance discovery
    path: Sources/Conductor/WindowManager/ClaudeCodeDetector.swift
    tags: [window, detection, macos]

  - id: "#keyboard-input"
    description: NSTextField keyboard input handler
    path: Sources/Conductor/Input/KeyboardInput/KeyboardInputHandler.swift
    tags: [input, keyboard]

  - id: "#dispatch-target"
    description: AX text injection to targeted CC window
    path: Sources/Conductor/Dispatch/AXDispatchTarget.swift
    tags: [dispatch, accessibility, macos]

  - id: "#buffer-view"
    description: SwiftUI text buffer display with cursor
    path: Sources/Conductor/UI/Views/BufferView.swift
    tags: [ui, buffer]

  - id: "#instance-list-view"
    description: SwiftUI list of detected CC instances
    path: Sources/Conductor/UI/Views/InstanceListView.swift
    tags: [ui, instances]

  # Sprint 2 — Voice Input
  - id: "#whisper-voice-provider"
    description: WhisperKit speech-to-text implementation
    path: Sources/Conductor/Input/VoiceInput/WhisperVoiceProvider.swift
    tags: [voice, whisperkit, coreml]

  - id: "#audio-capture"
    description: AVCaptureSession microphone pipeline
    path: Sources/Conductor/Input/VoiceInput/AudioCapture.swift
    tags: [voice, audio, avfoundation]

  # Sprint 3 — Hand Gestures
  - id: "#vision-gesture-provider"
    description: Apple Vision hand pose detection
    path: Sources/Conductor/Input/GestureInput/VisionGestureProvider.swift
    tags: [gesture, vision, neural-engine]

  - id: "#gesture-classifier"
    description: Joint positions → GestureAction mapping
    path: Sources/Conductor/Input/GestureInput/GestureClassifier.swift
    tags: [gesture, classification]

  - id: "#gesture-state-machine"
    description: Debounce, cooldowns, state transitions
    path: Sources/Conductor/Input/GestureInput/GestureStateMachine.swift
    tags: [gesture, state-machine]

  - id: "#gesture-hud"
    description: Hand state + gesture feedback overlay
    path: Sources/Conductor/UI/Views/GestureHUDView.swift
    tags: [ui, gesture, feedback]

  # Sprint 4 — Gaze Tracking
  - id: "#mediapipe-gaze-provider"
    description: MediaPipe FaceMesh gaze estimation
    path: Sources/Conductor/Input/GazeInput/MediaPipeGazeProvider.swift
    tags: [gaze, mediapipe, python]

  - id: "#gaze-calibration"
    description: 5-point calibration flow
    path: Sources/Conductor/Input/GazeInput/GazeCalibration.swift
    tags: [gaze, calibration]

  - id: "#kalman-filter"
    description: Gaze coordinate smoothing
    path: Sources/Conductor/Input/GazeInput/KalmanFilter.swift
    tags: [gaze, filter, math]

  - id: "#gaze-router"
    description: Gaze point → target window mapping
    path: Sources/Conductor/Dispatch/GazeRouter.swift
    tags: [gaze, dispatch, targeting]

  # Sprint 5 — Context Enrichment
  - id: "#paradigm-mcp-client"
    description: Spawn paradigm-mcp, call tools via stdio JSON-RPC
    path: Sources/Conductor/Integration/ParadigmMCPClient.swift
    tags: [integration, mcp, json-rpc]

  - id: "#git-monitor"
    description: Poll git diff for project context
    path: Sources/Conductor/Integration/GitMonitor.swift
    tags: [integration, git]

  - id: "#context-enricher"
    description: Assemble Paradigm + git context for dispatch
    path: Sources/Conductor/Dispatch/ContextEnricher.swift
    tags: [dispatch, context, enrichment]

  - id: "#sentinel-ws-client"
    description: WebSocket client for Sentinel events
    path: Sources/Conductor/Integration/SentinelWSClient.swift
    tags: [integration, sentinel, websocket]

  # Sprint 6 — Window Management + Status
  - id: "#window-arranger"
    description: Tile/snap/layout CC windows
    path: Sources/Conductor/WindowManager/WindowArranger.swift
    tags: [window, layout, tiling]

  - id: "#status-tracker"
    description: Poll CC windows for idle/processing/finished
    path: Sources/Conductor/WindowManager/StatusTracker.swift
    tags: [window, status, monitoring]

  - id: "#notification-bubble"
    description: Per-instance status bubble overlay
    path: Sources/Conductor/UI/Views/NotificationBubbleView.swift
    tags: [ui, notification, status]

  # Sprint 7 — Polish & Distribution
  - id: "#settings-panel"
    description: "Preferences: hotkeys, gestures, enrichment"
    path: Sources/Conductor/UI/Views/SettingsPanelView.swift
    tags: [ui, settings, preferences]

  - id: "#hotkey-manager"
    description: Global hotkey registration
    path: Sources/Conductor/Utils/HotKeyManager.swift
    tags: [input, hotkeys, cgevent]

flows:
  - id: "$voice-to-dispatch"
    description: "Mic → WhisperKit → Buffer → Edit → Enrich → Dispatch"
    steps:
      - "#audio-capture"
      - "#whisper-voice-provider"
      - "#text-buffer"
      - "#context-enricher"
      - "#dispatch-target"

  - id: "$gesture-edit"
    description: "Camera → Vision → Classify → Buffer edit action"
    steps:
      - "#vision-gesture-provider"
      - "#gesture-classifier"
      - "#gesture-state-machine"
      - "#text-buffer"

  - id: "$gaze-target"
    description: "Camera → MediaPipe → Iris → Screen point → Window match → Target"
    steps:
      - "#mediapipe-gaze-provider"
      - "#kalman-filter"
      - "#gaze-router"
      - "#window-detector"

  - id: "$context-enrichment"
    description: "Buffer flush → MCP status + search + history → Git diff → Enriched payload"
    steps:
      - "#text-buffer"
      - "#paradigm-mcp-client"
      - "#git-monitor"
      - "#context-enricher"
      - "#dispatch-target"

  - id: "$window-tiling"
    description: "User hotkey → Layout selection → AX setFrame per window"
    steps:
      - "#hotkey-manager"
      - "#window-arranger"
      - "#window-detector"

gates:
  - id: "^camera-permission"
    description: Camera access granted via macOS permissions
    check: "AVCaptureDevice.authorizationStatus(for: .video) == .authorized"

  - id: "^microphone-permission"
    description: Microphone access granted via macOS permissions
    check: "AVCaptureDevice.authorizationStatus(for: .audio) == .authorized"

  - id: "^accessibility-permission"
    description: Accessibility API access granted (required for window management)
    check: "AXIsProcessTrusted()"

  - id: "^model-downloaded"
    description: WhisperKit model downloaded and ready
    check: "FileManager.default.fileExists(atPath: modelPath)"

  - id: "^gaze-calibrated"
    description: Gaze tracking calibration completed
    check: "calibrationData.hasCalibration"

  - id: "^mcp-available"
    description: paradigm-mcp reachable for context enrichment
    check: "mcpClient.isConnected"

signals:
  - id: "!buffer-dispatched"
    description: Text buffer sent to a targeted CC window
  - id: "!instance-detected"
    description: New Claude Code instance discovered
  - id: "!instance-lost"
    description: Claude Code instance closed/disappeared
  - id: "!transcription-ready"
    description: Voice transcription finalized in buffer
  - id: "!gesture-recognized"
    description: Hand gesture classified and applied
  - id: "!gaze-target-changed"
    description: Gaze shifted to a different CC window
  - id: "!context-enriched"
    description: Paradigm context attached to dispatch
  - id: "!status-changed"
    description: CC instance status changed (idle→processing→finished)
  - id: "!agent-count-changed"
    description: Sub-agent count changed for an instance
  - id: "!layout-applied"
    description: Window tiling layout applied

aspects:
  - id: "~local-only"
    description: All ML inference and camera processing runs locally — no cloud services
    anchors:
      - Sources/Conductor/Input/VoiceInput/VoiceInputProvider.swift:1
      - Sources/Conductor/Input/GestureInput/GestureInputProvider.swift:1
      - Sources/Conductor/Input/GazeInput/GazeTrackingProvider.swift:1

  - id: "~zero-cost"
    description: No paid APIs, no subscriptions, no usage fees — all open-source ML models
    anchors:
      - Package.swift:1

  - id: "~platform-abstracted"
    description: 7 protocols isolate platform-specific code for future Windows portability
    anchors:
      - Sources/Conductor/Input/InputProvider.swift:1
      - Sources/Conductor/Input/VoiceInput/VoiceInputProvider.swift:1
      - Sources/Conductor/Input/GestureInput/GestureInputProvider.swift:1
      - Sources/Conductor/Input/GazeInput/GazeTrackingProvider.swift:1
      - Sources/Conductor/WindowManager/ClaudeCodeDetectorProtocol.swift:1
      - Sources/Conductor/WindowManager/WindowArrangerProtocol.swift:1
      - Sources/Conductor/Dispatch/DispatchTargetProtocol.swift:1

  - id: "~resource-conscious"
    description: CPU/RAM budgets enforced, auto-throttle under load
    anchors:
      - Sources/Conductor/UI/Views/SettingsPanelView.swift:1

protocols:
  voice_input: Sources/Conductor/Input/VoiceInput/VoiceInputProvider.swift
  gesture_input: Sources/Conductor/Input/GestureInput/GestureInputProvider.swift
  gaze_tracking: Sources/Conductor/Input/GazeInput/GazeTrackingProvider.swift
  window_detector: Sources/Conductor/WindowManager/ClaudeCodeDetectorProtocol.swift
  window_arranger: Sources/Conductor/WindowManager/WindowArrangerProtocol.swift
  dispatch_target: Sources/Conductor/Dispatch/DispatchTargetProtocol.swift
  context_enricher: Sources/Conductor/Dispatch/ContextEnricherProtocol.swift

tags:
  - conductor
  - macos
  - multimodal
  - voice
  - gesture
  - gaze
  - overlay
