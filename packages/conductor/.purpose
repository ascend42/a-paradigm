# ============================================
# Flows ($)
# ============================================

flows:
  voice-to-dispatch:
    description: Mic to WhisperKit to Buffer to Edit to Enrich to Dispatch
    steps:
      - "#audio-capture"
      - "#whisper-voice-provider"
      - "#text-buffer"
      - "#context-enricher"
      - "#dispatch-target"
  eyebrow-voice-control:
    description: "Eyebrow raise → voice record → WhisperKit → buffer → dispatch"
    steps:
      - "#eyebrow-detector"
      - "#eyebrow-state-machine"
      - "#voice-control-coordinator"
      - "#whisper-voice-provider"
      - "#text-buffer"
      - "#dispatch-target"
  gesture-edit:
    description: Camera to Vision to Classify to Buffer edit action
    steps:
      - "#vision-gesture-provider"
      - "#gesture-classifier"
      - "#gesture-state-machine"
      - "#text-buffer"
  gaze-target:
    description: Camera to Vision face landmarks to Pupil to Calibration to Screen point to Window match to Target
    steps:
      - "#vision-gaze-provider"
      - "#gaze-calibration"
      - "#kalman-filter"
      - "#gaze-router"
      - "#window-detector"
  gaze-dispatch:
    description: "Gaze → grid cell → right eyebrow → dispatch to cell's instance"
    steps:
      - "#vision-gaze-provider"
      - "#gaze-zone-router"
      - "#workspace-grid"
      - "#eyebrow-detector"
      - "#dispatch-target"
  workspace-launch:
    description: "Add button → terminal launched → window positioned → registered"
    steps:
      - "#workspace-view"
      - "#terminal-launcher"
      - "#workspace-manager"
      - "#workspace-grid"
      - "#window-arranger"
  voice-dispatch-flow:
    description: "Eyebrow → record → transcribe → voice command check → buffer → dispatch"
    steps:
      - "#eyebrow-detector"
      - "#voice-control-coordinator"
      - "#whisper-voice-provider"
      - "#voice-command-matcher"
      - "#text-buffer"
      - "#dispatch-target"
  custom-gesture-flow:
    description: "Record → template → runtime DTW match → action"
    steps:
      - "#gesture-recorder"
      - "#gesture-template"
      - "#dtw-matcher"
      - "#custom-gesture-classifier"
      - "#action-registry"
  voice-command-flow:
    description: "Transcription → phrase match → extract command → fire action + buffer remainder"
    steps:
      - "#whisper-voice-provider"
      - "#voice-command-matcher"
      - "#voice-command-registry"
      - "#input-orchestrator"
  orchestrator-startup:
    description: "App launch → read preferences → create providers → wire shared camera → start → UI ready"
    steps:
      - "#conductor-app"
      - "#input-orchestrator"
      - "#shared-camera"
      - "#workspace-manager"
      - "#vision-gaze-provider"
      - "#vision-gesture-provider"
      - "#whisper-voice-provider"
  context-enrichment:
    description: Buffer flush to MCP status + search + history to Git diff to Enriched payload
    steps:
      - "#text-buffer"
      - "#paradigm-mcp-client"
      - "#git-monitor"
      - "#context-enricher"
      - "#dispatch-target"
  session-registration:
    description: Auto-register on MCP startup (or /conduct) to JSON file to SessionFileWatcher to merged instance list
    signals:
      - "!session-registered"
      - "!session-unregistered"
    components:
      - "#session-file-watcher"
      - "#window-detector"
      - "#instance-list-view"
  setup-flow:
    description: Feature selection to dependency checks to model download to gaze calibration to ready
    steps:
      - "#setup-wizard"
      - "#dependency-checker"
      - "#whisper-voice-provider"
      - "#gaze-calibration"
  window-tiling:
    description: User hotkey to Layout selection to AX setFrame per window
    steps:
      - "#hotkey-manager"
      - "#window-arranger"
      - "#window-detector"
  # --- Symphony Phase 1-2 Flows ---
  $symphony-auto-link:
    description: "CC detected → resolve project dir → derive agent ID → part created → relay starts"
    steps:
      - "#auto-link-coordinator"
      - "#agent-part-manager"
      - "#score-io"
      - "#note-relay"
  $symphony-relay:
    description: "Outbox → relay polls on 5s timer → routes to inbox → agent polls → dedup"
    steps:
      - "#note-relay"
      - "#score-io"
  $symphony-file-approval:
    description: "File request detected → notification banner → user approve/deny → file delivery"
    steps:
      - "#file-approval-manager"
      - "#file-request-notification"
      - "#score-io"
  $symphony-voice-approve:
    description: "Voice transcription → 'approve' keyword matched → file approval triggered → delivery"
    steps:
      - "#file-approval-manager"
      - "#score-io"
  $symphony-startup:
    description: "App launch → part manager init → auto-link coordinator scans → relay starts"
    steps:
      - "#agent-part-manager"
      - "#auto-link-coordinator"
      - "#note-relay"

# ============================================
# Gates (^)
# ============================================

gates:
  camera-permission:
    description: Camera access granted via macOS permissions
    check: "AVCaptureDevice.authorizationStatus(for: .video) == .authorized"
  microphone-permission:
    description: Microphone access granted via macOS permissions
    check: "AVCaptureDevice.authorizationStatus(for: .audio) == .authorized"
  accessibility-permission:
    description: Accessibility API access granted (required for window management)
    check: "AXIsProcessTrusted()"
  model-downloaded:
    description: WhisperKit model downloaded and ready
    check: "FileManager.default.fileExists(atPath: modelPath)"
  gaze-calibrated:
    description: Gaze tracking calibration completed
    check: "calibrationData.hasCalibration"
  mcp-available:
    description: paradigm-mcp reachable for context enrichment
    check: "mcpClient.isConnected"
  providers-ready:
    description: All user-enabled input providers have started successfully
    check: "orchestrator.isRunning"
  conductor-launched:
    description: Only Conductor-owned instances get primary grid treatment
    check: "workspaceManager.managedInstances.contains(instance)"
  # --- Symphony Phase 1-2 Gates ---
  ^symphony-enabled:
    description: Auto-link enabled in Symphony settings
    check: "UserDefaults.standard.bool(forKey: 'symphonyAutoLink')"
  ^file-request-allowed:
    description: File path passes trust config deny-lists and auto-approve globs
    check: "FileApprovalManager.isPathAllowed(path, trustConfig)"

# ============================================
# Signals (!)
# ============================================

signals:
  buffer-dispatched:
    description: Text buffer sent to a targeted CC window
  instance-detected:
    description: New Claude Code instance discovered
  instance-lost:
    description: Claude Code instance closed/disappeared
  transcription-ready:
    description: Voice transcription finalized in buffer
  gesture-recognized:
    description: Hand gesture classified and applied
  gaze-target-changed:
    description: Gaze shifted to a different CC window
  context-enriched:
    description: Paradigm context attached to dispatch
  status-changed:
    description: CC instance status changed (idle to processing to finished)
  agent-count-changed:
    description: Sub-agent count changed for an instance
  layout-applied:
    description: Window tiling layout applied
  calibration-complete:
    description: Gaze calibration 5-point collection finished
    emitters: ["#gaze-calibration"]
  session-registered:
    description: Claude Code session registered via /conduct or paradigm_conductor_register MCP tool
    emitters: ["#session-file-watcher"]
  session-unregistered:
    description: Claude Code session unregistered from Conductor
    emitters: ["#session-file-watcher"]
  eyebrow-raise-left:
    description: Left eyebrow raised above threshold
    emitters: ["#eyebrow-detector"]
  eyebrow-raise-right:
    description: Right eyebrow raised above threshold
    emitters: ["#eyebrow-detector"]
  voice-recording-started:
    description: Voice recording started via eyebrow trigger
    emitters: ["#voice-control-coordinator"]
  voice-recording-stopped:
    description: Voice recording stopped via eyebrow trigger
    emitters: ["#voice-control-coordinator"]
  voice-dispatch-complete:
    description: Full voice pipeline complete — transcribed and ready to send
    emitters: ["#voice-control-coordinator"]
  instance-launched:
    description: New CC instance launched via workspace manager
    emitters: ["#workspace-manager"]
  instance-closed:
    description: Managed CC instance closed or terminated
    emitters: ["#workspace-manager"]
  layout-changed:
    description: Workspace grid layout rearranged
    emitters: ["#workspace-manager"]
  custom-gesture-recognized:
    description: User-recorded custom gesture matched via DTW
    emitters: ["#custom-gesture-classifier"]
  voice-command-matched:
    description: Voice command phrase detected in transcription
    emitters: ["#input-orchestrator"]
  eyebrow-calibration-complete:
    description: Eyebrow calibration thresholds applied to detector
    emitters: ["#conductor-app"]
  video-toggled:
    description: Video (gaze+gesture camera) toggled on or off via UI or hotkey
    emitters: ["#input-orchestrator"]
  voice-toggled:
    description: Voice (mic) toggled on or off via UI or hotkey
    emitters: ["#input-orchestrator"]
  # --- Symphony Phase 1-2 Signals ---
  !agent-part-created:
    description: New agent part registered in The Score
    emitters: ["#agent-part-manager", "#auto-link-coordinator"]
  !agent-auto-linked:
    description: CC session auto-detected and linked as agent part
    emitters: ["#auto-link-coordinator"]
  !agent-auto-unlinked:
    description: CC session disappeared and agent part unregistered
    emitters: ["#auto-link-coordinator"]
  !note-relayed:
    description: One or more notes relayed from outboxes to inboxes
    emitters: ["#note-relay"]
  !file-request-received:
    description: Incoming file request detected for approval
    emitters: ["#file-approval-manager"]
  !file-request-approved:
    description: File request approved and file delivered
    emitters: ["#file-approval-manager"]
  !file-request-denied:
    description: File request denied by user or trust config
    emitters: ["#file-approval-manager"]
  !symphony-relay-started:
    description: Note relay polling loop has started
    emitters: ["#note-relay"]

# ============================================
# Aspects (~)
# ============================================

~local-only:
  description: All ML inference and camera processing runs locally — no cloud services
  anchors:
    - Sources/Conductor/Input/VoiceInput/VoiceInputProvider.swift:1
    - Sources/Conductor/Input/GestureInput/GestureInputProvider.swift:1
    - Sources/Conductor/Input/GazeInput/GazeTrackingProvider.swift:1

~zero-cost:
  description: No paid APIs, no subscriptions, no usage fees — all open-source ML models
  anchors:
    - Package.swift:1

~platform-abstracted:
  description: 7 protocols isolate platform-specific code for future Windows portability
  anchors:
    - Sources/Conductor/Input/InputProvider.swift:1
    - Sources/Conductor/Input/VoiceInput/VoiceInputProvider.swift:1
    - Sources/Conductor/Input/GestureInput/GestureInputProvider.swift:1
    - Sources/Conductor/Input/GazeInput/GazeTrackingProvider.swift:1
    - Sources/Conductor/WindowManager/ClaudeCodeDetectorProtocol.swift:1
    - Sources/Conductor/WindowManager/WindowArrangerProtocol.swift:1
    - Sources/Conductor/Dispatch/DispatchTargetProtocol.swift:1

~resource-conscious:
  description: CPU/RAM budgets enforced, auto-throttle under load
  anchors:
    - Sources/Conductor/UI/Views/SettingsPanelView.swift:1

~single-owner:
  description: Each stateful component has exactly one lifecycle owner — AppDelegate owns orchestrator and workspace
  anchors:
    - Sources/Conductor/App/AppDelegate.swift:1

~zone-deterministic:
  description: Gaze uses cell boundaries, not arbitrary window bounds — eliminates jitter via discrete grid cells
  anchors:
    - Sources/Conductor/Dispatch/GazeZoneRouter.swift:1

~user-configurable:
  description: All input-to-action mappings are user-overridable via ActionRegistry, VoiceCommandRegistry, and custom gestures
  anchors:
    - Sources/Conductor/Orchestration/ActionRegistry.swift:1
    - Sources/Conductor/Input/VoiceCommand/VoiceCommandRegistry.swift:1
    - Sources/Conductor/UI/Views/BindingsManagerView.swift:1

# --- Symphony Phase 1-2 Aspects ---

~jsonl-compatible:
  description: Swift Codable output is byte-compatible with TypeScript JSON.stringify — no pretty-print, consistent key ordering
  anchors:
    - Sources/Conductor/Symphony/SymphonyTypes.swift:1
    - Sources/Conductor/Symphony/ScoreIO.swift:1

~file-safety:
  description: Path traversal checks + trust deny-lists block dangerous file access (.env, .key, .pem, credentials, secrets)
  anchors:
    - Sources/Conductor/Symphony/FileApprovalManager.swift:1

tags:
  - conductor
  - macos
  - multimodal
  - voice
  - gesture
  - gaze
  - overlay
  - symphony
