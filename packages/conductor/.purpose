purpose: Paradigm Conductor — multimodal mission control for Claude Code sessions
version: 0.2.1
description: Voice-to-buffer, gesture editing, gaze-targeted dispatch with Paradigm context enrichment. Native macOS Swift/SwiftUI app launched via paradigm conductor CLI command.
context:
  - Native macOS Swift/SwiftUI app
  - Ships via paradigm conductor CLI command
  - 7 platform abstraction protocols for future Windows port
  - All ML inference runs locally — zero cloud, zero cost

# ============================================
# Components (#)
# ============================================

#conductor-app:
  description: Main app entry point, lifecycle, menu bar
  tags: [app, lifecycle, macos]
  anchors:
    - Sources/Conductor/App/:1

#conductor-panel:
  description: NSPanel floating overlay window — always-on-top, draggable, transparent
  tags: [ui, overlay, macos]
  anchors:
    - Sources/Conductor/App/ConductorPanel.swift:1

#permissions-onboarding:
  description: Camera/Mic/Accessibility permission request flow
  tags: [permissions, onboarding, macos]
  anchors:
    - Sources/Conductor/App/PermissionsManager.swift:1

#text-buffer:
  description: Staged text buffer with cursor, undo/redo — convergence point for all inputs
  tags: [buffer, editing]
  anchors:
    - Sources/Conductor/Buffer/BufferEngine.swift:1

#cursor-navigation:
  description: Character/word/line boundary cursor movement
  tags: [buffer, navigation]
  anchors:
    - Sources/Conductor/Buffer/BufferEngine.swift:1

#window-detector:
  description: AXUIElement-based Claude Code instance discovery
  tags: [window, detection, macos]
  anchors:
    - Sources/Conductor/WindowManager/ClaudeCodeDetector.swift:1

#session-file-watcher:
  description: Watches ~/.conductor/sessions/ for registration files from /conduct or paradigm_conductor_register
  tags: [window, detection, file-watcher, registration]
  anchors:
    - Sources/Conductor/WindowManager/SessionFileWatcher.swift:1

#keyboard-input:
  description: NSTextField keyboard input handler
  tags: [input, keyboard]
  anchors:
    - Sources/Conductor/Input/KeyboardInput/KeyboardInputHandler.swift:1

#dispatch-target:
  description: AX text injection to targeted CC window
  tags: [dispatch, accessibility, macos]
  anchors:
    - Sources/Conductor/Dispatch/AXDispatchTarget.swift:1

#buffer-view:
  description: SwiftUI text buffer display with cursor
  tags: [ui, buffer]
  anchors:
    - Sources/Conductor/UI/Views/BufferView.swift:1

#instance-list-view:
  description: SwiftUI list of detected CC instances
  tags: [ui, instances]
  anchors:
    - Sources/Conductor/UI/Views/InstanceListView.swift:1

#whisper-voice-provider:
  description: WhisperKit speech-to-text — real CoreML transcription via WhisperKit 0.16.0
  tags: [voice, whisperkit, coreml]
  anchors:
    - Sources/Conductor/Input/VoiceInput/WhisperVoiceProvider.swift:1

#audio-capture:
  description: AVCaptureSession microphone pipeline
  tags: [voice, audio, avfoundation]
  anchors:
    - Sources/Conductor/Input/VoiceInput/AudioCapture.swift:1

#vision-gesture-provider:
  description: Apple Vision hand pose detection
  tags: [gesture, vision, neural-engine]
  anchors:
    - Sources/Conductor/Input/GestureInput/VisionGestureProvider.swift:1

#gesture-classifier:
  description: Joint positions to GestureAction mapping
  tags: [gesture, classification]
  anchors:
    - Sources/Conductor/Input/GestureInput/GestureClassifier.swift:1

#gesture-state-machine:
  description: Debounce, cooldowns, state transitions
  tags: [gesture, state-machine]
  anchors:
    - Sources/Conductor/Input/GestureInput/GestureStateMachine.swift:1

#gesture-hud:
  description: Hand state + gesture feedback overlay
  tags: [ui, gesture, feedback]
  anchors:
    - Sources/Conductor/UI/Views/GestureHUDView.swift:1

#mediapipe-gaze-provider:
  description: MediaPipe FaceMesh gaze estimation
  tags: [gaze, mediapipe, python]
  anchors:
    - Sources/Conductor/Input/GazeInput/MediaPipeGazeProvider.swift:1

#gaze-calibration:
  description: 5-point calibration — math, fullscreen overlay UI, and window controller
  tags: [gaze, calibration, ui]
  anchors:
    - Sources/Conductor/Input/GazeInput/GazeCalibration.swift:1
    - Sources/Conductor/UI/Views/GazeCalibrationView.swift:1
    - Sources/Conductor/UI/CalibrationWindowController.swift:1

#kalman-filter:
  description: Gaze coordinate smoothing
  tags: [gaze, filter, math]
  anchors:
    - Sources/Conductor/Input/GazeInput/KalmanFilter.swift:1

#gaze-router:
  description: Gaze point to target window mapping
  tags: [gaze, dispatch, targeting]
  anchors:
    - Sources/Conductor/Dispatch/GazeRouter.swift:1

#paradigm-mcp-client:
  description: Spawn paradigm-mcp, call tools via stdio JSON-RPC
  tags: [integration, mcp, json-rpc]
  anchors:
    - Sources/Conductor/Integration/ParadigmMCPClient.swift:1

#git-monitor:
  description: Poll git diff for project context
  tags: [integration, git]
  anchors:
    - Sources/Conductor/Integration/GitMonitor.swift:1

#context-enricher:
  description: Assemble Paradigm + git context for dispatch
  tags: [dispatch, context, enrichment]
  anchors:
    - Sources/Conductor/Dispatch/ContextEnricher.swift:1

#sentinel-ws-client:
  description: WebSocket client for Sentinel events
  tags: [integration, sentinel, websocket]
  anchors:
    - Sources/Conductor/Integration/SentinelWSClient.swift:1

#window-arranger:
  description: Tile/snap/layout CC windows
  tags: [window, layout, tiling]
  anchors:
    - Sources/Conductor/WindowManager/WindowArranger.swift:1

#status-tracker:
  description: Poll CC windows for idle/processing/finished
  tags: [window, status, monitoring]
  anchors:
    - Sources/Conductor/WindowManager/StatusTracker.swift:1

#notification-bubble:
  description: Per-instance status bubble overlay
  tags: [ui, notification, status]
  anchors:
    - Sources/Conductor/UI/Views/NotificationBubbleView.swift:1

#setup-wizard:
  description: Multi-step setup wizard — feature selection, dependency checking, model picker, gaze calibration
  tags: [ui, setup, onboarding]
  anchors:
    - Sources/Conductor/UI/Views/SetupWizardView.swift:1

#dependency-checker:
  description: Checks Python 3, MediaPipe/OpenCV, and downloads WhisperKit models during setup
  tags: [setup, dependencies]
  anchors:
    - Sources/Conductor/Utils/DependencyChecker.swift:1

#gaze-cursor:
  description: Transparent click-through overlay showing gaze position dot for debug visualization
  tags: [ui, gaze, debug, overlay]
  anchors:
    - Sources/Conductor/UI/GazeCursorController.swift:1

#conductor-models:
  description: Shared data types — ClaudeCodeInstance, EnrichedPayload, GestureAction, HandState
  tags: [models, types]
  anchors:
    - Sources/Conductor/Models/:1

#conductor-log:
  description: Structured logging via os.Logger with symbol-based categories
  tags: [logging, diagnostics]
  anchors:
    - Sources/Conductor/Utils/ConductorLog.swift:1

#main-overlay:
  description: Root SwiftUI view composing onboarding, buffer, instance list, calibration banner, gaze cursor
  tags: [ui, layout, root]
  anchors:
    - Sources/Conductor/UI/Views/MainOverlayView.swift:1

#settings-panel:
  description: "Preferences: hotkeys, gestures, enrichment, gaze overlay toggle, recalibrate button, setup wizard trigger"
  tags: [ui, settings, preferences]
  anchors:
    - Sources/Conductor/UI/Views/SettingsPanelView.swift:1

#hotkey-manager:
  description: Global hotkey registration
  tags: [input, hotkeys, cgevent]
  anchors:
    - Sources/Conductor/Utils/HotKeyManager.swift:1

# ============================================
# Flows ($)
# ============================================

flows:
  voice-to-dispatch:
    description: Mic to WhisperKit to Buffer to Edit to Enrich to Dispatch
    steps:
      - "#audio-capture"
      - "#whisper-voice-provider"
      - "#text-buffer"
      - "#context-enricher"
      - "#dispatch-target"
  gesture-edit:
    description: Camera to Vision to Classify to Buffer edit action
    steps:
      - "#vision-gesture-provider"
      - "#gesture-classifier"
      - "#gesture-state-machine"
      - "#text-buffer"
  gaze-target:
    description: Camera to MediaPipe to Iris to Calibration to Screen point to Window match to Target
    steps:
      - "#mediapipe-gaze-provider"
      - "#gaze-calibration"
      - "#kalman-filter"
      - "#gaze-router"
      - "#window-detector"
  context-enrichment:
    description: Buffer flush to MCP status + search + history to Git diff to Enriched payload
    steps:
      - "#text-buffer"
      - "#paradigm-mcp-client"
      - "#git-monitor"
      - "#context-enricher"
      - "#dispatch-target"
  session-registration:
    description: Auto-register on MCP startup (or /conduct) to JSON file to SessionFileWatcher to merged instance list
    signals:
      - "!session-registered"
      - "!session-unregistered"
    components:
      - "#session-file-watcher"
      - "#window-detector"
      - "#instance-list-view"
  setup-flow:
    description: Feature selection to dependency checks to model download to gaze calibration to ready
    steps:
      - "#setup-wizard"
      - "#dependency-checker"
      - "#whisper-voice-provider"
      - "#gaze-calibration"
  window-tiling:
    description: User hotkey to Layout selection to AX setFrame per window
    steps:
      - "#hotkey-manager"
      - "#window-arranger"
      - "#window-detector"

# ============================================
# Gates (^)
# ============================================

gates:
  camera-permission:
    description: Camera access granted via macOS permissions
    check: "AVCaptureDevice.authorizationStatus(for: .video) == .authorized"
  microphone-permission:
    description: Microphone access granted via macOS permissions
    check: "AVCaptureDevice.authorizationStatus(for: .audio) == .authorized"
  accessibility-permission:
    description: Accessibility API access granted (required for window management)
    check: "AXIsProcessTrusted()"
  model-downloaded:
    description: WhisperKit model downloaded and ready
    check: "FileManager.default.fileExists(atPath: modelPath)"
  gaze-calibrated:
    description: Gaze tracking calibration completed
    check: "calibrationData.hasCalibration"
  mcp-available:
    description: paradigm-mcp reachable for context enrichment
    check: "mcpClient.isConnected"

# ============================================
# Signals (!)
# ============================================

signals:
  buffer-dispatched:
    description: Text buffer sent to a targeted CC window
  instance-detected:
    description: New Claude Code instance discovered
  instance-lost:
    description: Claude Code instance closed/disappeared
  transcription-ready:
    description: Voice transcription finalized in buffer
  gesture-recognized:
    description: Hand gesture classified and applied
  gaze-target-changed:
    description: Gaze shifted to a different CC window
  context-enriched:
    description: Paradigm context attached to dispatch
  status-changed:
    description: CC instance status changed (idle to processing to finished)
  agent-count-changed:
    description: Sub-agent count changed for an instance
  layout-applied:
    description: Window tiling layout applied
  calibration-complete:
    description: Gaze calibration 5-point collection finished
    emitters: ["#gaze-calibration"]
  session-registered:
    description: Claude Code session registered via /conduct or paradigm_conductor_register MCP tool
    emitters: ["#session-file-watcher"]
  session-unregistered:
    description: Claude Code session unregistered from Conductor
    emitters: ["#session-file-watcher"]

# ============================================
# Aspects (~)
# ============================================

~local-only:
  description: All ML inference and camera processing runs locally — no cloud services
  anchors:
    - Sources/Conductor/Input/VoiceInput/VoiceInputProvider.swift:1
    - Sources/Conductor/Input/GestureInput/GestureInputProvider.swift:1
    - Sources/Conductor/Input/GazeInput/GazeTrackingProvider.swift:1

~zero-cost:
  description: No paid APIs, no subscriptions, no usage fees — all open-source ML models
  anchors:
    - Package.swift:1

~platform-abstracted:
  description: 7 protocols isolate platform-specific code for future Windows portability
  anchors:
    - Sources/Conductor/Input/InputProvider.swift:1
    - Sources/Conductor/Input/VoiceInput/VoiceInputProvider.swift:1
    - Sources/Conductor/Input/GestureInput/GestureInputProvider.swift:1
    - Sources/Conductor/Input/GazeInput/GazeTrackingProvider.swift:1
    - Sources/Conductor/WindowManager/ClaudeCodeDetectorProtocol.swift:1
    - Sources/Conductor/WindowManager/WindowArrangerProtocol.swift:1
    - Sources/Conductor/Dispatch/DispatchTargetProtocol.swift:1

~resource-conscious:
  description: CPU/RAM budgets enforced, auto-throttle under load
  anchors:
    - Sources/Conductor/UI/Views/SettingsPanelView.swift:1

tags:
  - conductor
  - macos
  - multimodal
  - voice
  - gesture
  - gaze
  - overlay
