{
  "manifest": 2,
  "kind": "mod",
  "publisher": "gnomon",
  "name": "workshop",
  "version": "1.1.0",
  "abi": "mod-abi:v1",
  "description": "The Workshop (spec §11.6): needs-you caps per pending card and working caps per session, every attribute from kernel events.",
