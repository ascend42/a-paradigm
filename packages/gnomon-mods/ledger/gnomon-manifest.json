{
  "manifest": 1,
  "kind": "mod",
  "name": "ledger",
  "version": "1.0.0",
  "abi": "mod-abi:v1",
  "description": "The Ledger: a context and budget meter (tokens in and out, cache share, cost, compactions, budget rungs and breakers), every number from the kernel's numbers-only feed.",
  "provides": {
    "views": [
      { "id": "ledger.strip", "slot": "composer.footer", "placement": "append", "fixtures": ["fixtures/strip.json", "fixtures/strip-reduced.json", "fixtures/over-budget.json", "fixtures/breaker.json"] },
      { "id": "ledger.sheet", "slot": "sidebar", "placement": "append", "fixtures": ["fixtures/compacted.json"] }
    ]
  },
  "requires": { "capabilities": ["log.read"], "egress": "none" }
}
