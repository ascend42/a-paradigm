{
  "manifest": 1,
  "kind": "mod",
  "name": "hello",
  "version": "1.0.0",
  "abi": "mod-abi:v1",
  "description": "The example mod (spec §12.4): one view, one command, one read-only tool and a per-mod counter in state.",
  "provides": {
    "tools": [
      { "name": "hello.greet", "effects": ["read"] },
      { "name": "hello.count", "effects": ["read", "write"] }
    ],
    "views": [{ "id": "hello.panel", "slot": "panel", "placement": "append", "fixtures": ["fixtures/panel.json"] }],
    "events": ["modns.hello.greeted"],
    "commands": [{ "id": "hello.bump", "title": "Bump the hello counter" }]
  },
  "requires": { "capabilities": ["log.append:modns.hello.*"], "egress": "none" }
}
