version: 1.0.0
description: |
  @a-company/premise-core - Core aggregation library that combines Purpose + Portal.
  Builds the unified symbol index used by CLI commands and MCP server.
features:
  symbol-aggregation:
    description: '@symbol-aggregation: Aggregate symbols from all sources'
    aspects:
      - ~yaml-config-loading
      - ~zod-validated
    flows:
      - $symbol-aggregation
    signals:
      - '!aggregation-complete'
    components:
      - '#aggregator'
      - '#source-loader'
  symbol-indexing:
    description: '@symbol-indexing: Build searchable symbol index'
    states:
      - '%index.loaded'
      - '%index.count'
    components:
      - '#symbol-index'
      - '#search-engine'
  reference-tracking:
    description: '@reference-tracking: Track symbol relationships'
    components:
      - '#reference-tracker'
      - '#graph-builder'
components:
  aggregator:
    description: '#aggregator: Main aggregation logic'
  source-loader:
    description: '#source-loader: Loads symbols from .purpose and portal.yaml'
  symbol-index:
    description: '#symbol-index: In-memory symbol index'
  search-engine:
    description: '#search-engine: Symbol search functionality'
  reference-tracker:
    description: '#reference-tracker: Tracks references between symbols'
  graph-builder:
    description: '#graph-builder: Builds relationship graph'
states:
  index: {}
signals:
  aggregation-complete:
    description: '!aggregation-complete: Symbol aggregation finished'
    category: premise
    severity: info
aspects:
  ~symbol-blocklist-framework-aliases:
    description: $lib, $env, $app, $service-worker, $virtual, $schema, $ref, $id, $type are blocked from symbol extraction to avoid false positives from SvelteKit/Vite/JSON
    tags:
      - symbol-extraction
      - false-positives
    anchors:
      - src/aggregator.ts:364-367
    applies-to:
      - '#aggregator'
  ~symbol-ref-pattern-letter-guard:
    description: Cross-reference regex requires first char after prefix to be a letter (prevents matching $420, $0)
    tags:
      - symbol-extraction
      - regex
    anchors:
      - src/aggregator.ts:382-383
    applies-to:
      - '#aggregator'
  ~anchor-parse-formats:
    description: 'Code anchors support four formats: file.ts, file.ts:15, file.ts:15-20, file.ts:15,25,30'
    tags:
      - anchors
      - parsing
    anchors:
      - src/aggregator.ts:335-358
    applies-to:
      - '#aggregator'
flows:
  symbol-aggregation:
    description: Aggregate all symbols from .purpose and portal.yaml files into a unified index
    signals:
      - '!aggregation-complete'
    components:
      - '#aggregator'
      - '#source-loader'
      - '#symbol-index'
      - '#reference-tracker'
      - '#graph-builder'
    steps:
      - component: '#aggregator'
        action: Find all .purpose files via glob
      - component: '#source-loader'
        action: Parse each file with yaml + Zod validation
      - component: '#aggregator'
        action: Extract components, gates, signals, flows, aspects
      - component: '#symbol-index'
        action: Build searchable in-memory index
      - component: '#reference-tracker'
        action: Resolve cross-file symbol references
      - component: '#graph-builder'
        action: Build relationship graph
