version: 2.0.0
description: |
  @a-company/premise-core - Core aggregation library that combines Purpose + Portal.
  Builds the unified symbol index used by CLI commands and MCP server.
features:
  symbol-aggregation:
    description: '@symbol-aggregation: Aggregate symbols from all sources'
    aspects:
      - ~yaml-config-loading
      - ~zod-validated
    flows:
      - $symbol-aggregation
    signals:
      - '!aggregation-complete'
    components:
      - '#aggregator'
      - '#source-loader'
  symbol-indexing:
    description: '@symbol-indexing: Build searchable symbol index'
    states:
      - '%index.loaded'
      - '%index.count'
    components:
      - '#symbol-index'
      - '#search-engine'
  reference-tracking:
    description: '@reference-tracking: Track symbol relationships'
    components:
      - '#reference-tracker'
      - '#graph-builder'
components:
  aggregator:
    description: '#aggregator: Main aggregation logic — includes duplicate symbol detection (reports symbols defined in 2+ files via AggregationResult.duplicateSymbols). DETERMINISM: the extract* helpers are last-write-wins keyed by symbol name, so the .purpose/portal discovery order decides which DUPLICATE wins. Discovery is sorted by repo-relative path (purpose-core findPurposeFiles depth-then-relpath; portal-core findGateFiles relpath) so resolution + downstream Merkle essences are stable across parses — load-bearing for the Loom Oracle (scan-index nondeterminism, T-2026-06-13-011).'
  source-loader:
    description: '#source-loader: Loads symbols from .purpose and portal.yaml'
  symbol-index:
    description: '#symbol-index: In-memory symbol index'
  search-engine:
    description: '#search-engine: Symbol search functionality'
  reference-tracker:
    description: '#reference-tracker: Tracks references between symbols'
  graph-builder:
    description: '#graph-builder: Builds relationship graph'
  graph-slice-projector:
    description: >-
      #graph-slice-projector: Projects a BOUNDED, deterministic slice of the
      symbol graph centered on one symbol (src/graph-slice.ts). Shared by the
      `paradigm graph slice` CLI + `paradigm_graph_slice` MCP tool. Sources
      neighbors from a LIVE SymbolIndex (aggregateFromDirectory + buildSymbolIndex
      — the SAME live-parse pipeline `paradigm ripple` uses), NOT the stale
      scan-index/flow-index, so flow membership (e.g. #cockpit-view → $$fleet-switch)
      always surfaces. Unioned edges: getReferencesFrom → uses/gated-by/in-flow,
      getReferencesTo → used-by, flow membership → in-flow, flow co-members (flow
      mode) → uses. BFS to radius (1, max 3), DEGREE_CAP 8 with +N-more collapse,
      deterministic sort, fail-loud did-you-mean. Freshness is the live-parse
      timestamp, stale always false (sidesteps the scan-index determinism wart).
    tags:
      - graph
      - projection
      - visualization
  classroom-metrics:
    description: >-
      #classroom-metrics: The ONE canonical repeat-failure-rate rollup for the
      Classroom (TD-2026-06-19-007), src/classroom-metrics.ts. Both the
      paradigm_classroom_status MCP tool and `paradigm doctor` consume it (the
      CLI does NOT depend on paradigm-mcp; both depend on premise-core), so the
      formula lives here ONCE to avoid drift. computeRepeatFailureRate(certs) →
      overall + per-agent { resolved, overturned, rate } where rate =
      overturned/resolved (3dp), null until a cert resolves (survived|overturned;
      pending excluded). readClassroomCertifications/readFieldFailures read
      .paradigm/events/*.jsonl tolerantly (skip corrupt lines, never throw),
      mirroring graph-slice's .paradigm file access. The cert WRITER stays in
      paradigm-mcp/utils/field-failures.ts — only the read+rollup is shared.
    tags:
      - classroom
      - metrics
      - learning-loop
states:
  index: {}
signals:
  aggregation-complete:
    description: '!aggregation-complete: Symbol aggregation finished'
    category: premise
    severity: info
aspects:
  ~symbol-blocklist-framework-aliases:
    description: $lib, $env, $app, $service-worker, $virtual, $schema, $ref, $id, $type are blocked from symbol extraction to avoid false positives from SvelteKit/Vite/JSON
    tags:
      - symbol-extraction
      - false-positives
    anchors:
      - src/aggregator.ts:364-367
    applies-to:
      - '#aggregator'
  ~symbol-ref-pattern-letter-guard:
    description: Cross-reference regex requires first char after prefix to be a letter (prevents matching $420, $0)
    tags:
      - symbol-extraction
      - regex
    anchors:
      - src/aggregator.ts:382-383
    applies-to:
      - '#aggregator'
  ~anchor-parse-formats:
    description: 'Code anchors support four formats: file.ts, file.ts:15, file.ts:15-20, file.ts:15,25,30'
    tags:
      - anchors
      - parsing
    anchors:
      - src/aggregator.ts:335-358
    applies-to:
      - '#aggregator'
flows:
  symbol-aggregation:
    description: Aggregate all symbols from .purpose and portal.yaml files into a unified index
    signals:
      - '!aggregation-complete'
    components:
      - '#aggregator'
      - '#source-loader'
      - '#symbol-index'
      - '#reference-tracker'
      - '#graph-builder'
    steps:
      - component: '#aggregator'
        action: Find all .purpose files via glob
      - component: '#source-loader'
        action: Parse each file with yaml + Zod validation
      - component: '#aggregator'
        action: Extract components, gates, signals, flows, aspects
      - component: '#symbol-index'
        action: Build searchable in-memory index
      - component: '#reference-tracker'
        action: Resolve cross-file symbol references
      - component: '#graph-builder'
        action: Build relationship graph
