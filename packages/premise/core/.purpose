version: 2.0.0
description: |
  @a-company/premise-core - Core aggregation library that combines Purpose + Portal.
  Builds the unified symbol index used by CLI commands and MCP server.
features:
  symbol-aggregation:
    description: '@symbol-aggregation: Aggregate symbols from all sources'
    aspects:
      - ~yaml-config-loading
      - ~zod-validated
    flows:
      - $symbol-aggregation
    signals:
      - '!aggregation-complete'
    components:
      - '#aggregator'
      - '#source-loader'
  symbol-indexing:
    description: '@symbol-indexing: Build searchable symbol index'
    states:
      - '%index.loaded'
      - '%index.count'
    components:
      - '#symbol-index'
      - '#search-engine'
  reference-tracking:
    description: '@reference-tracking: Track symbol relationships'
    components:
      - '#reference-tracker'
      - '#graph-builder'
components:
  aggregator:
    description: '#aggregator: Main aggregation logic — anchors: strings go through the shared #symbol-index parseAnchorString (heading/block section anchors since 7.12.0), and resolveReferences stringifies symbol data WITHOUT the anchors field so a section anchor like docs/x.md#setup never registers a reference to #setup — includes duplicate symbol detection (reports symbols defined in 2+ files via AggregationResult.duplicateSymbols). DETERMINISM: the extract* helpers are last-write-wins keyed by symbol name, so the .purpose/portal discovery order decides which DUPLICATE wins. Discovery is sorted by repo-relative path (purpose-core findPurposeFiles depth-then-relpath; portal-core findGateFiles relpath) so resolution + downstream Merkle essences are stable across parses — load-bearing for the Loom Oracle (scan-index nondeterminism, T-2026-06-13-011).'
  source-loader:
    description: '#source-loader: Loads symbols from .purpose and portal.yaml'
  symbol-index:
    description: '#symbol-index: In-memory symbol index. Also home of the ONE shared anchor-string parser (7.12.0, D9): parseAnchorString (aggregator path; section anchors first, then the pre-7.12 line semantics byte-identical — "file.ts:15-20" still yields exactly {path, lines:[15,20], raw}), parseAnchor (same section-first fallthrough), parseSectionAnchor (Obsidian-compatible docs/x.md#Heading Text → kind heading, docs/x.md#^block-id → kind block, lines 0 = unresolved; the path part must end in a file extension so src/c#/x.cs:10 stays a line anchor, and a fragment containing ''/'' or ending in :N / :N-M is rejected so dir.name#x/Foo.ts:10 stays a line anchor) and resolveSectionAnchorLines (content + key → current 1-based inclusive range or null; heading = through the next same-or-higher heading, fenced pseudo-headings ignored, exact then case-insensitive match; block = contiguous paragraph ending at the inline ^id or preceding a standalone ^id line). SourceType gained ''frontmatter'' (no exhaustive switches exist; bySource is an open Map).'
  frontmatter-parser:
    description: '#frontmatter-parser: src/frontmatter.ts — the ONE YAML-frontmatter splitter (7.12.0, D8). parseFrontmatter(raw, {mode}) → {data, body, hasFrontmatter, error?} over FRONTMATTER_RE (LF + CRLF, closing fence then newline or EOF). lenient (default) never throws: no block → whole input is body; malformed YAML / non-mapping → data {} + error, body after the fence. strict throws FrontmatterError(reason missing|yaml|not-mapping) with CONTRACT messages "missing YAML frontmatter (--- … ---)", "frontmatter is not a YAML mapping", or the YAML parser message verbatim (surfaced unchanged by #skill-loader). Consumers: #native-memory-scan (lenient), #skill-loader splitFrontmatter (strict), docs-loader (lenient → null adapter). Follow-up: university-core loader + doctor agent-audit still hand-roll.'
    file: packages/premise/core/src/frontmatter.ts
    tags:
      - parser
      - frontmatter
  search-engine:
    description: '#search-engine: Symbol search functionality (searchSymbols in src/symbol-index.ts). Since 7.13.0 per-entry lowercased haystacks (symbol, description, tags, componentType, joined multi-token string) are memoized in a WeakMap keyed by SymbolIndex and revalidated against the entry source fields, so repeated searches over a cached #live-index index skip re-lowercasing. Substring semantics and ranking are unchanged.'
  symbol-integrity:
    description: >-
      #symbol-integrity (7.15.0, TD-2026-10-13-661 Phase 1): canonical symbol identity.
      aggregator.ts canonicalizeSymbols merges every contributor of one symbol string into ONE
      entry (portal wins for gates; real declarations beat reference stubs; ties keep last-wins),
      records all contributors in SymbolEntry.sources, and marks reference-only stubs
      declared:false. resolveReferences scans the winner AND every donor's data (dropping
      `anchors` and `referencedFrom`), so no edge is lost in the merge; portal gates now reference
      the prize signals they award. symbol-index.ts adds bySymbol/byNameLower maps, resolveSymbol
      (exact -> case-insensitive -> unambiguous bare name, else candidates), addSymbolEntry and
      sourcesOf; getSymbol is O(1). src/integrity.ts exports findDuplicateDeclarations (a
      portal+purpose pair is exempt; a second .purpose declaration is flagged) and
      findDanglingReferences. Fixes ripple reporting 0 dependents for portal gates referenced
      from .purpose.
    type: component
    anchors:
      - src/aggregator.ts
      - src/symbol-index.ts
      - src/integrity.ts
    tags: [symbol-index, integrity]
  live-index:
    description: >-
      #live-index: src/live-index.ts (7.13.0) — incremental in-process cache of
      the LIVE SymbolIndex. getLiveIndex(rootDir) globs .purpose
      (purpose-core findPurposeFiles) + portal.yaml (portal-core findGateFiles),
      stats every file, and returns the SAME cached index when the ordered
      (path, mtimeMs, size) lists are unchanged; otherwise re-parses only changed
      .purpose files via #purpose-parse-cache and re-aggregates the FULL set in
      discovery order through aggregateFromDirectory's AggregateOptions loader
      seams, so output equals a cold parse (order + duplicate last-write-wins,
      T-2026-06-13-011). Concurrent callers share one in-flight refresh.
      Files with mtime within 2s of now also carry a content sha1 in their stamp
      (same-size edits inside one mtime tick). At most LIVE_INDEX_MAX_ROOTS (8)
      roots are cached, LRU-evicted.
      invalidateLiveIndex(rootDir?) drops a root (paradigm_reindex calls it).
      Returned index/entry data are shared — read-only. Bench (report only):
      scripts/bench-live-index.mjs.
    file: packages/premise/core/src/live-index.ts
    tags:
      - index
      - cache
      - performance
  reference-tracker:
    description: '#reference-tracker: Tracks references between symbols'
  graph-builder:
    description: '#graph-builder: Builds relationship graph'
  graph-slice-projector:
    description: >-
      #graph-slice-projector: Projects a BOUNDED, deterministic slice of the
      symbol graph centered on one symbol (src/graph-slice.ts). Shared by the
      `paradigm graph slice` CLI + `paradigm_graph_slice` MCP tool. Sources
      neighbors from a LIVE SymbolIndex (aggregateFromDirectory + buildSymbolIndex
      — the SAME live-parse pipeline `paradigm ripple` uses), NOT the stale
      scan-index/flow-index, so flow membership (e.g. #cockpit-view → $$fleet-switch)
      always surfaces. Unioned edges: getReferencesFrom → uses/gated-by/in-flow,
      getReferencesTo → used-by, flow membership → in-flow, flow co-members (flow
      mode) → uses. BFS to radius (1, max 3), DEGREE_CAP 8 with +N-more collapse,
      deterministic sort, fail-loud did-you-mean. Freshness is the live-parse
      timestamp, stale always false (sidesteps the scan-index determinism wart).
      Since 7.13.0 loadLiveGraph delegates to #live-index and memoizes the
      LiveGraph per SymbolIndex (buildLiveGraph), so a warm call does no parsing.
    tags:
      - graph
      - projection
      - visualization
  classroom-metrics:
    description: >-
      #classroom-metrics: The ONE canonical repeat-failure-rate rollup for the
      Classroom (TD-2026-06-19-007), src/classroom-metrics.ts. Both the
      paradigm_classroom_status MCP tool and `paradigm doctor` consume it (the
      CLI does NOT depend on paradigm-mcp; both depend on premise-core), so the
      formula lives here ONCE to avoid drift. computeRepeatFailureRate(certs) →
      overall + per-agent { resolved, overturned, rate } where rate =
      overturned/resolved (3dp), null until a cert resolves (survived|overturned;
      pending excluded). readClassroomCertifications/readFieldFailures read
      .paradigm/events/*.jsonl tolerantly (skip corrupt lines, never throw),
      mirroring graph-slice's .paradigm file access. The cert WRITER stays in
      paradigm-mcp/utils/field-failures.ts — only the read+rollup is shared.
    tags:
      - classroom
      - metrics
      - learning-loop
states:
  index: {}
signals:
  aggregation-complete:
    description: '!aggregation-complete: Symbol aggregation finished'
    category: premise
    severity: info
aspects:
  ~symbol-blocklist-framework-aliases:
    description: $lib, $env, $app, $service-worker, $virtual, $schema, $ref, $id, $type are blocked from symbol extraction to avoid false positives from SvelteKit/Vite/JSON
    tags:
      - symbol-extraction
      - false-positives
    anchors:
      - src/aggregator.ts:371-374
    applies-to:
      - '#aggregator'
  ~symbol-ref-pattern-letter-guard:
    description: Cross-reference regex requires first char after prefix to be a letter (prevents matching $420, $0)
    tags:
      - symbol-extraction
      - regex
    anchors:
      - src/aggregator.ts:391-393
    applies-to:
      - '#aggregator'
  ~anchor-parse-formats:
    description: 'Code anchors support four line formats: file.ts, file.ts:15, file.ts:15-20, file.ts:15,25,30 — plus (7.12.0) section anchors docs/x.md#Heading and docs/x.md#^block-id, parsed by the shared #symbol-index parseAnchorString'
    tags:
      - anchors
      - parsing
    anchors:
      - src/symbol-index.ts:429-462
    applies-to:
      - '#aggregator'
      - '#symbol-index'
flows:
  symbol-aggregation:
    description: Aggregate all symbols from .purpose and portal.yaml files into a unified index
    signals:
      - '!aggregation-complete'
    components:
      - '#aggregator'
      - '#source-loader'
      - '#symbol-index'
      - '#reference-tracker'
      - '#graph-builder'
    steps:
      - component: '#aggregator'
        action: Find all .purpose files via glob
      - component: '#source-loader'
        action: Parse each file with yaml + Zod validation
      - component: '#aggregator'
        action: Extract components, gates, signals, flows, aspects
      - component: '#symbol-index'
        action: Build searchable in-memory index
      - component: '#reference-tracker'
        action: Resolve cross-file symbol references
      - component: '#graph-builder'
        action: Build relationship graph
