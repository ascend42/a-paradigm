version: "1.0"

agent-guidelines:
  overview: |
    ShopFlow is a modern e-commerce platform using Horizon for structured 
    AI context management. All project knowledge is organized through 
    .purpose files, gate.yaml authorization, and the .dream overview.

  how-to-use:
    - Check .purpose files in directories before making changes
    - Run `horizon status` to see all symbols in the project
    - Run `horizon visualize` to explore the Dreamscape canvas
    - Reference symbols using @ # $ % ~ ^ ! ? prefixes
    - Look for `gate.yaml` when dealing with authorization

  update-rules:
    - When adding a feature, create/update the nearest .purpose file
    - When adding authorization logic, update gate.yaml
    - When exploring new ideas, add them to .dream with ? prefix
    - Always update references when renaming or moving symbols
    - Run `horizon cursorrules` after updating .horizon

symbol-system:
  "@":
    name: Feature
    description: User-facing capabilities (checkout, login, cart, etc.)
    owner: purpose
    examples:
      - "@checkout-flow"
      - "@user-login"
      - "@cart-management"
      - "@payment-processing"

  "#":
    name: Component
    description: Reusable UI components and code modules
    owner: purpose
    examples:
      - "#ProductCard"
      - "#CartDrawer"
      - "#AuthProvider"
      - "#PaymentForm"

  "$":
    name: Flow
    description: Multi-step user journeys and processes
    owner: shared
    examples:
      - "$checkout-to-confirmation"
      - "$auth-flow"

  "%":
    name: State
    description: Global application and user state
    owner: purpose
    examples:
      - "%user.authenticated"
      - "%cart.items"
      - "%auth-state"

  "~":
    name: Aspect
    description: Cross-cutting concerns and nested properties
    owner: purpose
    examples:
      - "@login~validation"
      - "#Button~disabled"
      - "~search-performance"

  "^":
    name: Gate
    description: Access control and authorization points
    owner: gate
    examples:
      - "^auth-required"
      - "^premium-checkout"
      - "^admin-panel"

  "!":
    name: Signal
    description: Events, errors, and side effects
    owner: gate
    examples:
      - "!payment-failed"
      - "!login-failed"
      - "!order-confirmed"

  "?":
    name: Idea
    description: Free-form exploration and future features
    owner: dream
    examples:
      - "?subscription-model"
      - "?ai-recommendations"
      - "?social-shopping"

states:
  user:
    authenticated:
      type: boolean
      default: false
      description: User is logged in
    role:
      type: enum
      values: ["guest", "customer", "admin", "owner"]
      description: User access level
    subscription:
      type: enum
      values: ["free", "premium", "enterprise"]
      description: User subscription tier
    emailVerified:
      type: boolean
      default: false
      description: Email has been verified

  cart:
    items:
      type: array
      description: Items currently in cart
    total:
      type: number
      description: Cart total in cents

  checkout:
    step:
      type: enum
      values: ["cart", "shipping", "payment", "review", "processing", "complete"]
      description: Current checkout step

purpose-required:
  - pattern: "auth/"
    depth: 1
  - pattern: "payments/"
    depth: 1
  - pattern: "features/"
    depth: 1
  - pattern: "components/"
    depth: 1

conventions:
  - Use kebab-case for all symbol IDs (checkout-flow, not checkoutFlow)
  - Document flows when logic spans 3+ components
  - Reference related items using symbol prefixes
  - Add descriptions to all features, components, and gates
  - Use signals for side effects (! prefix), not direct state mutations
  - Keep gates minimal - one responsibility per gate
  - Group related ideas in .dream under areas
  - Update purpose files when changing feature behavior
