version: "1.0.0"

metadata:
  name: "ShopFlow"
  created: "2024-01-01T00:00:00.000Z"
  modified: "2024-01-19T00:00:00.000Z"

sources:
  purpose:
    - path: "./"
  gate:
    - path: "./gate.yaml"

nodes:
  - id: "idea-subscription-model"
    symbol: "?subscription-model"
    type: "idea"
    position:
      x: 100
      y: 100
    created: "2024-01-01T00:00:00.000Z"
    content: "Consider adding recurring subscription purchases"
    tags: ["planning", "medium-priority"]
    
  - id: "idea-ai-recommendations"
    symbol: "?ai-recommendations"
    type: "idea"
    position:
      x: 200
      y: 100
    created: "2024-01-01T00:00:00.000Z"
    content: "ML-powered product recommendations based on browsing history"
    tags: ["planning", "high-priority"]
    
  - id: "idea-social-shopping"
    symbol: "?social-shopping"
    type: "idea"
    position:
      x: 300
      y: 100
    created: "2024-01-01T00:00:00.000Z"
    content: "Share wishlists and get friend recommendations"
    tags: ["planning", "low-priority"]

connections: []

layout:
  viewport:
    x: 0
    y: 0
    zoom: 1
  groups:
    - id: "auth-cluster"
      name: "Auth Cluster"
      nodes: ["@user-login", "@user-register", "^auth-required"]
    - id: "shopping-core"
      name: "Shopping Core"
      nodes: ["@product-browse", "@cart-management", "#ProductCard"]
