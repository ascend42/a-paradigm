# ShopFlow - Project Purpose (v2)
# Root context for the entire e-commerce platform

version: "2.0.0"

description: |
  ShopFlow is a modern e-commerce platform designed for small-to-medium
  businesses who want a beautiful, fast, and conversion-optimized
  shopping experience. We prioritize mobile-first design, accessibility,
  and seamless checkout flows.

context:
  - "Domain: E-commerce / Retail"
  - "Users: Shoppers browsing products, Store owners managing inventory, Admin users with full access"
  - "Tech Stack: React 18 with TypeScript, Node.js backend, PostgreSQL database, Stripe for payments, Redis for caching"

rules:
  currency: "All prices must be displayed in the user's local currency"
  cart_persistence: "Cart state persists across sessions via localStorage + server sync"
  payment_security: "Payment processing must happen server-side only"
  accessibility: "Product images require alt text for accessibility"
  mobile_first: "Mobile viewport must be primary design target"

# Features are now #components with [feature] tag
#product-browse:
  description: "Browse, filter, and search products"
  tags: [feature]

#cart-management:
  description: "Add, remove, and update cart items"
  tags: [feature]

#checkout-flow:
  description: "Multi-step checkout with payment integration"
  tags: [feature, critical, revenue]

#wishlist:
  description: "Save products for later"
  tags: [feature]

# UI Components
#ProductCard:
  description: "Displays product thumbnail, price, and quick-add button"

#CartDrawer:
  description: "Slide-out drawer showing current cart contents"

#SearchBar:
  description: "Global search with autocomplete suggestions"
