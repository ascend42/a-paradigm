# Authentication Module (v2)
# Handles all user authentication and session management

version: "2.0.0"

description: |
  Provide secure, frictionless authentication that supports multiple
  sign-in methods while maintaining strong security standards.

context:
  - "Parent: ../.purpose"
  - "Scope: Authentication & Authorization"
  - "Sensitive: true"

rules:
  password_hashing: "Passwords must be hashed with bcrypt (cost factor 12)"
  jwt_expiry: "JWT tokens expire after 24 hours"
  refresh_tokens: "Refresh tokens stored in httpOnly cookies"
  rate_limiting: "Rate limit login attempts (5 per minute per IP)"
  oauth_support: "Support OAuth providers (Google, GitHub, Apple)"

# Features are now #components with [feature] tag
#user-login:
  description: "Email/password and OAuth authentication"
  tags: [feature, security]
  gates: [^rate-limited]
  signals: [!login-success, !login-failed]

#user-register:
  description: "New account creation with email verification"
  tags: [feature, security]
  gates: [^rate-limited]
  signals: [!registration-success, !registration-failed]

#password-reset:
  description: "Secure password recovery flow"
  tags: [feature, security]
  gates: [^rate-limited]
  signals: [!reset-requested, !reset-completed]

# UI Components
#AuthProvider:
  description: "React context provider for auth state"
  tags: [state]

#LoginForm:
  description: "Email/password login form with validation"

#RegisterForm:
  description: "New user registration form"
