# Payments Module (v2)
# Handles all payment processing and checkout logic

version: "2.0.0"

description: |
  Process payments securely through Stripe, supporting multiple payment
  methods while ensuring PCI compliance and excellent UX.

context:
  - "Parent: ../.purpose"
  - "Scope: Payment Processing"
  - "Sensitive: true"
  - "Compliance: PCI-DSS, GDPR (for EU customers)"

rules:
  card_storage: "Never store raw card numbers - use Stripe tokens"
  server_side_only: "All payment API calls must be server-side"
  audit_logging: "Log all transactions for audit trail"
  refund_window: "Support refunds within 30-day window"
  error_messaging: "Display clear error messages for failed payments"

# Features are now #components with [feature] tag
#payment-processing:
  description: "Core Stripe integration for payments"
  tags: [feature, integration, stripe, critical]
  gates: [^authenticated, ^valid-cart]
  signals: [!payment-success, !payment-failed]
  aspects: [~audit-required]

#order-confirmation:
  description: "Post-purchase confirmation and receipt"
  tags: [feature]
  signals: [!confirmation-sent]

# UI Components
#PaymentForm:
  description: "Stripe Elements-powered payment form"
  tags: [integration, stripe]

#StripeProvider:
  description: "Stripe.js initialization wrapper"
  tags: [integration, stripe]

#ConfirmationPage:
  description: "Order success page with receipt"

# Flows
$checkout-flow:
  description: "Complete purchase journey"
  tags: [critical, revenue]
  steps:
    - "#cart-review"
    - "#ShippingForm"
    - "^authenticated"
    - "#PaymentForm"
    - "^valid-cart"
    - "#payment-processing"
    - "!payment-success"
    - "#ConfirmationPage"
  on-failure:
    - "!payment-failed"
    - "#error-handler"

# Aspects (cross-cutting rules with required anchors)
~audit-required:
  description: "All payment operations must be logged for compliance"
  tags: [compliance, security]
  anchors:
    - payments/middleware/audit.ts:1-50
  applies-to:
    - "#payment-processing"
    - "#refund-processing"
