{
  "mcpServers": {
    "paradigm": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--prefix=${CLAUDE_PLUGIN_ROOT}",
        "--package=@a-company/paradigm",
        "-y",
        "paradigm-mcp",
        "${CLAUDE_PROJECT_DIR}"
      ],
      "env": {
        "CLAUDE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
