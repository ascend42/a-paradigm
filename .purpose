version: 2.0.0
description: |
  Paradigm Framework - Unified developer tools ecosystem for structured AI-assisted development.
  Brings together Purpose (context), Portal (authorization), and Premise (aggregation) into
  a single, visual experience with the Sentinel dashboard.
context:
  - This is the Paradigm framework itself - use it to develop Paradigm ("dogfooding")
  - Monorepo using npm workspaces with shared TypeScript configuration
  - All packages publish to @a-company scope
  - The CLI (`paradigm`) is the main user interface
  - Sentinel is the unified codebase intelligence UI
features:
  cli-commands:
    description: Core CLI commands for managing Paradigm projects
    flows:
      - $init-flow
      - $sync-flow
    signals:
      - '!command-success'
      - '!command-error'
    components:
      - '#commander-setup'
      - '#ora-spinners'
      - '#chalk-output'
  symbol-system:
    description: 'The shared language between code, developers, and AI (v2: #, $, ^, !, ~ + tag bank)'
    aspects:
      - "~yaml-config-loading"
      - "~zod-validated"
      - "~file-glob-discovery"
    components:
      - '#symbol-parser'
      - '#symbol-index'
  ide-sync:
    description: Generate IDE instruction files from .paradigm/ config
    aspects:
      - "~ide-adapter-pattern"
    flows:
      - $sync-flow
      - $ide-sync-flow
    components:
      - '#cursor-adapter'
      - '#copilot-adapter'
      - '#windsurf-adapter'
      - '#claude-adapter'
  visual-discovery:
    description: Map screenshots to code via probe/scan
    flows:
      - $probe-flow
    components:
      - '#probe-protocol'
      - '#scan-generator'
  agent-efficiency:
    description: Tools for token-efficient AI development
    signals:
      - '!context-loaded'
      - '!ripple-analyzed'
    components:
      - '#beacon'
      - '#constellation'
      - '#ripple'
      - '#thread'
      - '#echo'
    aspects:
      - "~symbol-typed-logging"
      - "~correlation-tracked"
  mcp-server:
    description: Model Context Protocol server for AI assistants with global session persistence and cross-project wisdom
    aspects:
      - "~mcp-tool-handler"
      - "~global-persistence"
    signals:
      - '!server-started'
      - '!resource-fetched'
      - '!tool-called'
      - '!handoff-persisted'
      - '!handoff-delivered'
      - '!wisdom-promoted'
    flows:
      - $handoff-roundtrip
      - $wisdom-promotion
    components:
      - '#mcp-resources'
      - '#mcp-tools'
      - '#index-loader'
      - '#global-store'
  sentinel-dashboard:
    description: Unified codebase intelligence UI with symbol visualization
    aspects:
      - "~express-server"
    components:
      - '#sentinel-ui'
      - '#node-renderer'
      - '#connection-lines'
      - '#properties-panel'
  university-platform:
    description: Interactive academia-themed learning platform with courses, quizzes, PLSAT certification exam, and reference library
    aspects:
      - "~express-server"
    components:
      - '#university-ui'
      - '#university-server'
      - '#courses-store'
      - '#progress-store'
      - '#plsat-store'
    signals:
      - "!plsat-completed"
      - "!quiz-completed"
    flows:
      - $plsat-exam-flow
  aspect-graph:
    description: SQLite-backed aspect graph with materialization, three-tier search, drift detection, and auto-suggest
    aspects:
      - "~aspect-graph-derived-artifact"
      - "~three-tier-search"
      - "~search-weight-learning"
    components:
      - '#AspectGraph'
      - '#AspectSearch'
      - '#AspectLoreBridge'
      - '#AspectSuggest'
      - '#AspectGraphTools'
    signals:
      - '!index-rebuilt'
    flows:
      - $aspect-materialization
  portal-authorization:
    description: Runtime authorization with visual testing
    flows:
      - $authorization-flow
    gates:
      - ^authenticated
      - ^subscription-required
      - ^admin-only
    components:
      - '#portal-core'
      - '#portal-sdk'
      - '#portal-viewer'
      - '#portal-manager'
  team-orchestration:
    description: Multi-agent coordination with model selection, spawning, and orchestration
    aspects:
      - "~provider-cascade"
      - "~budget-enforced"
    flows:
      - $orchestration-flow
      - $agent-orchestration-flow
    signals:
      - '!agent-spawned'
      - '!orchestration-completed'
    components:
      - '#agent-spawner'
      - '#orchestrator'
      - '#model-discovery'
      - '#provider-registry'
      - '#model-configurator'
components:
  commander-setup:
    description: CLI framework setup with Commander.js
  symbol-parser:
    description: Parses symbols from .purpose and portal.yaml files
  symbol-index:
    description: In-memory index of all project symbols
  cursor-adapter:
    description: Generates .cursor/rules/*.mdc files
  copilot-adapter:
    description: Generates .github/copilot-instructions.md files
  windsurf-adapter:
    description: Generates .windsurfrules file
  claude-adapter:
    description: Generates CLAUDE.md file
  beacon:
    description: Quick-start orientation for AI agents
  constellation:
    description: Machine-readable symbol graph in JSON/YAML
  ripple:
    description: Change impact analysis tool
  thread:
    description: Session continuity between AI agents
  echo:
    description: Error-to-symbol mapping
  mcp-resources:
    description: Read-only data exposed via MCP protocol
  mcp-tools:
    description: Actions AI can invoke via MCP protocol
  global-store:
    description: Global brain utility (~/.paradigm/) for session persistence and cross-project wisdom
  index-loader:
    description: Loads project symbol index for MCP server
  sentinel-ui:
    description: React app for unified codebase intelligence
  node-renderer:
    description: Renders symbol nodes on the canvas
  connection-lines:
    description: SVG lines connecting related symbols
  properties-panel:
    description: Side panel showing selected symbol details
  portal-core:
    description: Core parsing and validation for portal.yaml
  portal-sdk:
    description: Runtime SDK for checking gates in applications
  portal-viewer:
    description: Real-time visualization of authorization flows
  portal-manager:
    description: Test generation and flow management
  probe-protocol:
    description: Protocol for visual-to-code mapping
  scan-generator:
    description: Generates scan-index.json for component mapping
  agent-spawner:
    description: Spawns AI agents via provider abstraction
  orchestrator:
    description: Coordinates multi-agent orchestration (solo/faceted modes)
  model-discovery:
    description: Discovers available AI models from APIs, remote manifest, and presets
  provider-registry:
    description: Manages provider cascade (claude → claude-code → cursor-cli → manual)
  model-configurator:
    description: Interactive prompts for configuring agent model assignments
signals:
  command-success:
    description: CLI command completed successfully
  command-error:
    description: CLI command failed with error
  context-loaded:
    description: Project context loaded into agent tools
  ripple-analyzed:
    description: Impact analysis completed
  server-started:
    description: MCP server started and listening
  resource-fetched:
    description: MCP resource was read by client
  tool-called:
    description: MCP tool was invoked by client
  agent-spawned:
    description: AI agent spawned successfully
  orchestration-completed:
    description: Multi-agent orchestration completed
  handoff-persisted:
    description: Session handoff written to global store for cross-session recovery
  handoff-delivered:
    description: Pending handoff recovered by a new session
  wisdom-promoted:
    description: Project-local wisdom promoted to global scope
aspects:
  yaml-config-loading:
    description: All config files (.purpose, portal.yaml, premise) parsed via js-yaml with consistent error handling
    tags:
      - infrastructure
      - parsing
    anchors:
      - packages/purpose/core/src/parser.ts:183-197
      - packages/portal/core/src/parser.ts:38-46
      - packages/premise/core/src/parser.ts:126-135
    applies-to:
      - '#yaml-parser'
      - '#portal-core'
      - '#aggregator'
  zod-validated:
    description: Input validated through Zod schemas before processing — ensures type-safe parsing of all config files
    tags:
      - validation
      - type-safety
    anchors:
      - packages/purpose/core/src/parser.ts:16-150
      - packages/purpose/core/src/parser.ts:210-228
      - packages/premise/core/src/parser.ts:31-90
    applies-to:
      - '#zod-schemas'
      - '#symbol-parser'
      - '#aggregator'
  symbol-typed-logging:
    description: All logging uses symbol-prefixed methods (component/gate/signal/flow/aspect) instead of raw console.log
    tags:
      - observability
      - convention
    anchors:
      - packages/logger/src/logger.ts:112-130
      - packages/logger/src/logger.ts:64-97
    applies-to:
      - '#paradigm-logger'
      - '#symbol-logger'
  mcp-tool-handler:
    description: MCP tools follow a registration + dispatch pattern — tools declared in ListToolsRequest, dispatched in CallToolRequest
    tags:
      - pattern
      - mcp
    anchors:
      - packages/paradigm-mcp/src/tools/index.ts:96-212
      - packages/paradigm-mcp/src/tools/index.ts:212-886
    applies-to:
      - '#mcp-tools'
      - '#CoreTools'
      - '#WisdomTools'
      - '#HistoryTools'
  ide-adapter-pattern:
    description: IDE output generated via adapter interface — shared base class with per-IDE overrides for Cursor, Claude, Copilot, Windsurf
    tags:
      - pattern
      - extensibility
    anchors:
      - packages/paradigm/src/core/ide-adapters/base.ts:12-388
      - packages/paradigm/src/core/ide-adapters/cursor.ts:44-92
    applies-to:
      - '#cursor-adapter'
      - '#claude-adapter'
      - '#copilot-adapter'
      - '#windsurf-adapter'
  provider-cascade:
    description: Agent providers tried in priority order (claude → claude-code-teams → claude-code → cursor-cli → claude-cli → manual) with automatic fallback
    tags:
      - pattern
      - resilience
    anchors:
      - packages/paradigm/src/core/provider-registry.ts:158-219
      - packages/paradigm/src/core/provider-registry.ts:36-38
    applies-to:
      - '#provider-registry'
      - '#agent-spawner'
  express-server:
    description: HTTP/WS servers follow Express middleware pattern with CORS, JSON parsing, and static file serving
    tags:
      - pattern
      - infrastructure
    anchors:
      - packages/sentinel/src/server/index.ts:56-96
      - packages/portal/viewer/src/server.ts:56-69
    applies-to:
      - '#SentinelServer'
      - '#portal-viewer'
  budget-enforced:
    description: Token budgets checked before and during agent execution — prevents runaway costs in orchestration
    tags:
      - compliance
      - cost-control
    anchors:
      - packages/paradigm/src/core/budget-tracker.ts:69-163
      - packages/paradigm/src/core/budget-tracker.ts:168-221
    applies-to:
      - '#budget-tracker'
      - '#orchestrator'
  file-glob-discovery:
    description: Config files (.purpose, portal.yaml) discovered via glob patterns with consistent ignore rules (node_modules, dist, .git)
    tags:
      - infrastructure
      - discovery
    anchors:
      - packages/purpose/core/src/aggregator.ts:111-126
      - packages/portal/core/src/parser.ts:281-291
    applies-to:
      - '#aggregator'
      - '#portal-core'
  correlation-tracked:
    description: Requests traced via AsyncLocalStorage correlation IDs — propagated through async call chains without manual threading
    tags:
      - observability
      - tracing
    anchors:
      - packages/logger/src/correlation.ts:1-17
    applies-to:
      - '#paradigm-logger'
      - '#correlation-tracker'
  global-persistence:
    description: Session and wisdom data dual-written to local project and global ~/.paradigm/ for cross-session and cross-project continuity
    tags:
      - persistence
      - resilience
    anchors:
      - packages/paradigm-mcp/src/utils/global-store.ts:37-74
      - packages/paradigm-mcp/src/utils/session-tracker.ts:195-222
    applies-to:
      - '#global-store'
      - '#mcp-tools'
  aspect-graph-derived-artifact:
    description: The SQLite aspect-graph.db is a derived build artifact rebuilt from scratch on every reindex — YAML .purpose files remain the authoritative source
    category: invariant
    severity: critical
    tags:
      - aspect-graph
      - architecture
    anchors:
      - packages/paradigm-mcp/src/tools/reindex.ts:140-175
      - packages/paradigm-mcp/src/utils/aspect-graph.ts:1-50
    applies-to:
      - '#AspectGraph'
      - '#ReindexTools'
    enforcement: |
      The aspect-graph.db is rebuilt by dropping all tables and re-materializing
      from SymbolEntry[] on every reindex. Never edit the database directly.
  three-tier-search:
    description: Aspect search uses three tiers in order — Tier 1 learned mappings, Tier 2 FTS5 full-text, Tier 3 Levenshtein fuzzy — first tier to return results wins
    category: decision
    severity: high
    tags:
      - aspect-graph
      - search
    anchors:
      - packages/paradigm-mcp/src/utils/aspect-search.ts:1-50
    applies-to:
      - '#AspectSearch'
      - '#AspectGraphTools'
  search-weight-learning:
    description: Search results improve via confirm feedback — confirmed aspect gets +1.0, alternatives decay by *0.95 per query
    category: rule
    severity: medium
    tags:
      - aspect-graph
      - learning
    anchors:
      - packages/paradigm-mcp/src/utils/aspect-search.ts:100-150
    applies-to:
      - '#AspectSearch'
      - '#AspectGraphTools'
relationships:
  - '#cli-commands USES #commander-setup, #ora-spinners, #chalk-output'
  - '#symbol-system USES #symbol-parser, #symbol-index'
  - '#ide-sync USES #cursor-adapter, #copilot-adapter, #windsurf-adapter'
  - '#agent-efficiency USES #beacon, #constellation, #ripple, #thread, #echo'
  - '#mcp-server USES #mcp-resources, #mcp-tools, #index-loader, #global-store'
  - '#sentinel-dashboard USES #sentinel-ui, #node-renderer, #connection-lines'
  - '#portal-authorization USES #portal-core, #portal-sdk, #portal-viewer'
  - '#team-orchestration USES #agent-spawner, #orchestrator, #model-discovery'
  - '#aspect-graph USES #AspectGraph, #AspectSearch, #AspectLoreBridge, #AspectSuggest, #AspectGraphTools'
flows:
  init-flow:
    description: Initialize Paradigm in a new project
    steps:
      - Detect existing IDE files
      - Create .paradigm/ directory
      - Generate config.yaml
      - Copy templates
      - Run initial sync
  sync-flow:
    description: Sync .paradigm/ to IDE instruction files
    steps:
      - Load .paradigm/config.yaml
      - Detect target IDE
      - Generate adapter-specific files
      - Write to appropriate locations
  probe-flow:
    description: Visual discovery workflow
    steps:
      - Receive screenshot
      - Match against scan-index.json
      - Return component mappings
      - Suggest code locations
  authorization-flow:
    description: Runtime gate checking
    steps:
      - Request reaches gate
      - Evaluate keys against context
      - Grant or deny access
      - Emit signal
  orchestration-flow:
    description: Multi-agent task coordination
    steps:
      - Classify task complexity
      - Select agent team and models
      - Spawn agents (parallel where possible)
      - Collect results and handoff
      - Log orchestration to audit
  handoff-roundtrip:
    description: Session handoff persistence and recovery via global store
    steps:
      - Agent calls paradigm_handoff_prepare
      - Payload written to ~/.paradigm/sessions/{hash}/pending-handoffs/
      - New session calls paradigm_session_recover
      - Handoffs loaded and marked delivered
  wisdom-promotion:
    description: Promote project-local wisdom to global ~/.paradigm/wisdom/
    steps:
      - Agent calls paradigm_wisdom_promote
      - Local item validated and copied to global store
      - Cache invalidated for merged refresh
  aspect-materialization:
    description: Rebuild aspect-graph.db from .purpose files during reindex
    steps:
      - Open or create .paradigm/aspect-graph.db
      - Drop and recreate all tables (aspects, anchors, edges, lore_links, search_weights, heatmap)
      - Materialize aspects and anchors from SymbolEntry[]
      - Materialize lore links from .paradigm/lore/ files
      - Infer edges from shared lore references
      - Close database and write to disk
  install-flow:
    description: Install Paradigm CLI and MCP server from source
    steps:
      - Clone repository
      - npm install dependencies
      - npm run build all packages
      - npm install -g paradigm
      - npm install -g paradigm-mcp
      - Verify installation with paradigm doctor
