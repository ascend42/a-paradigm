version: 2.0.0
description: |
  Paradigm Framework - Unified developer tools ecosystem for structured AI-assisted development.
  Brings together Purpose (context), Portal (authorization), and Premise (aggregation) into
  a single, visual experience with the Sentinel dashboard.
context:
  - This is the Paradigm framework itself - use it to develop Paradigm ("dogfooding")
  - Monorepo using npm workspaces with shared TypeScript configuration
  - All packages publish to @a-company scope
  - The CLI (`paradigm`) is the main user interface
  - Sentinel is the unified codebase intelligence UI

features:
  cli-commands:
    description: Core CLI commands for managing Paradigm projects
    tags: [feature, core]
    components:
      - '#commander-setup'
      - '#ora-spinners'
      - '#chalk-output'
    flows:
      - $init-flow
      - $sync-flow
    signals:
      - '!command-success'
      - '!command-error'

  symbol-system:
    description: "The shared language between code, developers, and AI (v2: #, $, ^, !, ~ + tag bank)"
    tags: [feature, core]
    components:
      - '#symbol-parser'
      - '#symbol-index'

  ide-sync:
    description: Generate IDE instruction files from .paradigm/ config
    tags: [feature, sync]
    components:
      - '#cursor-adapter'
      - '#copilot-adapter'
      - '#windsurf-adapter'
      - '#claude-adapter'
    flows:
      - $sync-flow

  visual-discovery:
    description: Map screenshots to code via probe/scan
    tags: [feature, discovery]
    components:
      - '#probe-protocol'
      - '#scan-generator'
    flows:
      - $probe-flow

  agent-efficiency:
    description: Tools for token-efficient AI development
    tags: [feature, core]
    components:
      - '#beacon'
      - '#constellation'
      - '#ripple'
      - '#thread'
      - '#echo'
    signals:
      - '!context-loaded'
      - '!ripple-analyzed'

  mcp-server:
    description: Model Context Protocol server for AI assistants
    tags: [feature, integration, mcp]
    components:
      - '#mcp-resources'
      - '#mcp-tools'
      - '#index-loader'
    signals:
      - '!server-started'
      - '!resource-fetched'
      - '!tool-called'

  sentinel-dashboard:
    description: Unified codebase intelligence UI with symbol visualization
    tags: [feature, core]
    components:
      - '#sentinel-ui'
      - '#node-renderer'
      - '#connection-lines'
      - '#properties-panel'

  portal-authorization:
    description: Runtime authorization with visual testing
    tags: [feature, security]
    components:
      - '#portal-core'
      - '#portal-sdk'
      - '#portal-viewer'
      - '#portal-manager'
    gates:
      - ^authenticated
      - ^subscription-required
      - ^admin-only
    flows:
      - $authorization-flow

  team-orchestration:
    description: Multi-agent coordination with model selection, spawning, and orchestration
    tags: [feature, team]
    components:
      - '#agent-spawner'
      - '#orchestrator'
      - '#model-discovery'
      - '#provider-registry'
      - '#model-configurator'
    flows:
      - $orchestration-flow
    signals:
      - '!agent-spawned'
      - '!orchestration-completed'

components:
  commander-setup:
    description: CLI framework setup with Commander.js
    used-by: ["#cli-commands"]

  symbol-parser:
    description: Parses symbols from .purpose and portal.yaml files
    used-by: ["#symbol-system"]

  symbol-index:
    description: In-memory index of all project symbols
    used-by: ["#symbol-system", "#agent-efficiency"]

  cursor-adapter:
    description: Generates .cursor/rules/*.mdc files
    used-by: ["#ide-sync"]

  copilot-adapter:
    description: Generates .github/copilot-instructions.md files
    used-by: ["#ide-sync"]

  windsurf-adapter:
    description: Generates .windsurfrules file
    used-by: ["#ide-sync"]

  claude-adapter:
    description: Generates CLAUDE.md file
    used-by: ["#ide-sync"]

  beacon:
    description: Quick-start orientation for AI agents
    used-by: ["#agent-efficiency"]

  constellation:
    description: Machine-readable symbol graph in JSON/YAML
    used-by: ["#agent-efficiency"]

  ripple:
    description: Change impact analysis tool
    used-by: ["#agent-efficiency"]

  thread:
    description: Session continuity between AI agents
    used-by: ["#agent-efficiency"]

  echo:
    description: Error-to-symbol mapping
    used-by: ["#agent-efficiency"]

  mcp-resources:
    description: Read-only data exposed via MCP protocol
    used-by: ["#mcp-server"]

  mcp-tools:
    description: Actions AI can invoke via MCP protocol
    used-by: ["#mcp-server"]

  index-loader:
    description: Loads project symbol index for MCP server
    used-by: ["#mcp-server"]

  sentinel-ui:
    description: React app for unified codebase intelligence
    used-by: ["#sentinel-dashboard"]

  node-renderer:
    description: Renders symbol nodes on the canvas
    used-by: ["#sentinel-dashboard"]

  connection-lines:
    description: SVG lines connecting related symbols
    used-by: ["#sentinel-dashboard"]

  properties-panel:
    description: Side panel showing selected symbol details
    used-by: ["#sentinel-dashboard"]

  portal-core:
    description: Core parsing and validation for portal.yaml
    used-by: ["#portal-authorization"]

  portal-sdk:
    description: Runtime SDK for checking gates in applications
    used-by: ["#portal-authorization"]

  portal-viewer:
    description: Real-time visualization of authorization flows
    used-by: ["#portal-authorization"]

  portal-manager:
    description: Test generation and flow management
    used-by: ["#portal-authorization"]

  probe-protocol:
    description: Protocol for visual-to-code mapping
    used-by: ["#visual-discovery"]

  scan-generator:
    description: Generates scan-index.json for component mapping
    used-by: ["#visual-discovery"]

  agent-spawner:
    description: Spawns AI agents via provider abstraction
    used-by: ["#team-orchestration"]

  orchestrator:
    description: Coordinates multi-agent orchestration (solo/faceted modes)
    used-by: ["#team-orchestration"]

  model-discovery:
    description: Discovers available AI models from APIs, remote manifest, and presets
    used-by: ["#team-orchestration"]

  provider-registry:
    description: Manages provider cascade (claude → claude-code → cursor-cli → manual)
    used-by: ["#team-orchestration"]

  model-configurator:
    description: Interactive prompts for configuring agent model assignments
    used-by: ["#team-orchestration"]

flows:
  init-flow:
    description: "Initialize Paradigm in a new project"
    steps:
      - Detect existing IDE files
      - Create .paradigm/ directory
      - Generate config.yaml
      - Copy templates
      - Run initial sync

  sync-flow:
    description: "Sync .paradigm/ to IDE instruction files"
    steps:
      - Load .paradigm/config.yaml
      - Detect target IDE
      - Generate adapter-specific files
      - Write to appropriate locations

  probe-flow:
    description: "Visual discovery workflow"
    steps:
      - Receive screenshot
      - Match against scan-index.json
      - Return component mappings
      - Suggest code locations

  authorization-flow:
    description: "Runtime gate checking"
    steps:
      - Request reaches gate
      - Evaluate keys against context
      - Grant or deny access
      - Emit signal

  orchestration-flow:
    description: "Multi-agent task coordination"
    steps:
      - Classify task complexity
      - Select agent team and models
      - Spawn agents (parallel where possible)
      - Collect results and handoff
      - Log orchestration to audit

signals:
  command-success:
    description: "CLI command completed successfully"
    tags: [cli]

  command-error:
    description: "CLI command failed with error"
    tags: [cli]

  context-loaded:
    description: "Project context loaded into agent tools"
    tags: [agent]

  ripple-analyzed:
    description: "Impact analysis completed"
    tags: [agent]

  server-started:
    description: "MCP server started and listening"
    tags: [mcp]

  resource-fetched:
    description: "MCP resource was read by client"
    tags: [mcp]

  tool-called:
    description: "MCP tool was invoked by client"
    tags: [mcp]

  agent-spawned:
    description: "AI agent spawned successfully"
    tags: [team]

  orchestration-completed:
    description: "Multi-agent orchestration completed"
    tags: [team]

relationships:
  - '#cli-commands USES #commander-setup, #ora-spinners, #chalk-output'
  - '#symbol-system USES #symbol-parser, #symbol-index'
  - '#ide-sync USES #cursor-adapter, #copilot-adapter, #windsurf-adapter'
  - '#agent-efficiency USES #beacon, #constellation, #ripple, #thread, #echo'
  - '#mcp-server USES #mcp-resources, #mcp-tools, #index-loader'
  - '#sentinel-dashboard USES #sentinel-ui, #node-renderer, #connection-lines'
  - '#portal-authorization USES #portal-core, #portal-sdk, #portal-viewer'
  - '#team-orchestration USES #agent-spawner, #orchestrator, #model-discovery'
